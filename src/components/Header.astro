---
import { getArticlesIndex } from "../utils/getArticlesIndex";

// Fetch the centralized article index sorted by date automatically
const allArticles = await getArticlesIndex();

const navLinks = [
  { label: "Taxation", href: "/taxation/" },
  { label: "Insights", href: "/insights/" },
  { label: "Join Us", href: "/join/" },
];

const accountURL = "https://acomptic.com";
const currentPath = Astro.url.pathname;
---

<header class="site-header">
  <div class="header-inner">
    <a class="brand" href="/" aria-label="Acomptic Articles home">
      <img
        class="brand-logo"
        src="/logo.svg"
        loading="eager"
        decoding="async"
        alt=""
        aria-hidden="true"
      />
      <span class="brand-text">
        <span class="brand-wordmark">Acomptic</span>
        <span class="brand-tag">articles.</span>
      </span>
    </a>

    <nav class="main-nav" aria-label="Main navigation">
      {navLinks.map((link) => {
        const isActive =
          currentPath === link.href || currentPath.startsWith(link.href);

        return (
          <a class={`nav-link ${isActive ? "active" : ""}`} href={link.href}>
            {link.label}
          </a>
        );
      })}
    </nav>

    <div class="header-actions">
      <button id="search-trigger" class="search-button" type="button" aria-label="Search articles">
        <svg class="search-icon" viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="11" cy="11" r="8"></circle>
          <path d="m21 21-4.35-4.35"></path>
        </svg>
      </button>

      <a class="try-button" href={accountURL} target="_blank" rel="noopener noreferrer">
        <span>Try Acomptic</span>
        <svg class="outbound-icon" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M7 17L17 7M17 7H7M17 7V17" />
        </svg>
      </a>
    </div>
  </div>
</header>

<!-- Search Modal Dialog -->
<dialog id="search-modal" class="search-modal">
  <div class="modal-content">
    <div class="modal-header">
      <svg class="search-icon-modal" viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="11" cy="11" r="8"></circle>
        <path d="m21 21-4.35-4.35"></path>
      </svg>
      <input 
        type="search" 
        id="search-input" 
        placeholder="Search articles by title, category, or keyword..." 
        autocomplete="off"
      />
      <button type="button" id="close-modal" aria-label="Close search">×</button>
    </div>
    
    <div id="search-results" class="search-results">
      <p class="search-hint">Type a keyword to explore articles instantly...</p>
    </div>
  </div>
</dialog>

<!-- Pass build-time articles index to client script -->
<script define:vars={{ articlesCache: allArticles }}>
  const searchTrigger = document.getElementById('search-trigger');
  const searchModal = document.getElementById('search-modal');
  const closeModal = document.getElementById('close-modal');
  const searchInput = document.getElementById('search-input');
  const searchResults = document.getElementById('search-results');

  // Open modal
  searchTrigger?.addEventListener('click', () => {
    searchModal?.showModal();
    searchInput?.focus();
  });

  // Close modal via button
  closeModal?.addEventListener('click', () => {
    searchModal?.close();
  });

  // Close modal when clicking outside content backdrop
  searchModal?.addEventListener('click', (event) => {
    const rect = searchModal.getBoundingClientRect();
    if (
      event.clientX < rect.left ||
      event.clientX > rect.right ||
      event.clientY < rect.top ||
      event.clientY > rect.bottom
    ) {
      searchModal.close();
    }
  });

  // Live query handling using the centralized index cache (already sorted by date desc)
  searchInput?.addEventListener('input', (e) => {
    const query = e.target.value.toLowerCase().trim();
    
    if (!query) {
      if (searchResults) {
        searchResults.innerHTML = '<p class="search-hint">Type a keyword to explore articles instantly...</p>';
      }
      return;
    }

    const filtered = articlesCache.filter((article) => {
      const targetText = `${article.title} ${article.excerpt} ${article.category} ${article.authorHandle}`.toLowerCase();
      return targetText.includes(query);
    });

    if (!searchResults) return;

    if (filtered.length === 0) {
      searchResults.innerHTML = `<p class="search-hint">No articles found matching "${query}"</p>`;
      return;
    }

    searchResults.innerHTML = filtered.map(art => {
      const formattedDate = new Date(`${art.date}T00:00:00`).toLocaleDateString("en-IN", {
        day: "numeric",
        month: "short",
        year: "numeric"
      });

      return `
        <a class="result-card-item" href="${art.url}">
          <div class="result-card-top">
            <span class="result-category">${art.category.toUpperCase()}</span>
            <span class="result-meta-dot">•</span>
            <span class="result-date">${formattedDate}</span>
            <span class="result-meta-dot">•</span>
            <span class="result-readtime">${art.readTime} min read</span>
          </div>
          <div class="result-title">${art.title}</div>
          <div class="result-snippet">${art.excerpt}</div>
        </a>
      `;
    }).join('');
  });
</script>

<style>
  /* Full-width solid header */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    width: 100%;
    max-width: none;
    margin: 0;
    border: none;
    border-bottom: 1px solid rgb(20 20 20 / 10%);
    border-radius: 0;
    background: #ffffff;
    box-shadow: none;
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
  }

  /* Main layout */
  .header-inner {
    width: 100%;
    min-height: 70px;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 24px;
    padding: 10px 26px;
  }

  /* Brand styling with vertical logo centering */
  .brand {
    display: inline-flex;
    align-items: center;
    justify-self: start;
    gap: 11px;
    min-width: 0;
    color: var(--color-text);
    text-decoration: none;
  }

  .brand-logo {
    width: 50px;
    height: 50px;
    display: block;
    flex: 0 0 50px;
    border-radius: 10px;
    object-fit: contain;
    padding: 5px;
    box-sizing: border-box;
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    min-width: 0;
  }

  .brand-wordmark {
    font-family: var(--font-primary);
    font-size: 23px;
    font-weight: 600;
    letter-spacing: 0.015em;
    line-height: 1.1;
    white-space: nowrap;
    color: var(--color-text);
    -webkit-font-smoothing: antialiased;
  }

  .brand-tag {
    margin-top: 1px;
    color: var(--color-purple-muted, #625a7a);
    font-family: var(--font-primary);
    font-size: 16px;
    font-weight: 400;
    letter-spacing: 0.02em;
    line-height: 1.1;
    text-transform: none;
  }

  /* Desktop navigation */
  .main-nav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(16px, 2.2vw, 30px);
    min-width: 0;
  }

  .nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    padding-block: 8px;
    color: var(--color-text);
    font-family: var(--font-primary);
    font-size: 15px;
    font-weight: 400;
    line-height: 1.4;
    text-decoration: none;
    white-space: nowrap;
    transition: color 220ms ease;
  }

  .nav-link:hover,
  .nav-link:focus-visible {
    color: var(--color-primary, #7654d6);
  }

  .nav-link.active {
    color: var(--color-primary, #7654d6);
    font-weight: 500;
  }

  .nav-link:focus-visible,
  .brand:focus-visible,
  .search-button:focus-visible,
  .try-button:focus-visible {
    outline: 2px solid var(--color-primary, #7654d6);
    outline-offset: 4px;
    border-radius: 4px;
  }

  /* Header actions */
  .header-actions {
    display: flex;
    align-items: center;
    justify-self: end;
    gap: 8px;
  }

  /* Search button matching action styles */
  .search-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border: 1px solid rgb(20 20 20 / 12%);
    border-radius: 50%;
    background: #ffffff;
    color: var(--color-text);
    cursor: pointer;
    transition:
      background-color 220ms ease,
      border-color 220ms ease,
      box-shadow 220ms ease,
      color 220ms ease;
  }

  .search-button:hover {
    background: var(--color-primary, #7654d6);
    border-color: var(--color-primary, #7654d6);
    color: #ffffff;
    box-shadow: 0 4px 12px rgb(18 18 18 / 6%);
  }

  .search-icon {
    width: 17px;
    height: 17px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* Try button */
  .try-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    min-height: 40px;
    padding: 9px 24px;
    border: 1px solid rgb(20 20 20 / 12%);
    border-radius: 999px;
    background: #ffffff;
    color: var(--color-text);
    font-family: var(--font-primary);
    font-size: 15px;
    font-weight: 600;
    line-height: 1.2;
    text-decoration: none;
    white-space: nowrap;
    transition:
      background-color 220ms ease,
      border-color 220ms ease,
      box-shadow 220ms ease,
      color 220ms ease;
  }

  .try-button:hover {
    background: var(--color-primary, #7654d6);
    border-color: var(--color-primary, #7654d6);
    color: #ffffff;
    box-shadow: 0 4px 12px rgb(18 18 18 / 6%);
  }

  .outbound-icon {
    width: 15px;
    height: 15px;
    flex: 0 0 auto;
    overflow: visible;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
    transform: translateY(-0.5px);
    transition: transform 250ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .try-button:hover .outbound-icon,
  .try-button:focus-visible .outbound-icon {
    transform: translate(2px, -2px);
  }

  /* Search Modal Dialog Styles */
  .search-modal {
    padding: 0;
    border: 1px solid var(--color-purple-border, #e5dcff);
    border-radius: 18px;
    width: min(720px, 92vw);
    background: #ffffff;
    box-shadow: 0 24px 48px rgb(18 18 18 / 18%);
    overflow: hidden;
  }

  .search-modal::backdrop {
    background: rgba(18, 18, 18, 0.45);
    backdrop-filter: blur(4px);
  }

  .modal-content {
    display: flex;
    flex-direction: column;
    max-height: 82vh;
  }

  .modal-header {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 18px 24px;
    border-bottom: 1px solid rgb(20 20 20 / 10%);
  }

  .search-icon-modal {
    width: 22px;
    height: 22px;
    flex: 0 0 auto;
    fill: none;
    stroke: var(--color-text);
    stroke-width: 2;
  }

  #search-input {
    flex: 1;
    border: none;
    outline: none;
    font-family: var(--font-primary);
    font-size: 17px;
    color: var(--color-text);
    background: transparent;
  }

  #close-modal {
    background: none;
    border: none;
    font-size: 26px;
    cursor: pointer;
    color: var(--color-text);
    padding: 0 4px;
  }

  .search-results {
    padding: 20px 24px;
    overflow-y: auto;
    min-height: 220px;
    max-height: 55vh;
    display: flex;
    flex-direction: column;
    gap: 12px;
    background: var(--color-white, #fff);
  }

  .search-hint {
    color: #625a7a;
    font-size: 14px;
    text-align: center;
    margin-top: 60px;
  }

  /* Result Card Styling (Matching article row cards) */
  .result-card-item {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 16px 20px;
    border: 1px solid var(--color-border, #e9e7ef);
    border-radius: 12px;
    background: var(--color-white, #fff);
    color: inherit;
    text-decoration: none;
    transition: border-color 200ms ease, box-shadow 200ms ease, transform 180ms ease;
  }

  .result-card-item:hover {
    border-color: var(--color-purple-border, #d9ccff);
    box-shadow: 0 8px 24px rgba(36, 25, 72, 0.055);
  }

  .result-card-top {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.78rem;
    color: var(--color-purple-muted, #625d6b);
    font-weight: 500;
  }

  .result-category {
    color: var(--color-primary, #7654d6);
    font-weight: 700;
  }

  .result-meta-dot {
    opacity: 0.5;
  }

  .result-title {
    font-family: var(--font-primary);
    font-weight: 650;
    font-size: 1.1rem;
    line-height: 1.35;
    color: var(--color-text);
    transition: color 180ms ease;
  }

  .result-card-item:hover .result-title {
    color: var(--color-primary, #7654d6);
  }

  .result-snippet {
    font-size: 0.9rem;
    color: var(--color-purple-muted, #625d6b);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin: 0;
  }

  /* Responsive Adjustments */
  @media (max-width: 1000px) {
    .header-inner {
      gap: 18px;
      padding-inline: 20px;
    }
    .brand-wordmark { font-size: 21px; }
    .brand-tag { font-size: 15px; }
    .main-nav { gap: 16px; }
    .nav-link { font-size: 14px; }
  }

  @media (max-width: 760px) {
    .header-inner {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 12px 16px;
      padding: 12px 18px;
    }
    .header-actions {
      grid-column: 2;
      grid-row: 1;
    }
    .main-nav {
      grid-column: 1 / -1;
      grid-row: 2;
      justify-content: center;
      gap: clamp(20px, 5vw, 30px);
      overflow-x: auto;
      scrollbar-width: none;
    }
    .main-nav::-webkit-scrollbar { display: none; }
  }
</style>
