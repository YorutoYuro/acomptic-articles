---
import { getArticlesIndex } from "../utils/getArticlesIndex";

// Fetch the centralized article index sorted by date automatically
const allArticles = await getArticlesIndex();

const navLinks = [
  { label: "Taxation", href: "/taxation/" },
  { label: "Insights", href: "/insights/" },
  { label: "Join Us", href: "/join/" },
];

const accountURL = "https://acomptic.com";
const currentPath = Astro.url.pathname;
---

<header class="site-header">
  <div class="header-inner">
    <a class="brand" href="/" aria-label="Acomptic Articles home">
      <img
        class="brand-logo"
        src="/logo.svg"
        loading="eager"
        decoding="async"
        alt=""
        aria-hidden="true"
      />
      <span class="brand-text">
        <span class="brand-wordmark">Acomptic</span>
        <span class="brand-tag">articles.</span>
      </span>
    </a>

    <nav class="main-nav" aria-label="Main navigation">
      {navLinks.map((link) => {
        const isActive =
          currentPath === link.href || currentPath.startsWith(link.href);

        return (
          <a class={`nav-link ${isActive ? "active" : ""}`} href={link.href}>
            {link.label}
          </a>
        );
      })}
    </nav>

    <div class="header-actions">
      <!-- Search Button with Capsule Shape and Icon Lift Animation -->
      <button id="search-trigger" class="search-button-capsule" type="button" aria-label="Search articles">
        <svg class="search-icon" viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="11" cy="11" r="8"></circle>
          <path d="m21 21-4.35-4.35"></path>
        </svg>
        <span>Search</span>
      </button>

      <a class="try-button" href={accountURL} target="_blank" rel="noopener noreferrer">
        <span>Try Acomptic</span>
        <svg class="outbound-icon" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M7 17L17 7M17 7H7M17 7V17" />
        </svg>
      </a>
    </div>
  </div>
</header>

<!-- Enlarged Premium Search Modal Dialog -->
<dialog id="search-modal" class="search-modal">
  <div class="modal-content">
    <div class="modal-header">
      <svg class="search-icon-modal" viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="11" cy="11" r="8"></circle>
        <path d="m21 21-4.35-4.35"></path>
      </svg>
      <input 
        type="search" 
        id="search-input" 
        placeholder="Search articles by title, author, or keyword..." 
        autocomplete="off"
      />
      <button type="button" id="close-modal" aria-label="Close search">×</button>
    </div>
    
    <div id="search-results" class="search-results">
      <div class="search-empty-state">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="11" cy="11" r="8"></circle>
          <path d="m21 21-4.35-4.35"></path>
        </svg>
        <p>Type any keyword, author handle, or topic to explore articles instantly.</p>
      </div>
    </div>
  </div>
</dialog>

<!-- Advanced Tokenized & Fuzzy Search Engine Script -->
<script define:vars={{ articlesCache: allArticles }}>
  const searchTrigger = document.getElementById('search-trigger');
  const searchModal = document.getElementById('search-modal');
  const closeModal = document.getElementById('close-modal');
  const searchInput = document.getElementById('search-input');
  const searchResults = document.getElementById('search-results');

  searchTrigger?.addEventListener('click', () => {
    searchModal?.showModal();
    searchInput?.focus();
  });

  closeModal?.addEventListener('click', () => {
    searchModal?.close();
  });

  searchModal?.addEventListener('click', (event) => {
    const rect = searchModal.getBoundingClientRect();
    if (
      event.clientX < rect.left ||
      event.clientX > rect.right ||
      event.clientY < rect.top ||
      event.clientY > rect.bottom
    ) {
      searchModal.close();
    }
  });

  const sanitize = (str) => (str || "").toString().toLowerCase().replace(/[\s@_-]+/g, "");

  searchInput?.addEventListener('input', (e) => {
    const rawQuery = e.target.value.trim();
    const query = rawQuery.toLowerCase();
    const queryCompact = sanitize(rawQuery);
    
    if (!query) {
      if (searchResults) {
        searchResults.innerHTML = `
          <div class="search-empty-state">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="11" cy="11" r="8"></circle>
              <path d="m21 21-4.35-4.35"></path>
            </svg>
            <p>Type any keyword, author handle, or topic to explore articles instantly.</p>
          </div>
        `;
      }
      return;
    }

    const queryTokens = query.split(/\s+/).filter(Boolean);

    const scoredResults = articlesCache.map((article) => {
      let score = 0;
      const title = (article.title || "").toLowerCase();
      const excerpt = (article.excerpt || "").toLowerCase();
      const author = (article.authorHandle || "").toLowerCase();
      const category = (article.category || "").toLowerCase();

      const titleCompact = sanitize(title);
      const excerptCompact = sanitize(excerpt);
      const authorCompact = sanitize(author);

      if (author.includes(query) || authorCompact.includes(queryCompact)) {
        score += 50;
      }

      queryTokens.forEach(token => {
        const tokenCompact = sanitize(token);
        if (title.includes(token) || titleCompact.includes(tokenCompact)) score += 20;
        if (excerpt.includes(token) || excerptCompact.includes(tokenCompact)) score += 10;
        if (category.includes(token)) score += 15;
      });

      if (titleCompact.includes(queryCompact)) score += 30;

      return { article, score };
    });

    const filtered = scoredResults
      .filter(item => item.score > 0)
      .sort((a, b) => {
        if (b.score !== a.score) return b.score - a.score;
        return new Date(b.article.date).getTime() - new Date(a.article.date).getTime();
      })
      .map(item => item.article);

    if (!searchResults) return;

    if (filtered.length === 0) {
      searchResults.innerHTML = `
        <div class="search-empty-state">
          <p>No articles found matching "${rawQuery}". Try a different spelling or keyword.</p>
        </div>
      `;
      return;
    }

    searchResults.innerHTML = filtered.map(art => {
      const formattedDate = new Date(`${art.date}T00:00:00`).toLocaleDateString("en-IN", {
        day: "numeric",
        month: "short",
        year: "numeric"
      });

      const displayAuthor = art.authorHandle ? `@${art.authorHandle}` : "Acomptic";

      return `
        <a class="search-result-card" href="${art.url}">
          <div class="search-card-meta">
            <span class="search-card-category">${art.category.toUpperCase()}</span>
            <span class="meta-dot">•</span>
            <span class="search-card-author">By ${displayAuthor}</span>
            <span class="meta-dot">•</span>
            <span>${formattedDate}</span>
            <span class="meta-dot">•</span>
            <span>${art.readTime} min read</span>
          </div>
          <h4 class="search-card-title">${art.title}</h4>
          <p class="search-card-snippet">${art.excerpt}</p>
        </a>
      `;
    }).join('');
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    width: 100%;
    background: #ffffff;
    border-bottom: 1px solid rgb(20 20 20 / 10%);
  }

  .header-inner {
    width: 100%;
    min-height: 70px;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 24px;
    padding: 10px 26px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    justify-self: start;
    gap: 11px;
    color: var(--color-text);
    text-decoration: none;
  }

  .brand-logo {
    width: 50px;
    height: 50px;
    border-radius: 10px;
    object-fit: contain;
    padding: 5px;
  }

  .brand-text {
    display: flex;
    flex-direction: column;
  }

  .brand-wordmark {
    font-family: var(--font-primary);
    font-size: 23px;
    font-weight: 600;
    letter-spacing: 0.015em;
    line-height: 1.1;
    color: var(--color-text);
  }

  .brand-tag {
    margin-top: 1px;
    color: var(--color-purple-muted, #625a7a);
    font-size: 16px;
    font-weight: 400;
  }

  .main-nav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(16px, 2.2vw, 30px);
  }

  .nav-link {
    padding-block: 8px;
    color: var(--color-text);
    font-size: 15px;
    font-weight: 400;
    text-decoration: none;
    transition: color 220ms ease;
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--color-primary, #7654d6);
    font-weight: 500;
  }

  .header-actions {
    display: flex;
    align-items: center;
    justify-self: end;
    gap: 10px;
  }

  .search-button-capsule {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    min-height: 40px;
    padding: 9px 20px;
    border: 1px solid rgb(20 20 20 / 12%);
    border-radius: 999px;
    background: #ffffff;
    color: var(--color-text);
    font-family: var(--font-primary);
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 220ms ease, border-color 220ms ease, box-shadow 220ms ease, color 220ms ease;
  }

  .search-button-capsule:hover {
    background: var(--color-primary, #7654d6);
    border-color: var(--color-primary, #7654d6);
    color: #ffffff;
    box-shadow: 0 4px 12px rgb(18 18 18 / 6%);
  }

  .search-icon {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 250ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .search-button-capsule:hover .search-icon {
    transform: translateY(-2px);
  }

  .try-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    min-height: 40px;
    padding: 9px 24px;
    border: 1px solid rgb(20 20 20 / 12%);
    border-radius: 999px;
    background: #ffffff;
    color: var(--color-text);
    font-family: var(--font-primary);
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
    transition: background-color 220ms ease, border-color 220ms ease, box-shadow 220ms ease, color 220ms ease;
  }

  .try-button:hover {
    background: var(--color-primary, #7654d6);
    border-color: var(--color-primary, #7654d6);
    color: #ffffff;
    box-shadow: 0 4px 12px rgb(18 18 18 / 6%);
  }

  .outbound-icon {
    width: 15px;
    height: 15px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
    transform: translateY(-0.5px);
    transition: transform 250ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .try-button:hover .outbound-icon {
    transform: translate(2px, -2px);
  }

  /* Enlarged Modal Dimensions */
  .search-modal {
    padding: 0;
    border: 1px solid var(--color-purple-border, #e5dcff);
    border-radius: 20px;
    width: min(920px, 96vw);
    background: #ffffff;
    box-shadow: 0 30px 60px rgb(18 18 18 / 20%);
    overflow: hidden;
  }

  .search-modal::backdrop {
    background: rgba(18, 18, 18, 0.5);
    backdrop-filter: blur(6px);
  }

  .modal-content {
    display: flex;
    flex-direction: column;
    max-height: 88vh;
  }

  .modal-header {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 24px 30px;
    border-bottom: 1px solid rgb(20 20 20 / 10%);
  }

  .search-icon-modal {
    width: 22px;
    height: 22px;
    flex: 0 0 auto;
    fill: none;
    stroke: var(--color-text);
    stroke-width: 2;
  }

  #search-input {
    flex: 1;
    border: none;
    outline: none;
    font-family: var(--font-primary);
    font-size: 18px;
    color: var(--color-text);
    background: transparent;
  }

  #close-modal {
    background: none;
    border: none;
    font-size: 28px;
    cursor: pointer;
    color: var(--color-text);
    padding: 0 6px;
    transition: color 180ms ease;
  }

  #close-modal:hover {
    color: var(--color-primary, #7654d6);
  }

  .search-results {
    padding: 26px 30px;
    overflow-y: auto;
    min-height: 360px;
    max-height: 68vh;
    display: flex;
    flex-direction: column;
    gap: 16px;
    background: var(--color-white, #fff);
  }

  .search-empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 14px;
    margin-top: 80px;
    color: var(--color-purple-muted, #625d6b);
  }

  .search-empty-state svg {
    width: 44px;
    height: 44px;
    stroke: var(--color-purple-muted, #625d6b);
    fill: none;
    stroke-width: 1.5;
    opacity: 0.5;
  }

  .search-empty-state p {
    font-size: 1rem;
    max-width: 380px;
    margin: 0;
  }

  /* Clean Article Card Style for Search Results */
  .search-result-card {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 20px 24px;
    border: 1px solid var(--color-border, #e9e7ef);
    border-radius: 14px;
    background: var(--color-white, #fff);
    color: inherit;
    text-decoration: none;
    transition: border-color 200ms ease, box-shadow 200ms ease, transform 180ms ease;
  }

  .search-result-card:hover {
    border-color: var(--color-purple-border, #d9ccff);
    box-shadow: 0 6px 20px rgba(36, 25, 72, 0.05);
    transform: translateY(-1px);
  }

  .search-card-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    font-size: 0.8rem;
    color: var(--color-purple-muted, #625d6b);
    font-weight: 500;
  }

  .search-card-category {
    color: var(--color-primary, #7654d6);
    font-weight: 700;
    text-transform: uppercase;
    font-size: 0.74rem;
  }

  .search-card-author {
    color: var(--color-text);
    font-weight: 600;
  }

  .meta-dot {
    opacity: 0.4;
  }

  .search-card-title {
    margin: 0;
    font-family: var(--font-primary);
    font-size: 1.2rem;
    font-weight: 650;
    color: var(--color-text);
    line-height: 1.35;
    text-decoration: none;
    transition: color 180ms ease;
  }

  .search-result-card:hover .search-card-title {
    color: var(--color-primary, #7654d6);
  }

  .search-card-snippet {
    margin: 2px 0 0;
    color: var(--color-purple-muted, #625d6b);
    font-size: 0.92rem;
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (max-width: 760px) {
    .search-result-card {
      padding: 16px 18px;
    }
  }
</style>
