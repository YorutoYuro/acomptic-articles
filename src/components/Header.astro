---
const navLinks = [
  { label: "Features", href: "/features/" },
  { label: "Articles", href: "https://articles.acomptic.com/" },
  { label: "Experience", href: "/experience/" },
  { label: "About", href: "/about/" },
  { label: "Contact", href: "/contact/" },
];

const accountURL = "https://account.acomptic.com";

const normalizePath = (path: string) => {
  if (!path || path === "/") return "/";
  return path.endsWith("/") ? path : `${path}/`;
};

const currentPath = normalizePath(Astro.url.pathname);

const isActiveLink = (href: string) => {
  if (!href.startsWith("/")) return false;
  const target = normalizePath(href);
  return currentPath === target || currentPath.startsWith(target);
};
---

<header class="site-header">
  <div class="header-inner">
    <a class="brand" href="/" aria-label="Acomptic home">
      <img
        class="brand-logo"
        src="/logo.svg"
        width="32"
        height="32"
        loading="eager"
        decoding="async"
        alt=""
        aria-hidden="true"
      />
      <span class="brand-wordmark">Acomptic</span>
    </a>

    <nav class="main-nav" aria-label="Main navigation">
      {
        navLinks.map((link) => {
          const active = isActiveLink(link.href);
          return (
            <a
              class:list={["nav-link", active && "active"]}
              href={link.href}
              aria-current={active ? "page" : undefined}
            >
              {link.label}
            </a>
          );
        })
      }
    </nav>

    <div class="header-actions">
      <a
        class="btn-custom btn-login-style login-button"
        href={`${accountURL}/login/`}
      >
        Login
      </a>

      <a
        class="btn-custom btn-dark-hover download-button"
        href="/download/"
        aria-label="Download Acomptic software"
      >
        <svg class="btn-icon-download" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M5 17v3h14v-3"></path>
          <path d="M12 3v12m-5-5 5 5 5-5"></path>
        </svg>
        <span>Download</span>
      </a>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    width: 100%;
    background: var(--color-white);
    border-bottom: 1px solid var(--color-border-soft);
  }

  @supports (backdrop-filter: blur(1px)) {
    .site-header {
      background: rgb(255 255 255 / 86%);
      backdrop-filter: saturate(180%) blur(16px);
      -webkit-backdrop-filter: saturate(180%) blur(16px);
    }
  }

  /* Header content lines up with the page content below it */
  .header-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    gap: var(--space-4);
    width: min(calc(100% - var(--page-gutter) * 2), var(--container-width));
    min-height: 64px;
    margin-inline: auto;
    padding-block: var(--space-1);
  }

  /* Brand */

  .brand {
    display: inline-flex;
    align-items: center;
    justify-self: start;
    gap: 10px;
    min-width: 0;
    color: var(--color-text);
    text-decoration: none;
  }

  .brand-logo {
    display: block;
    width: 32px;
    height: 32px;
    flex: 0 0 32px;
    object-fit: contain;
  }

  .brand-wordmark {
    font-size: var(--fs-lead);
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.1;
    white-space: nowrap;
  }

  /* Navigation */

  .main-nav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
    min-width: 0;
  }

  .nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    color: var(--color-text);
    font-size: 15px;
    font-weight: 400;
    line-height: 1.4;
    text-decoration: none;
    white-space: nowrap;
    -webkit-tap-highlight-color: transparent;
    transition: color var(--transition-fast);
  }

  .nav-link::after {
    position: absolute;
    right: 0;
    bottom: 4px;
    left: 0;
    height: 2px;
    border-radius: 2px;
    background: var(--color-primary);
    content: "";
    transform: scaleX(0);
    transition: transform var(--transition-fast);
  }

  .nav-link:hover::after,
  .nav-link:focus-visible::after,
  .nav-link.active::after {
    transform: scaleX(1);
  }

  .nav-link.active {
    font-weight: 600;
  }

  /* Actions */

  .header-actions {
    display: flex;
    align-items: center;
    justify-self: end;
    gap: 10px;
  }

  .login-button,
  .download-button {
    flex-shrink: 0;
    min-height: 38px;
    padding: 8px 22px;
    font-size: 14px;
  }

  .brand:focus-visible,
  .nav-link:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 4px;
    border-radius: var(--radius-small);
  }

  /* Tablets and small laptops */

  @media (max-width: 1000px) {
    .header-inner {
      gap: var(--space-3);
    }

    .main-nav {
      gap: var(--space-3);
    }

    .login-button,
    .download-button {
      padding-inline: 16px;
    }
  }

  /* Phones: brand and Login on top, scrollable navigation underneath.
     Download is hidden because the software installs on Windows. */

  @media (max-width: 760px) {
    .header-inner {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 0 var(--space-2);
      min-height: 0;
      padding-block: 10px 2px;
    }

    .header-actions {
      grid-column: 2;
      grid-row: 1;
    }

    .download-button {
      display: none;
    }

    .main-nav {
      grid-column: 1 / -1;
      grid-row: 2;
      justify-content: safe center;
      gap: var(--space-3);
      margin-inline: calc(var(--page-gutter) * -1);
      padding-inline: var(--page-gutter);
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
    }

    .main-nav::-webkit-scrollbar {
      display: none;
    }

    .nav-link {
      min-height: 38px;
      font-size: 14px;
    }
  }

  @media (max-width: 380px) {
    .brand-wordmark {
      font-size: 1.125rem;
    }

    .brand-logo {
      width: 28px;
      height: 28px;
      flex-basis: 28px;
    }

    .main-nav {
      gap: var(--space-2);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-link,
    .nav-link::after {
      transition: none;
    }
  }
</style>
