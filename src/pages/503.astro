
---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Acomptic - Service Unavailable"
  description="Acomptic is temporarily unavailable. Please try again shortly or return to the home page."
  noindex={true}
>
  <div class="not-found-page">
    <div class="not-found">
      <section class="error-content">
        <p class="error-label">
          <span class="error-label-line"></span>
          ERROR 503
        </p>

        <h1>
          Service <span>unavailable.</span>
        </h1>

        <p class="error-description">
          Service temporarily unavailable. Please try again shortly or return to the Acomptic home.
        </p>

        <div class="error-actions">
          <button
            type="button"
            class="home-button retry-button btn-custom"
            onclick="window.location.reload()"
          >
            <svg
              class="home-icon retry-icon"
              xmlns="http://www.w3.org/2000/svg"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M20 7v5h-5"></path>
              <path d="M4.9 9a8 8 0 0 1 13.2-2L20 12"></path>
              <path d="M4 17v-5h5"></path>
              <path d="M19.1 15a8 8 0 0 1-13.2 2L4 12"></path>
            </svg>

            <span>Retry</span>
          </button>

          <a href="/" class="home-button btn-custom">
            <svg
              class="home-icon"
              xmlns="http://www.w3.org/2000/svg"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="m3 10 9-7 9 7"></path>
              <path d="M5 9v11h14V9"></path>
              <path d="M9 20v-7h6v7"></path>
            </svg>

            <span>Back to Home</span>
          </a>
        </div>
      </section>

      <div class="error-visual" aria-hidden="true">
        <div class="visual-glow"></div>

        <div class="orbit orbit-outer">
          <span class="orbit-marker marker-outer"></span>
        </div>

        <div class="orbit orbit-middle">
          <span class="orbit-marker marker-middle"></span>
        </div>

        <div class="orbit orbit-inner">
          <span class="orbit-marker marker-inner"></span>
        </div>

        <div class="orbit orbit-core"></div>

        <div class="error-number">
          <span class="number-five">5</span>
          <span class="number-zero">0</span>
          <span class="number-three">3</span>
        </div>

        <span class="particle particle-one"></span>
        <span class="particle particle-two"></span>
        <span class="particle particle-three"></span>
        <span class="particle particle-four"></span>
        <span class="particle particle-five"></span>

        <span class="star star-one">✳</span>
        <span class="star star-two">✦</span>
        <span class="star star-three">✧</span>
        <span class="star star-four">✳</span>
      </div>
    </div>
  </div>
</Layout>

<style>
  .not-found-page {
    --error-primary: var(--color-primary, #a799ff);
    --error-ink: var(--color-ink, #121212);
    --error-white: var(--color-white, #ffffff);
    --error-border: var(--color-border, #e7e5ee);
    --error-muted: var(--color-text-muted, #686674);

    width: 100%;
    height: 100%;
    min-height: 0;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    isolation: isolate;
    background: var(--error-white);
    color: var(--error-ink);
    box-sizing: border-box;
  }

  .not-found-page *,
  .not-found-page *::before,
  .not-found-page *::after {
    box-sizing: border-box;
  }

  :global(html),
  :global(body) {
    margin: 0;
    height: 100%;
    overflow: hidden;
  }

  /* Keep the footer visible while the page remains unscrollable */

  :global(body:has(.not-found-page)) {
    display: flex;
    flex-direction: column;
    height: 100vh;
    height: 100dvh;
    overflow: hidden;
  }

  :global(body:has(.not-found-page) #main-content) {
    flex: 1 1 auto;
    min-height: 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  :global(body:has(.not-found-page) footer) {
    flex: 0 0 auto;
    margin-top: auto;
  }

  .not-found {
    width: 100%;
    height: 100%;
    min-height: 0;
    max-width: 1440px;
    margin: 0 auto;
    padding: clamp(24px, 5vw, 76px);
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.9fr);
    align-items: center;
    gap: clamp(24px, 4vw, 64px);
    overflow: hidden;
  }

  /* Content */

  .error-content {
    position: relative;
    z-index: 2;
    max-width: 530px;
  }

  .error-label {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 24px;
    color: var(--error-primary);
    font-family: var(--font-primary, inherit);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.16em;
  }

  .error-label-line {
    width: 25px;
    height: 2px;
    border-radius: 2px;
    background: currentColor;
  }

  .error-content h1 {
    margin: 0;
    font-family: var(--font-primary, inherit);
    font-size: clamp(42px, 5.2vw, 72px);
    font-weight: 700;
    line-height: 1.06;
    letter-spacing: -0.065em;
  }

  .error-content h1 span {
    color: var(--error-primary);
  }

  .error-description {
    max-width: 420px;
    margin: 22px 0 0;
    color: var(--error-muted);
    font-size: clamp(14px, 1.15vw, 16px);
    line-height: 1.8;
  }

  /* Home and Retry buttons */

  .error-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
  }

  /* Visual styling comes from the global .btn-custom class. */
  .home-button {
    margin-top: 30px;
  }

  .home-icon {
    flex: 0 0 auto;
    transition: transform 260ms ease;
  }

  .home-button:hover .home-icon {
    transform: translateY(-2px) scale(1.08);
  }

  .retry-button {
    appearance: none;
  }

  /* Illustration */

  .error-visual {
    position: relative;
    width: 100%;
    max-width: 490px;
    aspect-ratio: 1;
    justify-self: center;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    isolation: isolate;
  }

  .visual-glow {
    position: absolute;
    z-index: -1;
    width: 54%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--error-primary);
    opacity: 0.13;
    filter: blur(42px);
  }

  /* Every ring rotates independently */

  .orbit {
    position: absolute;
    border: 1px solid rgb(167 153 255 / 42%);
    border-radius: 50%;
    will-change: transform;
  }

  .orbit-outer {
    width: 82%;
    height: 82%;
    border-style: dashed;
    border-color: rgb(167 153 255 / 36%);
    animation: ring-rotate 48s linear infinite;
  }

  .orbit-middle {
    width: 66%;
    height: 66%;
    border-color: rgb(167 153 255 / 48%);
    animation: ring-rotate-reverse 38s linear infinite;
  }

  .orbit-inner {
    width: 49%;
    height: 49%;
    border-style: dashed;
    border-color: rgb(167 153 255 / 38%);
    animation: ring-rotate 32s linear infinite;
  }

  .orbit-core {
    width: 34%;
    height: 34%;
    border-color: rgb(167 153 255 / 24%);
    animation: ring-rotate-reverse 54s linear infinite;
  }

  .orbit-marker {
    position: absolute;
    top: 50%;
    left: -4px;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--error-primary);
    box-shadow: 0 0 8px rgb(167 153 255 / 24%);
  }

  .marker-outer {
    width: 8px;
    height: 8px;
  }

  .marker-middle {
    left: auto;
    right: -3px;
    width: 6px;
    height: 6px;
  }

  .marker-inner {
    top: auto;
    bottom: 12%;
    left: 10%;
    width: 5px;
    height: 5px;
  }

  /* 503 typography */

  .error-number {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(1px, 0.7vw, 8px);
    font-family: var(--font-primary, inherit);
    font-size: clamp(90px, 13vw, 164px);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.1em;
    color: var(--error-ink);
    user-select: none;
    animation: number-float 8s ease-in-out infinite;
  }

  .number-five,
  .number-three {
    color: var(--error-ink);
  }

  .number-zero {
    color: var(--error-primary);
    text-shadow: 0 0 30px rgb(167 153 255 / 16%);
  }

  /* Floating dots and stars move in different directions */

  .particle {
    position: absolute;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--error-primary);
    opacity: 0.75;
  }

  .particle-one {
    top: 16%;
    left: 30%;
    animation: drift-one 9s ease-in-out infinite;
  }

  .particle-two {
    top: 32%;
    right: 10%;
    width: 5px;
    height: 5px;
    animation: drift-two 11s ease-in-out infinite;
  }

  .particle-three {
    bottom: 17%;
    left: 22%;
    width: 4px;
    height: 4px;
    animation: drift-three 10s ease-in-out infinite;
  }

  .particle-four {
    right: 24%;
    bottom: 13%;
    width: 5px;
    height: 5px;
    animation: drift-four 12s ease-in-out infinite;
  }

  .particle-five {
    top: 22%;
    right: 27%;
    width: 4px;
    height: 4px;
    animation: drift-two 13s ease-in-out infinite reverse;
  }

  .star {
    position: absolute;
    display: inline-block;
    color: var(--error-primary);
    font-size: 20px;
    line-height: 1;
    opacity: 0.8;
    transform-origin: center;
  }

  .star-one {
    top: 15%;
    right: 25%;
    animation: star-rotate 14s linear infinite;
  }

  .star-two {
    top: 29%;
    left: 12%;
    font-size: 17px;
    animation: star-counter-rotate 18s linear infinite;
  }

  .star-three {
    right: 14%;
    bottom: 26%;
    font-size: 24px;
    animation: star-rotate 20s linear infinite;
  }

  .star-four {
    bottom: 13%;
    left: 35%;
    font-size: 15px;
    animation: star-counter-rotate 16s linear infinite;
  }

  /* Lightweight animations */

  @keyframes ring-rotate {
    from {
      transform: rotate(0deg);
    }

    to {
      transform: rotate(360deg);
    }
  }

  @keyframes ring-rotate-reverse {
    from {
      transform: rotate(360deg);
    }

    to {
      transform: rotate(0deg);
    }
  }

  @keyframes number-float {
    0%,
    100% {
      transform: translateY(0);
    }

    50% {
      transform: translateY(-3px);
    }
  }

  @keyframes drift-one {
    0%,
    100% {
      transform: translate(0, 0);
    }

    50% {
      transform: translate(7px, -9px);
    }
  }

  @keyframes drift-two {
    0%,
    100% {
      transform: translate(0, 0);
    }

    50% {
      transform: translate(-8px, 6px);
    }
  }

  @keyframes drift-three {
    0%,
    100% {
      transform: translate(0, 0);
    }

    50% {
      transform: translate(5px, 8px);
    }
  }

  @keyframes drift-four {
    0%,
    100% {
      transform: translate(0, 0);
    }

    50% {
      transform: translate(-6px, -7px);
    }
  }

  @keyframes star-rotate {
    from {
      transform: rotate(0deg);
    }

    to {
      transform: rotate(180deg);
    }
  }

  @keyframes star-counter-rotate {
    from {
      transform: rotate(180deg);
    }

    to {
      transform: rotate(0deg);
    }
  }

  /* Responsive layout */

  @media (min-width: 1441px) {
    .not-found {
      padding: 76px;
    }
  }

  @media (max-width: 900px) {
    .not-found {
      gap: 18px;
      padding: 32px;
    }

    .error-content h1 {
      font-size: clamp(40px, 6vw, 58px);
    }

    .error-visual {
      max-width: 390px;
    }

    .error-number {
      font-size: clamp(90px, 15vw, 140px);
    }
  }

  @media (max-width: 640px) {
    .not-found {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 8px;
      padding: 24px;
    }

    /* Move the animation above the text on mobile */

    .error-visual {
      order: -1;
      flex: 0 1 330px;
      width: min(100%, 330px);
      max-width: 100%;
      max-height: 36dvh;
      min-height: 0;
      aspect-ratio: 1;
      justify-self: center;
      align-self: center;
    }

    .error-content {
      order: 0;
      flex: 0 0 auto;
      width: 100%;
      max-width: 100%;
      text-align: center;
    }

    .error-label {
      margin-bottom: 16px;
      font-size: 11px;
    }

    .error-content h1 {
      font-size: clamp(38px, 9vw, 54px);
    }

    .error-description {
      margin-top: 14px;
      margin-left: auto;
      margin-right: auto;
      font-size: 14px;
      line-height: 1.65;
    }

    .home-button {
      margin-top: 22px;
    }

    .error-actions {
      justify-content: center;
    }

    .error-number {
      font-size: clamp(90px, 26vw, 145px);
    }

    .visual-glow {
      filter: blur(30px);
    }
  }

  @media (max-width: 380px) {
    .not-found {
      padding: 18px;
      gap: 4px;
    }

    .error-content h1 {
      font-size: 36px;
    }

    .error-description {
      font-size: 13px;
    }

    .error-visual {
      flex-basis: 31dvh;
      max-height: 31dvh;
    }

    .error-actions {
      gap: 8px;
    }

  }

  @media (max-height: 650px) and (min-width: 641px) {
    .not-found {
      padding-top: 18px;
      padding-bottom: 18px;
    }

    .error-label {
      margin-bottom: 14px;
    }

    .error-content h1 {
      font-size: clamp(38px, 4.8vw, 56px);
    }

    .error-description {
      margin-top: 14px;
      line-height: 1.6;
    }

    .home-button {
      margin-top: 20px;
    }

    .error-visual {
      max-height: 78dvh;
    }
  }

  /* Accessibility */

  @media (prefers-reduced-motion: reduce) {
    .orbit,
    .error-number,
    .particle,
    .star {
      animation: none !important;
    }

    .home-button,
    .home-button::before,
    .home-icon {
      transition: none;
    }
  }
</style>
