---
import Layout from "../../layouts/Layout.astro";
import { getArticlesIndex } from "../../utils/getArticlesIndex";

export async function getStaticPaths() {
  // NOTE: getStaticPaths runs on its own, so the helpers live inside it.
  const categoryNames: Record<string, string> = {
    insights: "Insights",
    gst: "GST",
    "income-tax": "Income Tax",
  };

  const categoryDescriptions: Record<string, string> = {
    insights: "Ideas and practical guidance for running a clearer, more efficient business.",
    gst: "Straightforward guidance on GST returns, input tax credit and compliance.",
    "income-tax": "Understand tax basics, filing requirements and planning for your business.",
  };

  // "income-tax" -> "Income Tax", "tds" -> "TDS"
  const getCategoryName = (slug: string) => {
    if (categoryNames[slug]) return categoryNames[slug];
    if (slug.replace(/-/g, "").length <= 3) return slug.replace(/-/g, " ").toUpperCase();
    return slug
      .split("-")
      .filter(Boolean)
      .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
      .join(" ");
  };

  const allArticlesIndex = await getArticlesIndex();
  const categoriesMap = new Map<string, typeof allArticlesIndex>();

  for (const art of allArticlesIndex) {
    const rawCategory = art.category ? art.category.trim().toLowerCase() : "";
    if (!rawCategory) continue;

    if (!categoriesMap.has(rawCategory)) {
      categoriesMap.set(rawCategory, []);
    }
    categoriesMap.get(rawCategory)!.push(art);
  }

  // Every topic with its article count, used for the "other topics" links.
  const allCategories = Array.from(categoriesMap.entries()).map(([slug, items]) => ({
    slug,
    name: getCategoryName(slug),
    count: items.length,
  }));

  const paths = [];
  for (const [category, articles] of categoriesMap.entries()) {
    paths.push({
      params: {
        category,
      },
      props: {
        categoryName: getCategoryName(category),
        categoryDescription:
          categoryDescriptions[category] ||
          `Latest articles and guides for ${getCategoryName(category)}.`,
        categorySlug: category,
        articles,
        totalArticles: articles.length,
        allCategories,
      },
    });
  }

  return paths;
}

const PAGE_SIZE = 10;
const {
  categoryName,
  categoryDescription,
  categorySlug,
  articles,
  totalArticles,
  allCategories,
} = Astro.props;

const mainSiteURL = "https://acomptic.com";
const siteOrigin = (Astro.site ?? new URL("https://articles.acomptic.com")).origin;

// Canonical URL: always the clean category address, never ?q= or ?sort=
const pageUrl = new URL(Astro.url.pathname, siteOrigin);
pageUrl.search = "";
pageUrl.hash = "";

const otherCategories = allCategories.filter((cat) => cat.slug !== categorySlug);

const sortOptions = [
  { value: "relevance", label: "Best match" },
  { value: "newest", label: "Newest first" },
  { value: "oldest", label: "Oldest first" },
  { value: "shortest", label: "Shortest read" },
  { value: "longest", label: "Longest read" },
];

const formatDate = (date: string) =>
  new Date(`${date}T00:00:00`).toLocaleDateString("en-IN", {
    day: "numeric",
    month: "short",
    year: "numeric",
  });

// SEO text
const pageTitle = `${categoryName} Articles for Indian Businesses | Acomptic`;
const pageDescription = `${categoryDescription} Browse all ${totalArticles} ${categoryName} ${
  totalArticles === 1 ? "article" : "articles"
} from the Acomptic team.`;

const newestFirst = [...articles].sort(
  (a, b) => new Date(b.date).getTime() - new Date(a.date).getTime(),
);
const latestDate = newestFirst[0]?.date;

// Keep the structured data light: the latest 50 articles are enough.
const itemListSchema = newestFirst.slice(0, 50).map((art, index) => ({
  "@type": "ListItem",
  position: index + 1,
  url: new URL(art.url, siteOrigin).href,
  name: art.title,
}));

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "@id": `${pageUrl.href}#webpage`,
    url: pageUrl.href,
    name: `${categoryName} Articles`,
    description: pageDescription,
    inLanguage: "en-IN",
    isPartOf: { "@id": `${siteOrigin}/#website` },
    breadcrumb: { "@id": `${pageUrl.href}#breadcrumb` },
    publisher: { "@id": `${mainSiteURL}/#organization` },
    about: { "@type": "Thing", name: categoryName },
    ...(latestDate ? { dateModified: latestDate } : {}),
    mainEntity: {
      "@type": "ItemList",
      numberOfItems: totalArticles,
      itemListOrder: "https://schema.org/ItemListOrderDescending",
      itemListElement: itemListSchema,
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "@id": `${pageUrl.href}#breadcrumb`,
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${mainSiteURL}/` },
      { "@type": "ListItem", position: 2, name: "Articles", item: `${siteOrigin}/` },
      { "@type": "ListItem", position: 3, name: categoryName, item: pageUrl.href },
    ],
  },
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonicalURL={pageUrl.href}
  ogImage="/og-image.png"
  ogImageAlt={`${categoryName} articles from Acomptic`}
  schema={schema}
>
  <main class="category-page">
    <div class="articles-container">

      <!-- BREADCRUMB -->
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <ol>
          <li><a href="/">Articles</a></li>
          <li aria-current="page"><span>{categoryName}</span></li>
        </ol>
      </nav>

      <!-- CATEGORY HEADER -->
      <header class="category-header">
        <h1>{categoryName}{" "}<span>Articles</span></h1>
        <p class="category-desc">{categoryDescription}</p>
      </header>

      <section class="category-articles-section" aria-labelledby="category-articles-title">
        <div class="section-title">
          <h2 id="category-articles-title">
            Articles in {categoryName} <span>({totalArticles})</span>
          </h2>
        </div>

        {totalArticles > 0 && (
          <div class="category-search" role="search">
            <div class="search-field">
              <svg class="search-icon" viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="11" cy="11" r="7" />
                <path d="M20 20l-3.5-3.5" />
              </svg>
              <input
                id="category-search-input"
                type="search"
                placeholder={`Search ${categoryName} articles…`}
                autocomplete="off"
                spellcheck="false"
                aria-label={`Search articles in ${categoryName}`}
              />
              <kbd class="search-kbd" id="search-kbd" aria-hidden="true">/</kbd>
              <button type="button" id="search-clear" class="search-clear" aria-label="Clear search" hidden>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
              </button>
            </div>

            <div class="search-controls">
              <div class="sort-wrap">
                <span class="sort-label" id="sort-label">Sort</span>
                <div class="dropdown" id="sort-dropdown">
                  <button
                    type="button"
                    class="dropdown-trigger"
                    id="sort-trigger"
                    aria-haspopup="listbox"
                    aria-expanded="false"
                    aria-labelledby="sort-label sort-current"
                  >
                    <span id="sort-current">Newest first</span>
                    <svg class="chev" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6" /></svg>
                  </button>

                  <ul class="dropdown-menu" id="sort-menu" role="listbox" aria-labelledby="sort-label" hidden>
                    {sortOptions.map((opt) => (
                      <li
                        class="dropdown-option"
                        role="option"
                        tabindex="-1"
                        data-value={opt.value}
                        aria-selected={opt.value === "newest" ? "true" : "false"}
                      >
                        <span>{opt.label}</span>
                        <svg class="check" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            </div>

            <p class="search-hint">
              Tip: use "quotes" for an exact phrase and -word to exclude a word. Small typos are forgiven.
            </p>
          </div>
        )}

        <p id="results-status" class="results-status" aria-live="polite"></p>

        {articles.length > 0 ? (
          <div class="topic-articles-list" id="articles-list" data-page-size={PAGE_SIZE}>
            {articles.map((art, i) => (
              <a
                class="article-row"
                href={art.url}
                target="_self"
                hidden={i >= PAGE_SIZE}
                data-category={String(art.category || "").toLowerCase()}
                data-date={art.date}
                data-read={art.readTime}
              >
                <div class="row-date">
                  <time datetime={art.date}>{formatDate(art.date)}</time>
                  <span>{art.readTime} min read</span>
                  <span class="row-author">By {art.author || art.authorName || art.authorHandle || "Acomptic Team"}</span>
                </div>
                <div class="row-copy">
                  <h3>{art.title}</h3>
                  <p>{art.excerpt}</p>
                </div>
                <span class="row-action" aria-hidden="true">
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M5 12h14M12 5l7 7-7 7" />
                  </svg>
                </span>
              </a>
            ))}
          </div>
        ) : (
          <div class="empty-state">
            <p>No articles found in {categoryName}.</p>
          </div>
        )}

        <div class="empty-state no-results" id="no-results" hidden>
          <p>No articles match your search.</p>
          <button type="button" id="no-results-clear" class="pill-button">Clear search</button>
        </div>

        {totalArticles > PAGE_SIZE && (
          <div class="load-more-wrap" id="load-more-wrap">
            <button type="button" id="load-more" class="pill-button">Load more</button>
          </div>
        )}
      </section>

      <!-- OTHER TOPICS (internal links) -->
      {otherCategories.length > 0 && (
        <section class="more-topics" aria-labelledby="more-topics-title">
          <h2 class="more-topics-title" id="more-topics-title">Explore other topics</h2>
          <div class="topic-chips">
            {otherCategories.map((cat) => (
              <a class="pill-button" href={`/${cat.slug}/`}>
                <span>{cat.name}</span>
                <span class="chip-count">({cat.count})</span>
              </a>
            ))}
          </div>
        </section>
      )}

      <!-- ACOMPTIC CTA CARD -->
      <section class="category-cta" aria-labelledby="category-cta-title">
        <div class="cta-card">
          <div class="cta-copy">
            <p class="cta-title" id="category-cta-title">
              Accounting made <span>simple.</span>
            </p>
            <p class="cta-text">
              Try Acomptic, the offline GST accounting software built for
              small businesses in India.
            </p>
          </div>
          <a class="pill-button" href="https://acomptic.com/">
            <span>Try Acomptic</span>
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M5 12h14M12 5l7 7-7 7" />
            </svg>
          </a>
        </div>
      </section>

    </div>
  </main>
</Layout>

<script>
  const list = document.getElementById("articles-list");

  if (list) {
    const PAGE = Number(list.dataset.pageSize) || 10;

    const input = document.getElementById("category-search-input") as HTMLInputElement | null;
    const clearBtn = document.getElementById("search-clear") as HTMLButtonElement | null;
    const kbd = document.getElementById("search-kbd");
    const statusEl = document.getElementById("results-status");
    const noResults = document.getElementById("no-results");
    const noResultsClear = document.getElementById("no-results-clear");
    const loadMoreWrap = document.getElementById("load-more-wrap");
    const loadMoreBtn = document.getElementById("load-more") as HTMLButtonElement | null;

    // custom sort dropdown
    const dropdown = document.getElementById("sort-dropdown");
    const sortTrigger = document.getElementById("sort-trigger") as HTMLButtonElement | null;
    const sortMenu = document.getElementById("sort-menu") as HTMLElement | null;
    const sortCurrent = document.getElementById("sort-current");
    const sortOptionEls = sortMenu
      ? Array.from(sortMenu.querySelectorAll<HTMLElement>(".dropdown-option"))
      : [];

    // ---------- text helpers ----------
    const norm = (s: string) =>
      s
        .toLowerCase()
        .normalize("NFD")
        .replace(/[\u0300-\u036f]/g, "")
        .replace(/[^\p{L}\p{N}\s]/gu, " ")
        .replace(/\s+/g, " ")
        .trim();

    const escapeRe = (s: string) => s.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");

    function within(a: string, b: string, max: number) {
      if (Math.abs(a.length - b.length) > max) return false;
      let prev = Array.from({ length: b.length + 1 }, (_, i) => i);
      for (let i = 1; i <= a.length; i++) {
        const curr = [i];
        let rowMin = i;
        for (let j = 1; j <= b.length; j++) {
          const cost = a[i - 1] === b[j - 1] ? 0 : 1;
          const v = Math.min(prev[j] + 1, curr[j - 1] + 1, prev[j - 1] + cost);
          curr[j] = v;
          if (v < rowMin) rowMin = v;
        }
        if (rowMin > max) return false;
        prev = curr;
      }
      return prev[b.length] <= max;
    }

    // ---------- index built from rendered rows ----------
    const records = Array.from(list.querySelectorAll<HTMLElement>(".article-row")).map((el, i) => {
      const titleEl = el.querySelector("h3") as HTMLElement;
      const excerptEl = el.querySelector(".row-copy p") as HTMLElement;
      const title = titleEl?.textContent ?? "";
      const excerpt = excerptEl?.textContent ?? "";
      const category = el.dataset.category ?? "";
      const nTitle = norm(title);
      const nExcerpt = norm(excerpt);
      return {
        el,
        i,
        titleEl,
        excerptEl,
        title,
        excerpt,
        category,
        date: el.dataset.date ?? "",
        read: Number(el.dataset.read) || 0,
        nTitle,
        nExcerpt,
        nCat: norm(category),
        wTitle: nTitle.split(" ").filter(Boolean),
        wExcerpt: nExcerpt.split(" ").filter(Boolean),
      };
    });

    type Rec = (typeof records)[number];

    function parseQuery(raw: string) {
      const phrases: string[] = [];
      const excluded: string[] = [];
      const terms: string[] = [];

      const rest = raw.replace(/(-?)"([^"]+)"/g, (_m, neg: string, p: string) => {
        const n = norm(p);
        if (n) (neg ? excluded : phrases).push(n);
        return " ";
      });

      rest.split(/\s+/).forEach((tok) => {
        if (!tok) return;
        if (tok.startsWith("-") && tok.length > 1) {
          const n = norm(tok.slice(1));
          if (n) excluded.push(n);
        } else {
          norm(tok)
            .split(" ")
            .forEach((w) => w && terms.push(w));
        }
      });

      return { phrases, excluded, terms };
    }

    function scoreTerm(r: Rec, t: string) {
      let s = 0;
      if (r.wTitle.includes(t)) s += 12;
      else if (r.wTitle.some((w) => w.startsWith(t))) s += 9;
      else if (r.nTitle.includes(t)) s += 6;

      if (r.nCat.includes(t)) s += 5;

      if (r.wExcerpt.includes(t)) s += 4;
      else if (r.wExcerpt.some((w) => w.startsWith(t))) s += 3;
      else if (r.nExcerpt.includes(t)) s += 1.5;

      if (s === 0 && t.length >= 4) {
        const max = t.length >= 8 ? 2 : 1;
        if (r.wTitle.some((w) => within(w, t, max))) s += 4;
        else if (r.wExcerpt.some((w) => within(w, t, max))) s += 2;
      }
      return s;
    }

    function scoreRecord(r: Rec, q: ReturnType<typeof parseQuery>): number | null {
      for (const ex of q.excluded) {
        if (r.nTitle.includes(ex) || r.nExcerpt.includes(ex) || r.nCat.includes(ex)) return null;
      }

      let total = 0;
      for (const p of q.phrases) {
        if (r.nTitle.includes(p)) total += 15;
        else if (r.nExcerpt.includes(p)) total += 8;
        else if (r.nCat.includes(p)) total += 6;
        else return null;
      }

      for (const t of q.terms) {
        const s = scoreTerm(r, t);
        if (s === 0) return null;
        total += s;
      }

      return total;
    }

    function highlight(el: HTMLElement, text: string, re: RegExp | null) {
      el.textContent = "";
      if (!re) {
        el.textContent = text;
        return;
      }
      let last = 0;
      for (const m of text.matchAll(re)) {
        const idx = m.index ?? 0;
        if (idx > last) el.append(text.slice(last, idx));
        const mark = document.createElement("mark");
        mark.textContent = m[0];
        el.append(mark);
        last = idx + m[0].length;
      }
      if (last < text.length) el.append(text.slice(last));
    }

    let query = "";
    let sortValue = "newest";
    let userSorted = false;
    let shown = PAGE;
    let debounceTimer: number | undefined;

    const SORT_MODES = ["relevance", "newest", "oldest", "shortest", "longest"];

    const params = new URLSearchParams(location.search);
    query = params.get("q") ?? "";
    const urlSort = params.get("sort");
    if (urlSort && SORT_MODES.includes(urlSort)) {
      sortValue = urlSort;
      userSorted = true;
    }
    if (input) input.value = query;

    function syncUrl() {
      const p = new URLSearchParams();
      if (query.trim()) p.set("q", query.trim());
      if (userSorted) p.set("sort", sortValue);
      const qs = p.toString();
      history.replaceState(null, "", location.pathname + (qs ? `?${qs}` : ""));
    }

    function sortResults(items: { r: Rec; score: number }[], mode: string) {
      const byDateDesc = (a: Rec, b: Rec) => (a.date < b.date ? 1 : a.date > b.date ? -1 : a.i - b.i);
      items.sort((x, y) => {
        switch (mode) {
          case "relevance":
            return y.score - x.score || byDateDesc(x.r, y.r);
          case "oldest":
            return -byDateDesc(x.r, y.r);
          case "shortest":
            return x.r.read - y.r.read || byDateDesc(x.r, y.r);
          case "longest":
            return y.r.read - x.r.read || byDateDesc(x.r, y.r);
          default:
            return byDateDesc(x.r, y.r);
        }
      });
    }

    function updateSortUI(mode: string, hasQuery: boolean) {
      sortOptionEls.forEach((opt) => {
        const val = opt.dataset.value;
        const selected = val === mode;
        opt.setAttribute("aria-selected", String(selected));
        opt.classList.toggle("is-selected", selected);

        if (val === "relevance") {
          opt.setAttribute("aria-disabled", String(!hasQuery));
          opt.classList.toggle("is-disabled", !hasQuery);
        }
        if (selected && sortCurrent) {
          sortCurrent.textContent = opt.querySelector("span")?.textContent ?? "";
        }
      });
    }

    const enabledOptions = () => sortOptionEls.filter((o) => o.getAttribute("aria-disabled") !== "true");

    function openMenu() {
      if (!sortMenu || !sortTrigger) return;
      sortMenu.hidden = false;
      sortTrigger.setAttribute("aria-expanded", "true");
      dropdown?.classList.add("is-open");
      const target = sortOptionEls.find((o) => o.getAttribute("aria-selected") === "true") ?? enabledOptions()[0];
      target?.focus();
    }

    function closeMenu(returnFocus = false) {
      if (!sortMenu || !sortTrigger) return;
      sortMenu.hidden = true;
      sortTrigger.setAttribute("aria-expanded", "false");
      dropdown?.classList.remove("is-open");
      if (returnFocus) sortTrigger.focus();
    }

    function chooseOption(opt: HTMLElement) {
      if (opt.getAttribute("aria-disabled") === "true") return;
      sortValue = opt.dataset.value ?? "newest";
      userSorted = true;
      shown = PAGE;
      syncUrl();
      render();
      closeMenu(true);
    }

    sortTrigger?.addEventListener("click", () => {
      if (sortMenu?.hidden) openMenu();
      else closeMenu();
    });

    sortTrigger?.addEventListener("keydown", (e) => {
      if (e.key === "ArrowDown" || e.key === "ArrowUp") {
        e.preventDefault();
        openMenu();
      }
    });

    sortMenu?.addEventListener("click", (e) => {
      const opt = (e.target as HTMLElement).closest<HTMLElement>(".dropdown-option");
      if (opt) chooseOption(opt);
    });

    sortMenu?.addEventListener("keydown", (e) => {
      const opts = enabledOptions();
      const idx = opts.indexOf(document.activeElement as HTMLElement);

      if (e.key === "ArrowDown") {
        e.preventDefault();
        opts[(idx + 1) % opts.length]?.focus();
      } else if (e.key === "ArrowUp") {
        e.preventDefault();
        opts[(idx - 1 + opts.length) % opts.length]?.focus();
      } else if (e.key === "Escape") {
        e.preventDefault();
        closeMenu(true);
      } else if (e.key === "Enter" || e.key === " ") {
        e.preventDefault();
        const current = document.activeElement as HTMLElement;
        if (current?.classList.contains("dropdown-option")) chooseOption(current);
      }
    });

    document.addEventListener("click", (e) => {
      if (dropdown && !dropdown.contains(e.target as Node)) closeMenu();
    });

    function render() {
      const q = parseQuery(query);
      const hasQuery = q.phrases.length + q.terms.length + q.excluded.length > 0;

      let mode = userSorted ? sortValue : hasQuery ? "relevance" : "newest";
      if (mode === "relevance" && !hasQuery) mode = "newest";
      updateSortUI(mode, hasQuery);

      const matched: { r: Rec; score: number }[] = [];
      for (const r of records) {
        if (!hasQuery) {
          matched.push({ r, score: 0 });
          continue;
        }
        const s = scoreRecord(r, q);
        if (s !== null) matched.push({ r, score: s });
      }

      sortResults(matched, mode);

      const hlTerms = [...q.phrases, ...q.terms].filter(Boolean).sort((a, b) => b.length - a.length);
      const re = hlTerms.length ? new RegExp(`(${hlTerms.map(escapeRe).join("|")})`, "gi") : null;

      const matchedSet = new Set(matched.map((m) => m.r));
      const frag = document.createDocumentFragment();

      matched.forEach(({ r }, idx) => {
        highlight(r.titleEl, r.title, re);
        highlight(r.excerptEl, r.excerpt, re);
        r.el.hidden = idx >= shown;
        frag.appendChild(r.el);
      });

      records.forEach((r) => {
        if (!matchedSet.has(r)) {
          r.el.hidden = true;
          frag.appendChild(r.el);
        }
      });

      list.appendChild(frag);

      const total = matched.length;
      const visible = Math.min(shown, total);

      if (statusEl) {
        if (total === 0) {
          statusEl.textContent = "";
        } else if (hasQuery) {
          statusEl.textContent =
            `${total} ${total === 1 ? "article" : "articles"} found` +
            (total > visible ? ` · showing ${visible}` : "");
        } else {
          statusEl.textContent = `Showing ${visible} of ${total} articles`;
        }
      }

      list.hidden = total === 0;
      if (noResults) noResults.hidden = total !== 0;

      if (loadMoreWrap && loadMoreBtn) {
        const remaining = total - visible;
        loadMoreWrap.hidden = remaining <= 0;
        loadMoreBtn.textContent = `Load more (${remaining} remaining)`;
      }

      if (clearBtn) clearBtn.hidden = !query;
      if (kbd) kbd.hidden = !!query;
    }

    function resetAll() {
      query = "";
      userSorted = false;
      sortValue = "newest";
      shown = PAGE;
      if (input) input.value = "";
      syncUrl();
      render();
    }

    input?.addEventListener("input", () => {
      window.clearTimeout(debounceTimer);
      debounceTimer = window.setTimeout(() => {
        query = input.value;
        shown = PAGE;
        syncUrl();
        render();
      }, 100);
    });

    clearBtn?.addEventListener("click", () => {
      if (input) input.value = "";
      query = "";
      shown = PAGE;
      syncUrl();
      render();
      input?.focus();
    });

    noResultsClear?.addEventListener("click", resetAll);

    loadMoreBtn?.addEventListener("click", () => {
      shown += PAGE;
      render();
    });

    // Press "/" to jump to the search box
    document.addEventListener("keydown", (e) => {
      if (e.key !== "/" || e.ctrlKey || e.metaKey || e.altKey) return;
      const target = e.target as HTMLElement | null;
      if (target && (target.tagName === "INPUT" || target.tagName === "TEXTAREA" || target.isContentEditable)) return;
      e.preventDefault();
      input?.focus();
    });

    render();
  }
</script>

