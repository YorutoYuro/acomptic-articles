---
// src/pages/[category]/[...slug].astro
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const mainSiteURL = "https://acomptic.com";

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  
  return articles.map((article) => {
    const normalizedId = article.id.replace(/\\/g, '/');
    const parts = normalizedId.split('/');
    
    const category = parts.length > 1 ? parts[0] : 'general';
    const rawSlug = parts.length > 1 ? parts.slice(1).join('/') : parts[0];
    const slug = rawSlug.replace(/\.mdx?$/, '');

    return {
      params: { category, slug },
      props: { article },
    };
  });
}

const { article } = Astro.props;
const { Content } = await render(article);

const formatDate = (date: string) =>
  new Date(`${date}T00:00:00`).toLocaleDateString("en-IN", {
    day: "numeric",
    month: "short",
    year: "numeric",
  });

const readTime = article.data.readTime || 4;

// Custom Author metadata from Frontmatter
const authorName = article.data.author || "Acomptic Team";
const authorHandle = article.data.authorHandle || null; // e.g., "@johndoe"
const authorUrl = article.data.authorUrl || (authorHandle ? `https://x.com/${authorHandle.replace('@', '')}` : null);

// Structured data schema for SEO
const schema = [
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": article.data.title,
    "description": article.data.description || article.data.excerpt,
    "datePublished": article.data.date,
    "author": {
      "@type": "Person",
      "name": authorName,
      "url": authorUrl
    },
    "publisher": { "@id": `${mainSiteURL}/#organization` }
  }
];
---

<Layout
  title={`${article.data.title} - Acomptic Articles`}
  description={article.data.description || article.data.excerpt}
  schema={schema}
>
  <main class="article-page">
    <article class="articles-container">
      
      <!-- Article Header -->
      <header class="article-header">
        <h1 class="article-title">{article.data.title}</h1>
        {article.data.description && (
          <p class="article-excerpt">{article.data.description}</p>
        )}
        
        <div class="article-meta-bar">
          <div class="meta-author">
            <span class="author-label">By</span>
            <span class="author-name">{authorName}</span>
            {authorHandle && authorUrl && (
              <a href={authorUrl} target="_blank" rel="noopener noreferrer" class="author-handle-link">
                ({authorHandle})
              </a>
            )}
          </div>
          <span class="meta-divider" aria-hidden="true">·</span>
          <time datetime={article.data.date}>{formatDate(article.data.date)}</time>
          <span class="meta-divider" aria-hidden="true">·</span>
          <span>{readTime} min read</span>
        </div>
      </header>

      <!-- Main Article Body -->
      <div class="article-content-body">
        <Content />
      </div>

      <!-- Bottom Call To Action (Matching Index CTA) -->
      <footer class="article-footer-cta">
        <div class="cta-card">
          <div>
            <h2>Accounting made <span>simple.</span></h2>
            <p>
              Try Acomptic, the offline GST accounting software built for
              small businesses in India.
            </p>
          </div>
          <a class="articles-btn" href="https://acomptic.com/">
            Try Acomptic
          </a>
        </div>
      </footer>

    </article>
  </main>
</Layout>

<style>
  .article-page {
    background: var(--color-white, #fff);
    color: var(--color-ink, #121212);
    font-family: var(--font-primary);
    line-height: 1.618;
    padding: 58px 0 88px;
    overflow-wrap: anywhere;
  }

  .article-page *,
  .article-page *::before,
  .article-page *::after {
    box-sizing: border-box;
  }

  /* Matching container width & margins directly from index.astro */
  .articles-container {
    width: min(1120px, calc(100% - 48px));
    margin-inline: auto;
  }

  .article-header {
    margin-bottom: 48px;
    padding-bottom: 32px;
    border-bottom: 1px solid var(--color-border, #e9e7ef);
  }

  .article-title {
    margin: 0 0 20px;
    color: var(--color-ink, #121212);
    font-size: clamp(2.2rem, 4.4vw, 3.35rem);
    font-weight: 650;
    letter-spacing: -.052em;
    line-height: 1.12;
    text-wrap: balance;
  }

  .article-excerpt {
    max-width: 840px;
    margin: 0 0 24px;
    color: var(--color-purple-muted, #625d6b);
    font-size: clamp(1.05rem, 1.3vw, 1.15rem);
    line-height: 1.75;
  }

  .article-meta-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    color: var(--color-purple-muted, #625d6b);
    font-size: .88rem;
  }

  .meta-author {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-weight: 600;
    color: var(--color-ink, #121212);
  }

  .author-label {
    font-weight: 400;
    color: var(--color-purple-muted, #625d6b);
  }

  .author-handle-link {
    color: var(--color-primary, #7654d6);
    text-decoration: none;
    font-weight: 500;
    transition: text-decoration 180ms ease;
  }

  .author-handle-link:hover,
  .author-handle-link:focus-visible {
    text-decoration: underline;
  }

  /* Full-width content body typography */
  .article-content-body {
    font-size: 1.1rem;
    color: var(--color-ink, #121212);
    line-height: 1.8;
  }

  .article-content-body :global(h2) {
    font-size: clamp(1.6rem, 2.8vw, 2.1rem);
    font-weight: 650;
    letter-spacing: -.035em;
    margin-top: 2em;
    margin-bottom: 0.75em;
    color: var(--color-ink, #121212);
  }

  .article-content-body :global(h3) {
    font-size: clamp(1.3rem, 2.2vw, 1.55rem);
    font-weight: 650;
    letter-spacing: -.025em;
    margin-top: 1.6em;
    margin-bottom: 0.6em;
    color: var(--color-ink, #121212);
  }

  .article-content-body :global(p) {
    margin-top: 0;
    margin-bottom: 1.6em;
    color: var(--color-purple-muted, #625d6b);
  }

  .article-content-body :global(ul), 
  .article-content-body :global(ol) {
    margin-top: 0;
    margin-bottom: 1.6em;
    padding-left: 1.5em;
    color: var(--color-purple-muted, #625d6b);
  }

  .article-content-body :global(li) {
    margin-bottom: 0.5em;
  }

  .article-content-body :global(strong) {
    color: var(--color-ink, #121212);
    font-weight: 650;
  }

  .article-content-body :global(blockquote) {
    margin: 2em 0;
    padding: 1.2em 1.5em;
    border-left: 3px solid var(--color-primary, #7654d6);
    background: var(--color-surface-soft, #faf9fc);
    border-radius: 0 12px 12px 0;
  }

  /* Bottom CTA matching index page layout */
  .article-footer-cta {
    margin-top: 80px;
  }

  .cta-card {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 24px 40px;
    padding: clamp(28px, 4vw, 48px);
    border: 1px solid var(--color-purple-border, #e5dcff);
    border-radius: 18px;
    background: var(--color-surface-soft, #faf9fc);
    box-shadow: 0 4px 18px rgb(36 25 72 / 4%);
  }

  .cta-card h2 {
    margin: 0;
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    font-weight: 700;
    letter-spacing: -.045em;
    line-height: 1.15;
    color: var(--color-ink, #121212);
  }

  .cta-card h2 span {
    color: var(--color-primary, #7654d6);
  }

  .cta-card p {
    max-width: 520px;
    margin: 10px 0 0;
    color: var(--color-purple-muted, #625d6b);
  }

  .articles-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-height: 48px;
    padding: 12px 25px;
    border: 1px solid var(--color-primary, #7654d6);
    border-radius: 999px;
    background: var(--color-primary, #7654d6);
    color: var(--color-white, #fff);
    font: inherit;
    font-size: .96rem;
    font-weight: 650;
    text-decoration: none;
    white-space: nowrap;
    transition: background-color 180ms ease, border-color 180ms ease, box-shadow 180ms ease, transform 180ms ease;
  }

  .articles-btn:hover,
  .articles-btn:focus-visible {
    border-color: var(--color-primary-hover, #5f3fc0);
    background: var(--color-primary-hover, #5f3fc0);
    box-shadow: 0 5px 14px color-mix(in srgb, var(--color-primary, #7654d6) 22%, transparent);
    outline: none;
    transform: translateY(-1px);
  }

  @media (max-width: 700px) {
    .articles-container {
      width: calc(100% - 32px);
    }
    .article-page {
      padding: 38px 0 64px;
    }
  }
</style>
