---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const mainSiteURL = "https://acomptic.com";

const articlesSiteURL =
  Astro.site ?? new URL("https://articles.acomptic.com");

const categoryNames: Record<string, string> = {
  insights: "Insights",
  gst: "GST",
  "income-tax": "Income Tax",
  general: "General",
};

const getCategoryName = (key: string) =>
  categoryNames[key] ||
  key
    .split("-")
    .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
    .join(" ");

// Turn a content entry into the plain data the page needs.
const parseEntry = (entry: any) => {
  const normalizedId = entry.id.replace(/\\/g, '/');
  const parts = normalizedId.split('/');
  const category = parts.length > 1 ? parts[0] : 'general';
  const rawSlug = parts.length > 1 ? parts.slice(1).join('/') : parts[0];
  const slug = rawSlug.replace(/\.mdx?$/, '');

  return {
    title: entry.data.title as string,
    excerpt: (entry.data.description || entry.data.excerpt || "") as string,
    date: entry.data.date as string,
    readTime: (entry.data.readTime || 4) as number,
    author: (entry.data.author || "Acomptic Team") as string,
    category,
    url: `/${category}/${slug}`,
  };
};

export async function getStaticPaths() {
  const articles = await getCollection('articles');

  return articles.map((article) => {
    const normalizedId = article.id.replace(/\\/g, '/');
    const parts = normalizedId.split('/');

    const category = parts.length > 1 ? parts[0] : 'general';

    const rawSlug =
      parts.length > 1
        ? parts.slice(1).join('/')
        : parts[0];

    const slug = rawSlug.replace(/\.mdx?$/, '');

    return {
      params: {
        category,
        slug,
      },
      props: {
        article,
      },
    };
  });
}

const { article } = Astro.props;

const { Content, headings } = await render(article);

// Format publication dates for readers.
const formatDate = (date: string) =>
  new Date(`${date}T00:00:00`).toLocaleDateString("en-IN", {
    day: "numeric",
    month: "short",
    year: "numeric",
  });

// Words and reading time.
const wordCount = article.body
  ? article.body.trim().split(/\s+/).filter(Boolean).length
  : undefined;

const readTime =
  article.data.readTime ||
  (wordCount ? Math.max(1, Math.round(wordCount / 200)) : 4);

// Author information.
const authorName = article.data.author || "Acomptic Team";

const authorHandle = article.data.authorHandle || null;

const authorUrl =
  article.data.authorUrl ||
  (
    authorHandle
      ? `https://x.com/${authorHandle.replace('@', '')}`
      : null
  );

const isTeamAuthor = authorName === "Acomptic Team";

// Canonical article URL.
const articleUrl = new URL(
  Astro.url.pathname,
  articlesSiteURL
);

articleUrl.search = "";
articleUrl.hash = "";

// Category of this article.
const currentCategory = parseEntry(article).category;
const categoryName = getCategoryName(currentCategory);
const categoryUrl = new URL(`/${currentCategory}/`, articlesSiteURL).href;

// Article social image.
const articleImage = new URL(
  article.data.ogImage || "/og-image.png",
  articlesSiteURL
).href;

const pageDescription =
  article.data.description || article.data.excerpt || article.data.title;

// Table of contents (second-level headings only).
const tocItems = headings.filter((heading) => heading.depth === 2);
const showToc = tocItems.length >= 3;

// Related articles: same category first, then the newest from other categories.
const everyArticle = (await getCollection('articles'))
  .map(parseEntry)
  .filter((item) => item.url !== parseEntry(article).url)
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());

const relatedArticles = [
  ...everyArticle.filter((item) => item.category === currentCategory),
  ...everyArticle.filter((item) => item.category !== currentCategory),
].slice(0, 3);

// Optional keywords, if your articles define tags.
const tags = (article.data as Record<string, unknown>).tags;
const keywords = Array.isArray(tags) ? tags.join(", ") : undefined;

// Structured data.
const schema = [
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "@id": `${articleUrl.href}#article`,

    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": articleUrl.href
    },

    "url": articleUrl.href,

    "headline": article.data.title.slice(0, 110),

    "description": pageDescription,

    "image": [articleImage],

    "datePublished": article.data.date,

    "dateModified": article.data.updatedDate || article.data.date,

    "author": {
      "@type": isTeamAuthor ? "Organization" : "Person",
      "name": authorName,
      "url": authorUrl || mainSiteURL
    },

    "publisher": {
      "@type": "Organization",
      "@id": `${mainSiteURL}/#organization`,
      "name": "Acomptic",
      "url": mainSiteURL,
      "logo": {
        "@type": "ImageObject",
        "url": `${mainSiteURL}/logo.svg`
      }
    },

    "isPartOf": { "@id": `${articlesSiteURL.origin}/#website` },

    "articleSection": categoryName,

    ...(wordCount ? { "wordCount": wordCount } : {}),

    "timeRequired": `PT${readTime}M`,

    ...(keywords ? { "keywords": keywords } : {}),

    "isAccessibleForFree": true,

    "inLanguage": "en-IN"
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "@id": `${articleUrl.href}#breadcrumb`,
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": `${mainSiteURL}/` },
      { "@type": "ListItem", "position": 2, "name": "Articles", "item": `${articlesSiteURL.origin}/` },
      { "@type": "ListItem", "position": 3, "name": categoryName, "item": categoryUrl },
      { "@type": "ListItem", "position": 4, "name": article.data.title, "item": articleUrl.href }
    ]
  }
];
---

<Layout
  title={`${article.data.title} | Acomptic Articles`}
  description={pageDescription}
  canonicalURL={articleUrl.href}
  schema={schema}
  author={authorName}
  ogType="article"
  ogImage={article.data.ogImage || "/og-image.png"}
  ogImageAlt={
    article.data.ogImageAlt || article.data.title
  }
  publishedTime={article.data.date}
  modifiedTime={article.data.updatedDate}
>
  <div class="article-page">

    <article class="article-wrap">

      <!-- Breadcrumb -->
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <ol>
          <li><a href="/">Articles</a></li>
          <li><a href={`/${currentCategory}/`}>{categoryName}</a></li>
          <li aria-current="page"><span>{article.data.title}</span></li>
        </ol>
      </nav>

      <!-- Article Header -->
      <header class="article-header">
        <h1 class="article-title">
          {article.data.title}
        </h1>

        {article.data.description && (
          <p class="article-excerpt">
            {article.data.description}
          </p>
        )}

        <div class="article-meta-bar">
          <div class="meta-author">
            <span class="author-label">By</span>

            <span class="author-name">
              {authorName}
            </span>

            {authorHandle && authorUrl && (
              <a
                href={authorUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="author-handle-link"
              >
                ({authorHandle})
              </a>
            )}
          </div>

          <span class="meta-divider" aria-hidden="true">·</span>

          <time datetime={article.data.date}>
            {formatDate(article.data.date)}
          </time>

          {article.data.updatedDate && (
            <>
              <span class="meta-divider" aria-hidden="true">·</span>

              <span>
                Updated{" "}
                <time datetime={article.data.updatedDate}>
                  {formatDate(article.data.updatedDate)}
                </time>
              </span>
            </>
          )}

          <span class="meta-divider" aria-hidden="true">·</span>

          <span>{readTime} min read</span>
        </div>
      </header>

      <!-- Table of contents -->
      {showToc && (
        <nav class="article-toc" aria-labelledby="toc-title">
          <p class="toc-title" id="toc-title">In this article</p>
          <ul>
            {tocItems.map((item) => (
              <li>
                <a href={`#${item.slug}`}>{item.text}</a>
              </li>
            ))}
          </ul>
        </nav>
      )}

      <!-- Main Article Body -->
      <div class="article-content-body">
        <Content />
      </div>

    </article>

    <!-- Related articles -->
    {relatedArticles.length > 0 && (
      <section class="related-section" aria-labelledby="related-title">
        <div class="articles-container">
          <div class="section-intro">
            <h2 id="related-title">Keep reading</h2>
          </div>

          <div class="topic-articles-list">
            {relatedArticles.map((art) => (
              <a class="article-row" href={art.url}>
                <div class="row-date">
                  <time datetime={art.date}>{formatDate(art.date)}</time>
                  <span>{art.readTime} min read</span>
                  <span class="row-author">By {art.author}</span>
                </div>
                <div class="row-copy">
                  <h3>{art.title}</h3>
                  <p>{art.excerpt}</p>
                </div>
                <span class="row-action" aria-hidden="true">
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M5 12h14M12 5l7 7-7 7" />
                  </svg>
                </span>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- Bottom Call To Action -->
    <section class="article-footer-cta" aria-labelledby="article-cta-title">
      <div class="articles-container">
        <div class="cta-card">
          <div class="cta-copy">
            <p class="cta-title" id="article-cta-title">
              Accounting made <span>simple.</span>
            </p>

            <p class="cta-text">
              Try Acomptic, the offline GST accounting software built for
              small businesses in India.
            </p>
          </div>

          <a
            class="articles-btn"
            href="https://acomptic.com/"
          >
            <span>Try Acomptic</span>
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M5 12h14M12 5l7 7-7 7" />
            </svg>
          </a>
        </div>
      </div>
    </section>

  </div>
</Layout>

<!--
  External links open in a new tab.
  Internal Acomptic links stay in the same tab.
-->
<script>
  function configureArticleLinks() {
    const article = document.querySelector(".article-content-body");

    if (!article) return;

    article.querySelectorAll("a[href]").forEach((link) => {
      try {
        const url = new URL((link as HTMLAnchorElement).href, window.location.origin);

        // Leave non-web links unchanged.
        if (!["http:", "https:"].includes(url.protocol)) {
          return;
        }

        const hostname = url.hostname.toLowerCase();

        // Treat the main domain and its subdomains as internal.
        const isInternal =
          hostname === "acomptic.com" ||
          hostname.endsWith(".acomptic.com");

        if (isInternal) {
          link.removeAttribute("target");
        } else {
          link.setAttribute("target", "_blank");

          const existingRel = (
            link.getAttribute("rel") || ""
          ).split(/\s+/).filter(Boolean);

          const relValues = new Set([
            ...existingRel,
            "noopener",
            "noreferrer"
          ]);

          link.setAttribute(
            "rel",
            [...relValues].join(" ")
          );
        }
      } catch {
        // Leave unsupported URLs unchanged.
      }
    });
  }

  // Configure links on initial page load.
  configureArticleLinks();

  // Support Astro view transitions if enabled.
  document.addEventListener(
    "astro:page-load",
    configureArticleLinks
  );
</script>

<style>
  /* ======================================================
     THEME + GOLDEN-RATIO TYPOGRAPHY (same system as the
     main site and the articles home page)
     ====================================================== */

  .article-page {
    --a-primary: var(--color-primary, #7654d6);
    --a-primary-hover: var(--color-primary-hover, #5f3fc0);
    --a-purple-border: var(--color-lavender-soft, #dbd6ff);
    --a-muted: var(--color-purple-muted, #625a7a);
    --a-ink: var(--color-text, #121212);
    --a-body: #3d3950;
    --a-border: var(--color-border, #e9e7ef);
    --a-white: var(--color-white, #ffffff);
    --a-soft: var(--color-surface-soft, #faf9fc);

    --type-base: 16px;
    --type-xs: max(12px, calc(var(--type-base) / 1.272));
    --type-sm: var(--type-base);
    --type-md: calc(var(--type-base) * 1.272);
    --type-2xl: calc(var(--type-base) * 2.618);

    background: var(--a-white);
    color: var(--a-ink);
    font-family: var(--font-primary, inherit);
    font-size: var(--type-sm);
    line-height: 1.618;
    padding: clamp(32px, 5vw, 60px) 0 clamp(56px, 7vw, 88px);
    overflow-wrap: anywhere;
  }

  .article-page *,
  .article-page *::before,
  .article-page *::after {
    box-sizing: border-box;
  }

  .article-page svg {
    display: block;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .article-wrap {
    width: min(100% - 48px, 820px);
    margin-inline: auto;
  }

  .articles-container {
    width: min(100% - 48px, 1200px);
    margin-inline: auto;
  }

  /* ======================================================
     BREADCRUMB
     ====================================================== */

  .breadcrumb ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 8px;
    margin: 0 0 22px;
    padding: 0;
    list-style: none;
    color: var(--a-muted);
    font-size: .84rem;
  }

  .breadcrumb li {
    display: inline-flex;
    align-items: center;
    min-width: 0;
  }

  .breadcrumb li + li::before {
    content: "›";
    margin-right: 8px;
    opacity: .55;
  }

  .breadcrumb a {
    color: var(--a-muted);
    text-decoration: none;
    transition: color 180ms ease;
  }

  .breadcrumb a:hover,
  .breadcrumb a:focus-visible {
    color: var(--a-primary);
  }

  .breadcrumb li[aria-current="page"] span {
    display: block;
    max-width: min(420px, 62vw);
    overflow: hidden;
    color: var(--a-ink);
    font-weight: 600;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* ======================================================
     ARTICLE HEADER
     ====================================================== */

  .article-header { margin-bottom: 32px; }

  .article-title {
    margin: 0 0 18px;
    color: var(--a-ink);
    font-size: clamp(2rem, 4.4vw, 3.2rem);
    font-weight: 500;
    letter-spacing: -.045em;
    line-height: 1.12;
    text-wrap: balance;
  }

  .article-excerpt {
    margin: 0;
    color: var(--a-muted);
    font-size: clamp(1.02rem, 1.3vw, 1.14rem);
    line-height: 1.75;
  }

  .article-meta-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 10px;
    margin-top: 26px;
    padding-top: 20px;
    border-top: 1px solid var(--a-border);
    color: var(--a-muted);
    font-size: .86rem;
  }

  .meta-author {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    color: var(--a-ink);
    font-weight: 600;
  }

  .author-label {
    color: var(--a-muted);
    font-weight: 400;
  }

  .author-handle-link {
    color: var(--a-primary);
    font-weight: 500;
    text-decoration: none;
  }

  .author-handle-link:hover,
  .author-handle-link:focus-visible {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* ======================================================
     TABLE OF CONTENTS
     ====================================================== */

  .article-toc {
    margin: 0 0 38px;
    padding: 24px 28px;
    border: 2px solid var(--a-purple-border);
    border-radius: 17px;
    background: var(--a-soft);
  }

  .toc-title {
    margin: 0 0 12px;
    color: var(--a-ink);
    font-size: var(--type-md);
    font-weight: 500;
    letter-spacing: -.03em;
    line-height: 1.3;
  }

  .article-toc ul {
    display: grid;
    gap: 8px;
    margin: 0;
    padding-left: 1.2em;
  }

  .article-toc li::marker { color: var(--a-primary); }

  .article-toc a {
    color: var(--a-muted);
    font-size: .96rem;
    line-height: 1.5;
    text-decoration: none;
    transition: color 180ms ease;
  }

  .article-toc a:hover,
  .article-toc a:focus-visible { color: var(--a-primary); }

  /* ======================================================
     ARTICLE BODY TYPOGRAPHY
     ====================================================== */

  .article-content-body {
    color: var(--a-body);
    font-size: 1.0625rem;
    line-height: 1.85;
  }

  .article-content-body :global(h2) {
    margin: 2.1em 0 .7em;
    scroll-margin-top: 96px;
    color: var(--a-ink);
    font-size: clamp(1.6rem, 2.8vw, 2.05rem);
    font-weight: 500;
    letter-spacing: -.04em;
    line-height: 1.2;
  }

  .article-content-body :global(h3) {
    margin: 1.7em 0 .6em;
    scroll-margin-top: 96px;
    color: var(--a-ink);
    font-size: clamp(1.25rem, 2.2vw, 1.5rem);
    font-weight: 500;
    letter-spacing: -.03em;
    line-height: 1.3;
  }

  .article-content-body :global(h4) {
    margin: 1.5em 0 .5em;
    color: var(--a-ink);
    font-size: 1.1rem;
    font-weight: 600;
    letter-spacing: -.02em;
  }

  .article-content-body :global(p) {
    margin: 0 0 1.5em;
  }

  .article-content-body :global(a) {
    color: var(--a-primary);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    transition: color 180ms ease;
  }

  .article-content-body :global(a:hover) { color: var(--a-primary-hover); }

  .article-content-body :global(ul),
  .article-content-body :global(ol) {
    margin: 0 0 1.5em;
    padding-left: 1.5em;
  }

  .article-content-body :global(li) { margin-bottom: .5em; }

  .article-content-body :global(li::marker) { color: var(--a-primary); }

  .article-content-body :global(strong) {
    color: var(--a-ink);
    font-weight: 650;
  }

  .article-content-body :global(blockquote) {
    margin: 2em 0;
    padding: 1.2em 1.5em;
    border: 2px solid var(--a-purple-border);
    border-left: 4px solid var(--a-primary);
    border-radius: 0 17px 17px 0;
    background: var(--a-soft);
  }

  .article-content-body :global(blockquote p:last-child) { margin-bottom: 0; }

  .article-content-body :global(img) {
    display: block;
    max-width: 100%;
    height: auto;
    margin: 2em auto;
    border-radius: 17px;
  }

  .article-content-body :global(hr) {
    margin: 2.5em 0;
    border: 0;
    border-top: 1px solid var(--a-border);
  }

  .article-content-body :global(code) {
    padding: .15em .4em;
    border-radius: 6px;
    background: var(--a-soft);
    color: var(--a-ink);
    font-size: .92em;
  }

  .article-content-body :global(pre) {
    margin: 0 0 1.6em;
    padding: 18px 20px;
    overflow-x: auto;
    border: 1px solid var(--a-border);
    border-radius: 14px;
    background: var(--a-soft);
    font-size: .9rem;
    line-height: 1.7;
  }

  .article-content-body :global(pre code) {
    padding: 0;
    background: transparent;
  }

  .article-content-body :global(table) {
    display: block;
    width: 100%;
    margin: 0 0 1.6em;
    overflow-x: auto;
    border-collapse: collapse;
    font-size: .95rem;
  }

  .article-content-body :global(th),
  .article-content-body :global(td) {
    padding: 10px 14px;
    border: 1px solid var(--a-border);
    text-align: left;
  }

  .article-content-body :global(th) {
    background: var(--a-soft);
    color: var(--a-ink);
    font-weight: 600;
  }

  /* ======================================================
     RELATED ARTICLES (same cards as the articles home page)
     ====================================================== */

  .related-section { margin-top: clamp(56px, 7vw, 84px); }

  .section-intro {
    max-width: 700px;
    margin: 0 auto 26px;
    text-align: center;
  }

  .section-intro h2 {
    margin: 0;
    color: var(--a-ink);
    font-size: clamp(2rem, 4vw, var(--type-2xl));
    font-weight: 500;
    line-height: 1.12;
    letter-spacing: -.045em;
  }

  .topic-articles-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .article-row {
    display: grid;
    grid-template-columns: 168px minmax(0, 1fr) 42px;
    gap: clamp(18px, 2.5vw, 30px);
    align-items: center;
    min-height: 132px;
    padding: 22px 26px;
    border: 2px solid var(--a-border);
    border-radius: 17px;
    background: var(--a-white);
    color: inherit;
    text-decoration: none;
    transition: border-color 200ms ease, box-shadow 200ms ease;
  }

  .article-row:hover,
  .article-row:focus-visible {
    border-color: var(--a-purple-border);
    box-shadow: 0 8px 24px rgba(36, 25, 72, 0.055);
    outline: none;
  }

  .row-date {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 5px;
    color: var(--a-muted);
    font-size: .8rem;
    line-height: 1.5;
  }

  .row-author {
    margin-top: 3px;
    color: var(--a-ink);
    font-weight: 600;
  }

  .row-copy { min-width: 0; }

  .row-copy h3 {
    margin: 0;
    color: var(--a-ink);
    font-size: clamp(1.08rem, 1.65vw, 1.3rem);
    font-weight: 600;
    letter-spacing: -.028em;
    line-height: 1.35;
    transition: color 200ms ease;
  }

  .article-row:hover .row-copy h3 { color: var(--a-primary); }

  .row-copy p {
    max-width: 760px;
    margin: 7px 0 0;
    color: var(--a-muted);
    font-size: .9rem;
    line-height: 1.6;
  }

  .row-action {
    display: grid;
    width: 40px;
    height: 40px;
    place-items: center;
    border: 1px solid rgb(20 20 20 / 12%);
    border-radius: 50%;
    background: var(--a-white);
    color: var(--a-ink);
    transition: border-color 220ms ease, background-color 220ms ease, color 220ms ease;
  }

  .row-action svg {
    width: 17px;
    height: 17px;
    transition: transform 220ms ease;
  }

