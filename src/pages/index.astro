---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";

const siteURL = "https://articles.acomptic.com";
const mainSiteURL = "https://acomptic.com";

const categoryMeta: Record<string, { name: string; description: string }> = {
  insights: {
    name: "Insights",
    description: "Ideas and practical guidance for running a clearer, more efficient business.",
  },
  gst: {
    name: "GST",
    description: "Straightforward guidance on GST returns, input tax credit and compliance.",
  },
  "income-tax": {
    name: "Income Tax",
    description: "Understand tax basics, filing requirements and planning for your business.",
  },
};

// 1. FETCH ALL MARKDOWN ARTICLES FROM CONTENT COLLECTIONS
const rawArticles = await getCollection("articles");

// 2. PARSE FOLDER CATEGORIES & SLUGS DYNAMICALLY
const allArticles = rawArticles.map((article) => {
  const normalizedId = article.id.replace(/\\/g, "/");
  const parts = normalizedId.split("/");
  
  const category = parts.length > 1 ? parts[0] : "insights";
  const rawSlug = parts.length > 1 ? parts.slice(1).join("/") : parts[0];
  const slug = rawSlug.replace(/\.mdx?$/, "");

  return {
    title: article.data.title,
    excerpt: article.data.description || article.data.excerpt || "",
    date: article.data.date,
    readTime: article.data.readTime || 4,
    author: article.data.author || "Om Kumawat",
    category: category,
    url: `/${category}/${slug}`,
  };
});

// 3. SORT ALL ARTICLES BY DATE (NEWEST FIRST)
const sortedArticles = [...allArticles].sort(
  (a, b) => new Date(b.date).getTime() - new Date(a.date).getTime(),
);

// 4. HERO SECTION: LATEST 10 ARTICLES FROM 'INSIGHTS' ONLY
const insightArticles = sortedArticles
  .filter((article) => article.category === "insights")
  .slice(0, 10);

// 5. OTHER CATEGORIES: GROUP BY CATEGORY & LIMIT TO LATEST 3 EACH
const otherCategoryKeys = Array.from(
  new Set(sortedArticles.map((a) => a.category))
).filter((cat) => cat !== "insights");

const categorySections = otherCategoryKeys.map((catKey) => {
  const articlesInCat = sortedArticles
    .filter((a) => a.category === catKey)
    .slice(0, 3);

  const meta = categoryMeta[catKey] || {
    name: catKey.toUpperCase().replace("-", " "),
    description: `Latest articles and guides for ${catKey.replace("-", " ")}.`,
  };

  return {
    key: catKey,
    name: meta.name,
    description: meta.description,
    articles: articlesInCat,
  };
});

const formatDate = (date: string) =>
  new Date(`${date}T00:00:00`).toLocaleDateString("en-IN", {
    day: "numeric",
    month: "short",
    year: "numeric",
  });

const articleSchema = sortedArticles.map((article, index) => ({
  "@type": "ListItem",
  position: index + 1,
  url: `${siteURL}${article.url}`,
  name: article.title,
}));

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "@id": `${siteURL}/#webpage`,
    url: `${siteURL}/`,
    name: "Acomptic - articles",
    description:
      "Practical articles on GST, income tax and business insights for small businesses in India.",
    inLanguage: "en-IN",
    publisher: { "@id": `${mainSiteURL}/#organization` },
    mainEntity: {
      "@type": "ItemList",
      itemListElement: articleSchema,
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${mainSiteURL}/` },
      { "@type": "ListItem", position: 2, name: "Articles", item: `${siteURL}/` },
    ],
  },
];
---

<Layout
  title="Acomptic - articles"
  description="Practical articles on GST, income tax and running a small business in India, from the team behind Acomptic."
  schema={schema}
>
  <main class="articles-page">
    
    <!-- HERO / LATEST INSIGHTS CAROUSEL -->
    <section class="articles-hero" aria-label="Latest insights">
      <div class="articles-container">
        {insightArticles.length > 0 ? (
          <div class="insights-carousel" data-insights-carousel>
            <button class="carousel-arrow carousel-prev" type="button" aria-label="Previous insight" data-carousel-prev>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg>
            </button>
            
            <div class="carousel-viewport" data-carousel-viewport aria-live="polite">
              <div class="carousel-track" data-carousel-track>
                {insightArticles.map((article, index) => (
                  <div class="carousel-slide" data-carousel-slide>
                    <a class="latest-feature" href={article.url} aria-label={`Read ${article.title}`}>
                      <div class="feature-content">
                        <div class="feature-copy">
                          <div class="feature-meta-top">
                            <span class="feature-kicker">INSIGHTS</span>
                          </div>
                          <h2 id={index === 0 ? "articles-title" : undefined}>{article.title}</h2>
                          <p class="feature-excerpt">{article.excerpt}</p>
                          <div class="feature-bottom">
                            <div class="article-meta">
                              <time datetime={article.date}>{formatDate(article.date)}</time>
                              <span aria-hidden="true">·</span>
                              <span>{article.readTime} min read</span>
                              <span aria-hidden="true">·</span>
                              <span class="feature-author">By {article.author}</span>
                            </div>
                            <span class="text-link">
                              Read article
                              <span class="text-link-arrow" aria-hidden="true">
                                <svg viewBox="0 0 24 24">
                                  <path d="M5 12h14M12 5l7 7-7 7" />
                                </svg>
                              </span>
                            </span>
                          </div>
                        </div>
                      </div>
                    </a>
                  </div>
                ))}
              </div>
            </div>

            <button class="carousel-arrow carousel-next" type="button" aria-label="Next insight" data-carousel-next>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
            </button>
          </div>
        ) : (
          <div class="empty-feature">
            <h2>Insights are coming soon.</h2>
            <p>Our latest business articles will appear here.</p>
          </div>
        )}
      </div>
    </section>

    <!-- CATEGORY SECTIONS (GST, INCOME TAX, ETC.) -->
    <section class="latest-sections" aria-label="Latest articles by category">
      <div class="articles-container">
        <div class="section-intro">
          <h2>More to explore</h2>
        </div>

        {categorySections.map((sec) => (
          <section class="topic-section" aria-labelledby={`${sec.key}-title`}>
            <div class="topic-heading">
              <div>
                <h3 id={`${sec.key}-title`}>{sec.name}</h3>
                <p>{sec.description}</p>
              </div>
            </div>

            {sec.articles.length > 0 ? (
              <div class="topic-articles-list">
                {sec.articles.map((art) => (
                  <a class="article-row" href={art.url}>
                    <div class="row-date">
                      <span>{formatDate(art.date)}</span>
                      <span>{art.readTime} min read</span>
                      <span class="row-author">By {art.author}</span>
                    </div>
                    <div class="row-copy">
                      <h4>{art.title}</h4>
                      <p>{art.excerpt}</p>
                    </div>
                    <span class="row-action" aria-label="Read article">
                      <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M5 12h14M12 5l7 7-7 7" />
                      </svg>
                    </span>
                  </a>
                ))}
              </div>
            ) : (
              <p class="empty-topic">Articles for {sec.name} will appear here.</p>
            )}
          </section>
        ))}
      </div>
    </section>

    <!-- ACOMPTIC CTA CARD -->
    <section class="articles-cta" aria-labelledby="articles-cta-title">
      <div class="articles-container">
        <div class="cta-card">
          <div>
            <h2 id="articles-cta-title">Accounting made <span>simple.</span></h2>
            <p>
              Try Acomptic, the offline GST accounting software built for
              small businesses in India.
            </p>
          </div>
          <a class="articles-btn" href="https://acomptic.com/">
            Try Acomptic
          </a>
        </div>
      </div>
    </section>
  </main>
</Layout>

<script>
  document.querySelectorAll<HTMLElement>("[data-insights-carousel]").forEach((carousel) => {
    const track = carousel.querySelector<HTMLElement>("[data-carousel-track]");
    const originalSlides = Array.from(
      carousel.querySelectorAll<HTMLElement>("[data-carousel-slide]")
    );
    const previous = carousel.querySelector<HTMLButtonElement>("[data-carousel-prev]");
    const next = carousel.querySelector<HTMLButtonElement>("[data-carousel-next]");

    if (!track || originalSlides.length === 0) return;

    if (originalSlides.length === 1) {
      if (previous) previous.style.display = "none";
      if (next) next.style.display = "none";
      return;
    }

    const firstClone = originalSlides[0].cloneNode(true) as HTMLElement;
    const lastClone = originalSlides[originalSlides.length - 1].cloneNode(true) as HTMLElement;

    [firstClone, lastClone].forEach((clone) => {
      clone.removeAttribute("data-carousel-slide");
      clone.setAttribute("aria-hidden", "true");
      clone.querySelectorAll("[id]").forEach((el) => el.removeAttribute("id"));
      clone.querySelectorAll("a, button, input, select, textarea, [tabindex]").forEach((el) => {
        el.setAttribute("tabindex", "-1");
      });
    });

    track.append(firstClone);
    track.prepend(lastClone);

    let activeIndex = 1;
    let isMoving = false;
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    // Measure the full carousel container (not the inner viewport). This keeps
    // every slide exactly as wide as the lower article cards' shared container.
    const getCarouselWidth = () => carousel.getBoundingClientRect().width;

    const setSlideWidths = () => {
      const width = getCarouselWidth();
      if (!width) return;
      const allSlides = track.children;
      for (let i = 0; i < allSlides.length; i++) {
        (allSlides[i] as HTMLElement).style.width = `${width}px`;
        (allSlides[i] as HTMLElement).style.flex = `0 0 ${width}px`;
      }
    };

    const setPosition = (animate = true) => {
      setSlideWidths();
      track.style.transition = animate
        ? "transform 460ms cubic-bezier(.22, .75, .25, 1)"
        : "none";
      const viewportWidth = getCarouselWidth();
      track.style.transform = `translate3d(-${activeIndex * viewportWidth}px, 0, 0)`;

      originalSlides.forEach((slide, index) => {
        const isActive = index === activeIndex - 1;
        slide.setAttribute("aria-hidden", isActive ? "false" : "true");
        slide.querySelector("a")?.setAttribute("tabindex", isActive ? "0" : "-1");
      });
    };

    const move = (direction: -1 | 1) => {
      if (isMoving) return;
      activeIndex += direction;

      if (reduceMotion) {
        if (activeIndex === 0) activeIndex = originalSlides.length;
        if (activeIndex === originalSlides.length + 1) activeIndex = 1;
        setPosition(false);
        return;
      }

      isMoving = true;
      setPosition(true);
    };

    previous?.addEventListener("click", () => move(-1));
    next?.addEventListener("click", () => move(1));

    let resizeTimer: number;
    window.addEventListener("resize", () => {
      window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(() => setPosition(false), 100);
    });

    track.addEventListener("transitionend", (event) => {
      if (event.target !== track || event.propertyName !== "transform") return;

      if (activeIndex === 0) {
        activeIndex = originalSlides.length;
        setPosition(false);
      } else if (activeIndex === originalSlides.length + 1) {
        activeIndex = 1;
        setPosition(false);
      }

      isMoving = false;
    });

    setTimeout(() => setPosition(false), 50);
  });
</script>

<style>
  .articles-page {
    background: var(--color-white, #fff);
    color: var(--color-ink, #121212);
    font-family: var(--font-primary);
    line-height: 1.618;
    overflow-wrap: anywhere;
  }

  .articles-page *,
  .articles-page *::before,
  .articles-page *::after { box-sizing: border-box; }

  .articles-page svg {
    display: block;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .articles-container {
    width: min(1160px, calc(100% - 64px));
    max-width: 1160px;
    margin-inline: auto;
  }

  /* Keep the hero and lower article cards on precisely the same container edges. */
  .articles-hero > .articles-container,
  .latest-sections > .articles-container {
    width: min(1160px, calc(100% - 64px)) !important;
    max-width: 1160px !important;
    margin-inline: auto !important;
  }

  /* Hero: a contained, balanced feature card rather than a full-screen block */
  .articles-hero {
    padding: clamp(38px, 5vw, 64px) 0 clamp(42px, 5vw, 62px);
    background: var(--color-white, #fff);
    border-bottom: 1px solid var(--color-border, #e9e7ef);
  }

  .insights-carousel {
    display: grid;
    display: block;
    width: 100%;
    max-width: none;
    margin-inline: auto;
    position: relative;
    z-index: 2;
  }

  .carousel-viewport {
    display: block;
    flex: 0 0 100%;
    min-width: 0;
    width: 100% !important;
    max-width: 100% !important;
    overflow: hidden;
    position: relative;
    border-radius: 18px;
    background: var(--color-white, #fff);
    z-index: 1;
  }

  .carousel-track {
    display: flex;
    width: 100%;
    min-width: 100%;
    transform: translate3d(0, 0, 0);
    will-change: transform;
  }

  .carousel-slide {
    display: block;
    flex: 0 0 100%;
    min-width: 100%;
    width: 100%;
    max-width: none;
    box-sizing: border-box;
    padding: 0;
  }

  .carousel-arrow {
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    width: 48px !important;
    height: 48px !important;
    min-width: 48px !important;
    min-height: 48px !important;
    padding: 0 !important;
    border: 1px solid var(--color-purple-border, #e5dcff) !important;
    border-radius: 50% !important;
    background: var(--color-white, #fff) !important;
    color: var(--color-primary, #7654d6) !important;
    cursor: pointer !important;
    position: absolute !important;
    top: 50%;
    z-index: 10 !important;
    box-shadow: 0 5px 18px rgba(36, 25, 72, 0.08) !important;
    transition:
      background-color 240ms cubic-bezier(.2, .7, .2, 1),
      color 240ms cubic-bezier(.2, .7, .2, 1),
      border-color 240ms cubic-bezier(.2, .7, .2, 1),
      box-shadow 240ms cubic-bezier(.2, .7, .2, 1),
      transform 240ms cubic-bezier(.2, .7, .2, 1) !important;
    -webkit-tap-highlight-color: transparent;
  }

  .carousel-prev { left: -66px; transform: translateY(-50%); }
  .carousel-next { right: -66px; transform: translateY(-50%); }

  .carousel-arrow svg {
    width: 21px !important;
    height: 21px !important;
    stroke: var(--color-primary, #7654d6) !important;
    transition: transform 240ms cubic-bezier(.2, .7, .2, 1);
  }

  .carousel-arrow:hover {
    border-color: var(--color-primary, #7654d6) !important;
    background: var(--color-primary, #7654d6) !important;
    color: var(--color-white, #fff) !important;
    box-shadow: 0 8px 22px color-mix(in srgb, var(--color-primary, #7654d6) 22%, transparent) !important;
    transform: translateY(-50%) scale(1.06) !important;
  }

  .carousel-arrow:hover svg { stroke: var(--color-white, #fff) !important; }
  .carousel-prev:hover svg { transform: translateX(-2px); }
  .carousel-next:hover svg { transform: translateX(2px); }

  .latest-feature {
    position: relative;
    display: flex;
    flex: 0 0 100%;
    align-items: center;
    align-self: stretch;
    width: 100% !important;
    min-width: 100%;
    max-width: 100%;
    margin: 0;
    box-sizing: border-box;
    min-height: clamp(310px, 32vw, 390px);
    padding: clamp(34px, 5vw, 58px) clamp(30px, 5.5vw, 68px);
    overflow: hidden;
    border: 1px solid var(--color-border, #e9e7ef);
    border-radius: 18px;
    background: var(--color-white, #fff);
    color: inherit;
    text-decoration: none;
    box-shadow: 0 4px 18px rgba(36, 25, 72, 0.04);
    transition: border-color 220ms ease, box-shadow 220ms ease, transform 220ms ease;
  }

  .latest-feature:hover,
  .latest-feature:focus-visible {
    border-color: var(--color-purple-border, #d9ccff);
    box-shadow: 0 8px 24px rgba(36, 25, 72, 0.055);
    outline: none;
  }

  .feature-content,
  .feature-copy {
    display: block;
    width: 100%;
  }

  .feature-copy { max-width: 790px; }

  .feature-meta-top {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 9px;
    margin-bottom: 20px;
    font-size: .82rem;
  }

  .feature-kicker {
    color: var(--color-primary, #7654d6);
    font-weight: 750;
    letter-spacing: .13em;
  }

  .meta-dot { color: var(--color-purple-muted, #625d6b); }

  .feature-author {
    color: var(--color-ink, #121212);
    font-weight: 600;
  }

  .feature-copy h2 {
    max-width: 760px;
    margin: 0 0 16px;
    color: var(--color-ink, #121212);
    font-size: clamp(1.8rem, 3.1vw, 2.65rem);
    font-weight: 680;
    letter-spacing: -.045em;
    line-height: 1.2;
    text-wrap: balance;
  }

  .feature-excerpt {
    max-width: 720px;
    margin: 0;
    color: var(--color-purple-muted, #625d6b);
    font-size: clamp(.94rem, 1.3vw, 1.04rem);
    line-height: 1.75;
  }

  .feature-bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px 24px;
    margin-top: clamp(25px, 3vw, 34px);
    padding-top: 20px;
    border-top: 1px solid var(--color-border, #e9e7ef);
  }

  .article-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin: 0;
    color: var(--color-purple-muted, #625d6b);
    font-size: .84rem;
  }

  .text-link {
    display: inline-flex;
    margin-left: auto;
    align-items: center;
    gap: 10px;
    color: var(--color-primary, #7654d6);
    font-size: .92rem;
    font-weight: 680;
    white-space: nowrap;
  }

  .text-link-arrow {
    display: grid;
    width: 34px;
    height: 34px;
    place-items: center;
    border: 1px solid var(--color-purple-border, #e5dcff);
    border-radius: 50%;
    background: var(--color-white, #fff);
    transition: all 240ms cubic-bezier(.2, .7, .2, 1);
  }

  .text-link-arrow svg {
    width: 16px;
    height: 16px;
    stroke: var(--color-primary, #7654d6);
  }

  .latest-feature:hover .text-link-arrow {
    border-color: var(--color-primary, #7654d6);
    background: var(--color-primary, #7654d6);
    color: var(--color-white, #fff);
    transform: translateX(3px);
  }

  .latest-feature:hover .text-link-arrow svg { stroke: var(--color-white, #fff); }

  .empty-feature,
  .empty-topic {
    padding: 30px;
    border: 1px solid var(--color-border, #e9e7ef);
    border-radius: 16px;
    color: var(--color-purple-muted, #625d6b);
  }

  /* Lower article rows deliberately stay shorter than the hero feature */
  .latest-sections { padding: clamp(48px, 6vw, 76px) 0 84px; }

  .section-intro { margin-bottom: 26px; }

  .section-intro h2 {
    margin: 0;
    font-size: clamp(1.65rem, 2.6vw, 2.1rem);
    font-weight: 680;
    letter-spacing: -.04em;
    line-height: 1.2;
    color: var(--color-ink, #121212);
  }

  .topic-section {
    padding: 28px 0 32px;
    border-top: 1px solid var(--color-border, #e9e7ef);
  }

  .topic-heading { margin-bottom: 19px; }

  .topic-heading h3 {
    margin: 0;
    color: var(--color-ink, #121212);
    font-size: 1.4rem;
    font-weight: 680;
    letter-spacing: -.035em;
  }

  .topic-heading p:not(.topic-eyebrow) {
    max-width: 680px;
    margin: 5px 0 0;
    color: var(--color-purple-muted, #625d6b);
    font-size: .92rem;
    line-height: 1.6;
  }

  .topic-articles-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .article-row {
    display: grid;
    grid-template-columns: 168px minmax(0, 1fr) 42px;
    gap: clamp(18px, 2.5vw, 30px);
    align-items: center;
    min-height: 132px;
    padding: 22px 26px;
    border: 1px solid var(--color-border, #e9e7ef);
    border-radius: 15px;
    background: var(--color-white, #fff);
    color: inherit;
    text-decoration: none;
    transition: border-color 200ms ease, box-shadow 200ms ease, transform 200ms ease;
  }

  .article-row:hover,
  .article-row:focus-visible {
    border-color: var(--color-purple-border, #d9ccff);
    box-shadow: 0 8px 24px rgba(36, 25, 72, 0.055);
    transform: translateY(-1px);
    outline: none;
  }

  .row-date {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 5px;
    color: var(--color-purple-muted, #625d6b);
    font-size: .8rem;
    line-height: 1.5;
  }

  .row-author {
    margin-top: 3px;
    color: var(--color-ink, #121212);
    font-weight: 600;
  }

  .row-copy { min-width: 0; }

  .row-copy h4 {
    margin: 0;
    color: var(--color-ink, #121212);
    font-size: clamp(1.08rem, 1.65vw, 1.3rem);
    font-weight: 670;
    letter-spacing: -.028em;
    line-height: 1.35;
  }

  .article-row:hover .row-copy h4 { color: var(--color-primary, #7654d6); }

  .row-copy p {
    max-width: 760px;
    margin: 7px 0 0;
    color: var(--color-purple-muted, #625d6b);
    font-size: .9rem;
    line-height: 1.6;
  }

  .row-action {
    display: grid;
    width: 40px;
    height: 40px;
    place-items: center;
    border: 1px solid var(--color-border, #e9e7ef);
    border-radius: 50%;
    color: var(--color-primary, #7654d6);
    transition: border-color 220ms ease, background-color 220ms ease, transform 220ms ease;
  }

  .row-action svg {
    width: 17px;
    height: 17px;
    stroke: var(--color-primary, #7654d6);
  }

