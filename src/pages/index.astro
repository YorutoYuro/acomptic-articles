---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";

const siteURL = "https://articles.acomptic.com";
const mainSiteURL = "https://acomptic.com";

const categoryMeta: Record<string, { name: string; description: string }> = {
  insights: {
    name: "Insights",
    description: "Ideas and practical guidance for running a clearer, more efficient business.",
  },
  gst: {
    name: "GST",
    description: "Straightforward guidance on GST returns, input tax credit and compliance.",
  },
  "income-tax": {
    name: "Income Tax",
    description: "Understand tax basics, filing requirements and planning for your business.",
  },
};

// 1. FETCH ALL MARKDOWN ARTICLES FROM CONTENT COLLECTIONS
const rawArticles = await getCollection("articles");

// 2. PARSE FOLDER CATEGORIES & SLUGS DYNAMICALLY
const allArticles = rawArticles.map((article) => {
  const normalizedId = article.id.replace(/\\/g, "/");
  const parts = normalizedId.split("/");
  
  const category = parts.length > 1 ? parts[0] : "insights";
  const rawSlug = parts.length > 1 ? parts.slice(1).join("/") : parts[0];
  const slug = rawSlug.replace(/\.mdx?$/, "");

  return {
    title: article.data.title,
    excerpt: article.data.description || article.data.excerpt || "",
    date: article.data.date,
    readTime: article.data.readTime || 4,
    category: category,
    url: `/${category}/${slug}`,
  };
});

// 3. SORT ALL ARTICLES BY DATE (NEWEST FIRST)
const sortedArticles = [...allArticles].sort(
  (a, b) => new Date(b.date).getTime() - new Date(a.date).getTime(),
);

// 4. HERO SECTION: LATEST 10 ARTICLES FROM 'INSIGHTS' ONLY
const insightArticles = sortedArticles
  .filter((article) => article.category === "insights")
  .slice(0, 10);

// 5. OTHER CATEGORIES: GROUP BY CATEGORY & LIMIT TO LATEST 3 EACH
const otherCategoryKeys = Array.from(
  new Set(sortedArticles.map((a) => a.category))
).filter((cat) => cat !== "insights");

const categorySections = otherCategoryKeys.map((catKey) => {
  const articlesInCat = sortedArticles
    .filter((a) => a.category === catKey)
    .slice(0, 3);

  const meta = categoryMeta[catKey] || {
    name: catKey.toUpperCase().replace("-", " "),
    description: `Latest articles and guides for ${catKey.replace("-", " ")}.`,
  };

  return {
    key: catKey,
    name: meta.name,
    description: meta.description,
    articles: articlesInCat,
  };
});

const formatDate = (date: string) =>
  new Date(`${date}T00:00:00`).toLocaleDateString("en-IN", {
    day: "numeric",
    month: "short",
    year: "numeric",
  });

const articleSchema = sortedArticles.map((article, index) => ({
  "@type": "ListItem",
  position: index + 1,
  url: `${siteURL}${article.url}`,
  name: article.title,
}));

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "@id": `${siteURL}/#webpage`,
    url: `${siteURL}/`,
    name: "Acomptic Articles",
    description:
      "Practical articles on GST, income tax and business insights for small businesses in India.",
    inLanguage: "en-IN",
    publisher: { "@id": `${mainSiteURL}/#organization` },
    mainEntity: {
      "@type": "ItemList",
      itemListElement: articleSchema,
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${mainSiteURL}/` },
      { "@type": "ListItem", position: 2, name: "Articles", item: `${siteURL}/` },
    ],
  },
];
---

<Layout
  title="Articles & Business Guides - Acomptic"
  description="Practical articles on GST, income tax and running a small business in India, from the team behind Acomptic."
  schema={schema}
>
  <main class="articles-page">
    <!-- HERO / LATEST INSIGHTS CAROUSEL -->
    <section class="articles-hero" aria-label="Latest insights">
      <div class="articles-container">
        {insightArticles.length > 0 ? (
          <div class="insights-carousel" data-insights-carousel>
            <button class="carousel-arrow carousel-prev" type="button" aria-label="Previous insight" data-carousel-prev>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg>
            </button>
            <div class="carousel-viewport" data-carousel-viewport aria-live="polite">
              <div class="carousel-track" data-carousel-track>
                {insightArticles.map((article, index) => (
                  <div class="carousel-slide" data-carousel-slide>
                    <a class="latest-feature" href={article.url} aria-label={`Read ${article.title}`}>
                      <div class="feature-content">
                        <div class="feature-copy">
                          <p class="feature-kicker">INSIGHTS</p>
                          <h2 id={index === 0 ? "articles-title" : undefined}>{article.title}</h2>
                          <p class="feature-excerpt">{article.excerpt}</p>
                          <div class="feature-bottom">
                            <div class="article-meta">
                              <time datetime={article.date}>{formatDate(article.date)}</time>
                              <span aria-hidden="true">·</span>
                              <span>{article.readTime} min read</span>
                            </div>
                            <span class="text-link">
                              Read article
                              <span class="text-link-arrow" aria-hidden="true">
                                <svg viewBox="0 0 24 24">
                                  <path d="M5 12h14M12 5l7 7-7 7" />
                                </svg>
                              </span>
                            </span>
                          </div>
                        </div>
                      </div>
                    </a>
                  </div>
                ))}
              </div>
            </div>
            <button class="carousel-arrow carousel-next" type="button" aria-label="Next insight" data-carousel-next>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
            </button>
          </div>
        ) : (
          <div class="empty-feature">
            <h2>Insights are coming soon.</h2>
            <p>Our latest business articles will appear here.</p>
          </div>
        )}
      </div>
    </section>

    <!-- CATEGORY LATEST ARTICLES -->
    <section class="latest-sections" aria-label="Latest articles by category">
      <div class="articles-container">
        <div class="section-intro">
          <h2>More to explore</h2>
        </div>

        {categorySections.map((sec) => (
          <section class="topic-section" aria-labelledby={`${sec.key}-title`}>
            <div class="topic-heading">
              <div>
                <h3 id={`${sec.key}-title`}>{sec.name}</h3>
                <p>{sec.description}</p>
              </div>
            </div>

            {sec.articles.length > 0 ? (
              <div class="topic-articles-list">
                {sec.articles.map((art) => (
                  <a class="article-row" href={art.url}>
                    <div class="row-date">
                      <span>{formatDate(art.date)}</span>
                      <span>{art.readTime} min read</span>
                    </div>
                    <div class="row-copy">
                      <h4>{art.title}</h4>
                      <p>{art.excerpt}</p>
                    </div>
                    <span class="row-action" aria-label="Read article">
                      <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M5 12h14M12 5l7 7-7 7" />
                      </svg>
                    </span>
                  </a>
                ))}
              </div>
            ) : (
              <p class="empty-topic">Articles for {sec.name} will appear here.</p>
            )}
          </section>
        ))}
      </div>
    </section>

    <!-- ACOMPTIC CTA -->
    <section class="articles-cta" aria-labelledby="articles-cta-title">
      <div class="articles-container">
        <div class="cta-card">
          <div>
            <h2 id="articles-cta-title">Accounting made <span>simple.</span></h2>
            <p>
              Try Acomptic, the offline GST accounting software built for
              small businesses in India.
            </p>
          </div>
          <a class="articles-btn" href="https://acomptic.com/">
            Try Acomptic
          </a>
        </div>
      </div>
    </section>
  </main>
</Layout>

<script>
  document.querySelectorAll<HTMLElement>("[data-insights-carousel]").forEach((carousel) => {
    const track = carousel.querySelector<HTMLElement>("[data-carousel-track]");
    const originalSlides = Array.from(
      carousel.querySelectorAll<HTMLElement>("[data-carousel-slide]"),
    );
    const previous = carousel.querySelector<HTMLButtonElement>("[data-carousel-prev]");
    const next = carousel.querySelector<HTMLButtonElement>("[data-carousel-next]");

    if (!track || originalSlides.length === 0) return;

    if (originalSlides.length === 1) {
      previous?.style.setProperty("display", "none");
      next?.style.setProperty("display", "none");
      return;
    }

    const firstClone = originalSlides[0].cloneNode(true) as HTMLElement;
    const lastClone = originalSlides[originalSlides.length - 1].cloneNode(true) as HTMLElement;

    [firstClone, lastClone].forEach((clone) => {
      clone.removeAttribute("data-carousel-slide");
      clone.setAttribute("aria-hidden", "true");
      clone.querySelectorAll("[id]").forEach((element) => element.removeAttribute("id"));
      clone.querySelectorAll("a, button, input, select, textarea, [tabindex]").forEach((element) => {
        element.setAttribute("tabindex", "-1");
      });
    });

    track.append(firstClone);
    track.prepend(lastClone);

    let activeIndex = 1;
    let isMoving = false;
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    const setSlideWidths = () => {
      const viewport = carousel.querySelector<HTMLElement>(".carousel-viewport");
      if (!viewport) return;
      const width = viewport.clientWidth;
      track.querySelectorAll<HTMLElement>(".carousel-slide, .carousel-track > div:not([data-carousel-slide])").forEach((slide) => {
        (slide as HTMLElement).style.width = `${width}px`;
      });
    };

    const setPosition = (animate = true) => {
      setSlideWidths();
      track.style.transition = animate
        ? "transform 460ms cubic-bezier(.22, .75, .25, 1)"
        : "none";
      const viewportWidth = carousel.querySelector<HTMLElement>(".carousel-viewport")?.clientWidth ?? 0;
      track.style.transform = `translate3d(-${activeIndex * viewportWidth}px, 0, 0)`;

      originalSlides.forEach((slide, index) => {
        const isActive = index === activeIndex - 1;
        slide.setAttribute("aria-hidden", isActive ? "false" : "true");
        slide.querySelector("a")?.setAttribute("tabindex", isActive ? "0" : "-1");
      });
    };

    const move = (direction: -1 | 1) => {
      if (isMoving) return;
      activeIndex += direction;

      if (reduceMotion) {
        if (activeIndex === 0) activeIndex = originalSlides.length;
        if (activeIndex === originalSlides.length + 1) activeIndex = 1;
        setPosition(false);
        return;
      }

      isMoving = true;
      setPosition(true);
    };

    previous?.addEventListener("click", () => move(-1));
    next?.addEventListener("click", () => move(1));

    let resizeTimer: number;
    window.addEventListener("resize", () => {
      window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(() => setPosition(false), 100);
    });

    track.addEventListener("transitionend", (event) => {
      if (event.target !== track || event.propertyName !== "transform") return;

      if (activeIndex === 0) {
        activeIndex = originalSlides.length;
        setPosition(false);
      } else if (activeIndex === originalSlides.length + 1) {
        activeIndex = 1;
        setPosition(false);
      }

      isMoving = false;
    });

    setTimeout(() => setPosition(false), 50);
  });
</script>

<style>
  .articles-page {
    background: var(--color-white, #fff);
    color: var(--color-ink, #121212);
    font-family: var(--font-primary);
    line-height: 1.618;
    overflow-wrap: anywhere;
  }

  .articles-page *,
  .articles-page *::before,
  .articles-page *::after {
    box-sizing: border-box;
  }

  .articles-page svg {
    display: block;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .articles-container {
    width: min(1120px, calc(100% - 48px));
    margin-inline: auto;
  }

  /* Featured insight hero */
  .articles-hero {
    padding: 58px 0 48px;
    background: var(--color-white, #fff);
    border-bottom: 1px solid var(--color-border, #e9e7ef);
  }

  .insights-carousel {
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr) 44px;
    align-items: center;
    gap: 16px;
    width: 100%;
    position: relative;
    z-index: 2;
  }

  .carousel-viewport {
    min-width: 0;
    width: 100%;
    overflow: hidden;
    position: relative;
    border-radius: 18px;
    background: var(--color-white, #fff);
  }

  .carousel-track {
    display: flex;
    width: max-content;
    transform: translate3d(0, 0, 0);
    will-change: transform;
  }

  .carousel-slide {
    flex: 0 0 auto;
    min-width: 0;
    box-sizing: border-box;
    padding: 4px;
  }

  .carousel-arrow {
    display: grid;
    width: 44px;
    height: 44px;
    min-width: 44px;
    min-height: 44px;
    place-items: center;
    padding: 0;
    border: 1px solid var(--color-purple-border, #e5dcff);
    border-radius: 50%;
    background: var(--color-white, #fff);
    color: var(--color-primary, #7654d6);
    cursor: pointer;
    z-index: 5;
    box-shadow: 0 2px 8px rgba(36, 25, 72, 0.08);
    transition:
      background-color 240ms cubic-bezier(.2, .7, .2, 1),
      color 240ms cubic-bezier(.2, .7, .2, 1),
      border-color 240ms cubic-bezier(.2, .7, .2, 1),
      transform 240ms cubic-bezier(.2, .7, .2, 1);
    -webkit-tap-highlight-color: transparent;
  }

  .carousel-arrow svg {
    width: 20px;
    height: 20px;
    color: inherit;
  }

  .carousel-arrow:hover {
    border-color: var(--color-primary, #7654d6);
    background: var(--color-primary, #7654d6);
    color: var(--color-white, #fff);
    transform: scale(1.05);
  }

  .latest-feature {
    position: relative;
    display: block;
    overflow: hidden;
    width: 100%;
    padding: clamp(30px, 5vw, 58px);
    border: 1px solid var(--color-border, #e9e7ef);
    border-radius: 12px;
    background: var(--color-white, #fff);
    color: inherit;
    text-decoration: none;
    transition: border-color 180ms ease, box-shadow 180ms ease;
  }

  .latest-feature:hover,
  .latest-feature:focus-visible {
    border-color: var(--color-primary, #7654d6);
    box-shadow: 0 6px 22px rgb(36 25 72 / 6%);
    outline: none;
  }

  .feature-content,
  .feature-copy {
    display: block;
    width: 100%;
    max-width: none;
  }

  .feature-kicker {
    margin: 0 0 18px;
    color: var(--color-purple-muted, #625d6b);
    font-size: .76rem;
    font-weight: 700;
    letter-spacing: .12em;
  }

  .feature-copy h2 {
    max-width: 780px;
    margin: 0;
    color: var(--color-ink, #121212);
    font-size: clamp(2rem, 4.4vw, 3.35rem);
    font-weight: 650;
    letter-spacing: -.052em;
    line-height: 1.12;
    text-wrap: balance;
  }

  .feature-excerpt {
    max-width: 690px;
    margin: 20px 0 0;
    color: var(--color-purple-muted, #625d6b);
    font-size: clamp(1rem, 1.3vw, 1.08rem);
    line-height: 1.75;
  }

  .feature-bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 20px 28px;
    margin-top: 32px;
    padding-top: 22px;
    border-top: 1px solid var(--color-border, #e9e7ef);
  }

  .article-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 9px;
    margin: 0;
    color: var(--color-purple-muted, #625d6b);
    font-size: .84rem;
  }

  .text-link {
    display: inline-flex;
    margin-left: auto;
    align-items: center;
    gap: 12px;
    color: var(--color-primary, #7654d6);
    font-size: .93rem;
    font-weight: 650;
  }

  .text-link-arrow {
    display: grid;
    width: 30px;
    height: 30px;
    place-items: center;
    border: 1px solid var(--color-purple-border, #e5dcff);
    border-radius: 50%;
    background: var(--color-white, #fff);
    transition: background-color 240ms ease, border-color 240ms ease, color 240ms ease;
  }

  .text-link-arrow svg {
    width: 15px;
    height: 15px;
  }

  .latest-feature:hover .text-link-arrow {
    border-color: var(--color-primary, #7654d6);
    background: var(--color-primary, #7654d6);
    color: var(--color-white, #fff);
  }

  /* Latest by category sections */
  .latest-sections {
    padding: 64px 0 80px;
  }

  .section-intro {
    margin-bottom: 20px;
  }

  .section-intro h2 {
    margin: 0;
    font-size: clamp(1.6rem, 2.5vw, 2rem);
    font-weight: 650;
    letter-spacing: -.035em;
    line-height: 1.2;
  }

  .topic-section {
    padding: 26px 0 30px;
    border-top: 1px solid var(--color-border, #e9e7ef);
  }

  .topic-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 16px;
  }

  .topic-heading h3 {
    margin: 0;
    color: var(--color-ink, #121212);
    font-size: 1.45rem;
    font-weight: 650;
    letter-spacing: -.03em;
  }

  .topic-heading p:not(.topic-eyebrow) {
    margin: 5px 0 0;
    color: var(--color-purple-muted, #625d6b);
    font-size: .92rem;
  }

  .topic-articles-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .article-row {
    display: grid;
    grid-template-columns: 135px minmax(0, 1fr) 40px;
    gap: 26px;
    align-items: center;
    padding: 24px 22px;
    border: 1px solid var(--color-border, #e9e7ef);
    border-radius: 12px;
    background: var(--color-white, #fff);
    color: inherit;
    text-decoration: none;
    transition: border-color 180ms ease, box-shadow 180ms ease;
  }

  .article-row:hover,
  .article-row:focus-visible {
    border-color: var(--color-primary, #7654d6);
    box-shadow: 0 6px 22px rgb(36 25 72 / 6%);
    outline: none;
  }

  .row-date {
    display: flex;
    flex-direction: column;
    gap: 5px;
    color: var(--color-purple-muted, #625d6b);
    font-size: .82rem;
  }

  .row-copy h4 {
    margin: 0;
    color: var(--color-ink, #121212);
    font-size: clamp(1.1rem, 2vw, 1.35rem);
    font-weight: 650;
    letter-spacing: -.025em;
    line-height: 1.4;
  }

  .article-row:hover .row-copy h4 {
    color: var(--color-primary, #7654d6);
  }

  .row-copy p {
    max-width: 720px;
    margin: 8px 0 0;
    color: var(--color-purple-muted, #625d6b);
    font-size: .92rem;
    line-height: 1.65;
  }

  .row-action {
    display: grid;
    width: 38px;
    height: 38px;
    place-items: center;
    border: 1px solid var(--color-border, #e9e7ef);
    border-radius: 50%;
    color: var(--color-primary, #7654d6);
  }

  .row-action svg {
    width: 17px;
    height: 17px;
  }

  .article-row:hover .row-action {
    border-color: var(--color-primary, #7654d6);
    background: var(--color-primary, #7654d6);
    color: var(--color-white, #fff);
  }

  /* Bottom CTA */
  .articles-cta {
    padding: 0 0 88px;
  }

  .cta-card {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 24px 40px;
    padding: clamp(28px, 4vw, 48px);
    border: 1px solid var(--color-purple-border, #e5dcff);
    border-radius: 18px;
    background: var(--color-surface-soft, #faf9fc);
    box-shadow: 0 4px 18px rgb(36 25 72 / 4%);
  }

  .cta-card h2 {
    margin: 0;
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    font-weight: 700;
    letter-spacing: -.045em;
    line-height: 1.15;
  }

  .cta-card h2 span {
    color: var(--color-primary, #7654d6);
  }

  .cta-card p {
    max-width: 520px;
    margin: 10px 0 0;
    color: var(--color-purple-muted, #625d6b);
  }

  .articles-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 12px 25px;
    border: 1px solid var(--color-primary, #7654d6);
    border-radius: 999px;
    background: var(--color-primary, #7654d6);
    color: var(--color-white, #fff);
    font-size: .96rem;
    font-weight: 650;
    text-decoration: none;
    white-space: nowrap;
  }

  @media (max-width: 700px) {
    .articles-container {
      width: calc(100% - 32px);
    }
    .insights-carousel {
      grid-template-columns: 36px minmax(0, 1fr) 36px;
      gap: 8px;
    }
    .carousel-arrow {
      width: 36px;
      height: 36px;
      min-width: 36px;
      min-height: 36px;
    }
    .article-row {
      grid-template-columns: minmax(0, 1fr) 36px;
    }
    .row-date {
      grid-column: 1 / -1;
      flex-direction: row;
    }
  }
</style>
