---
// src/pages/gst/[...slug].astro

export function getStaticPaths() {
  return [
    { 
      params: { slug: 'test-article' }, 
      props: { 
        title: 'Understanding GST Basics for Small Businesses',
        date: 'November 10, 2026'
      } 
    },
  ];
}

const { title, date } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | Acomptic</title>
  </head>
  <body style="font-family: system-ui, sans-serif; max-width: 800px; margin: 40px auto; padding: 0 20px; line-height: 1.6; color: #121212;">
    <header style="margin-bottom: 40px; border-bottom: 1px solid #eaeaea; padding-bottom: 20px;">
      <a href="/" style="color: #666; text-decoration: none; font-size: 14px;">← Back to Home</a>
      <h1 style="margin-top: 10px; font-size: 32px;">{title}</h1>
      <p style="color: #666; font-size: 14px;">Published on {date}</p>
    </header>

    <main>
      <p>This article is built dynamically from a single catch-all route file!</p>
    </main>
  </body>
</html>
