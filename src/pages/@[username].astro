---
import Layout from "../layouts/Layout.astro";
import authorsData from "../data/authors.json";
import { getArticlesIndex } from "../utils/getArticlesIndex";

export async function getStaticPaths() {
  const allArticlesIndex = await getArticlesIndex();
  const paths = [];

  for (const [username, profile] of Object.entries(authorsData)) {
    const cleanUsername = username.trim().toLowerCase();

    const authorArticles = allArticlesIndex.filter(
      (art) => art.authorHandle === cleanUsername || art.authorHandle === `@${cleanUsername}`
    );

    paths.push({
      params: {
        username: cleanUsername,
        page: undefined,
      },
      props: {
        profile,
        username: cleanUsername,
        articles: authorArticles,
        totalArticles: authorArticles.length,
      },
    });
  }

  return paths;
}

const PAGE_SIZE = 10;

const { profile, username, articles, totalArticles } = Astro.props;

const formatDate = (date: string) =>
  new Date(`${date}T00:00:00`).toLocaleDateString("en-IN", {
    day: "numeric",
    month: "short",
    year: "numeric",
  });
---

<Layout title={`${profile.name} (@${username}) - Acomptic`}>
  <main class="author-profile-page">
    <div class="articles-container">
      
      <header class="author-header">
        <div class="author-avatar-wrap">
          {profile.avatar ? (
            <img class="author-avatar" src={profile.avatar} alt={profile.name} />
          ) : (
            <div class="author-avatar-placeholder">{profile.name.charAt(0)}</div>
          )}
        </div>
        <div class="author-info">
          <div class="author-title-block">
            <h1>{profile.name}</h1>
            <span class="author-handle">@{username}</span>
          </div>
          <p class="author-desc">{profile.description}</p>

          <div class="author-socials">
            {profile.instagram && (
              <a href={profile.instagram} class="social-link" target="_blank" rel="noopener noreferrer">Instagram</a>
            )}
            {profile.linkedin && (
              <a href={profile.linkedin} class="social-link" target="_blank" rel="noopener noreferrer">LinkedIn</a>
            )}
            {profile.x && (
              <a href={profile.x} class="social-link" target="_blank" rel="noopener noreferrer">X (Twitter)</a>
            )}
          </div>
        </div>
      </header>

      <section class="author-articles-section">
        <div class="section-title">
          <h2>Articles by {profile.name} <span>({totalArticles})</span></h2>
        </div>

        {articles.length > 0 ? (
          <div class="topic-articles-list">
            {articles.map((art, i) => (
              <a class="article-row" href={art.url} target="_self" hidden={i >= PAGE_SIZE}>
                <div class="row-date">
                  <span>{formatDate(art.date)}</span>
                  <span>{art.readTime} min read</span>
                  <span class="row-category">{art.category.toUpperCase()}</span>
                </div>
                <div class="row-copy">
                  <h4>{art.title}</h4>
                  <p>{art.excerpt}</p>
                </div>
                <span class="row-action" aria-label="Read article">
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M5 12h14M12 5l7 7-7 7" />
                  </svg>
                </span>
              </a>
            ))}
          </div>
        ) : (
          <div class="empty-state">
            <p>No articles published yet by {profile.name}.</p>
          </div>
        )}

        {totalArticles > PAGE_SIZE && (
          <div class="load-more-wrap" data-page-size={PAGE_SIZE} data-total={totalArticles}>
            <button type="button" id="load-more" class="pagination-link">Load more</button>
            <span id="load-more-status" class="pagination-info" aria-live="polite">
              Showing {PAGE_SIZE} of {totalArticles}
            </span>
          </div>
        )}
      </section>

    </div>
  </main>
</Layout>

<script>
  const wrap = document.querySelector<HTMLElement>(".load-more-wrap");
  const btn = document.getElementById("load-more");
  const status = document.getElementById("load-more-status");

  if (wrap && btn && status) {
    const pageSize = Number(wrap.dataset.pageSize);
    const total = Number(wrap.dataset.total);

    btn.addEventListener("click", () => {
      const hidden = document.querySelectorAll<HTMLElement>(".article-row[hidden]");
      hidden.forEach((el, i) => {
        if (i < pageSize) el.hidden = false;
      });

      const remaining = document.querySelectorAll(".article-row[hidden]").length;
      const shown = total - remaining;
      status.textContent = `Showing ${shown} of ${total}`;

      if (remaining === 0) {
        btn.remove();
      }
    });
  }
</script>

<style>
  .author-profile-page {
    background: var(--color-white, #fff);
    color: var(--color-ink, #121212);
    padding: 56px 0 88px;
  }

  .articles-container {
    width: min(1160px, calc(100% - 64px));
    margin-inline: auto;
  }

  .author-header {
    display: flex;
    gap: 32px;
    align-items: flex-start;
    padding-bottom: 40px;
    border-bottom: 1px solid var(--color-border, #e9e7ef);
  }

  .author-avatar {
    width: 96px;
    height: 96px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--color-purple-border, #e5dcff);
  }

  .author-avatar-placeholder {
    width: 96px;
    height: 96px;
    border-radius: 50%;
    background: var(--color-primary, #7654d6);
    color: #fff;
    font-size: 2.2rem;
    font-weight: 700;
    display: grid;
    place-items: center;
  }

  .author-title-block h1 {
    margin: 0;
    font-size: 2.1rem;
    font-weight: 700;
    letter-spacing: -.03em;
    line-height: 1.2;
  }

  .author-handle {
    display: block;
    margin-top: 4px;
    color: var(--color-purple-muted, #625d6b);
    font-size: 0.95rem;
    font-weight: 600;
  }

  .author-desc {
    margin: 12px 0 16px;
    color: var(--color-purple-muted, #625d6b);
    max-width: 680px;
    line-height: 1.65;
    font-size: .98rem;
  }

  .author-socials {
    display: flex;
    gap: 10px;
  }

  .social-link {
    display: inline-flex;
    padding: 6px 14px;
    border: 1px solid var(--color-purple-border, #e5dcff);
    border-radius: 999px;
    color: var(--color-primary, #7654d6);
    font-size: .82rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 180ms ease;
  }

  .social-link:hover {
    background: var(--color-primary, #7654d6);
    color: #fff;
    border-color: var(--color-primary, #7654d6);
  }

  .author-articles-section {
    padding-top: 40px;
  }

  .section-title h2 {
    margin: 0 0 24px;
    font-size: 1.5rem;
    font-weight: 680;
    letter-spacing: -.03em;
  }

  .section-title span {
    color: var(--color-purple-muted, #625d6b);
    font-weight: 500;
  }

  .topic-articles-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .article-row {
    display: grid;
    grid-template-columns: 168px minmax(0, 1fr) 42px;
    gap: 26px;
    align-items: center;
    padding: 22px 26px;
    border: 1px solid var(--color-border, #e9e7ef);
    border-radius: 15px;
    background: var(--color-white, #fff);
    color: inherit;
    text-decoration: none;
    transition: border-color 200ms ease, box-shadow 200ms ease;
  }

  /* display:grid overrides the hidden attribute, so force it */
  .article-row[hidden] {
    display: none;
  }

  .article-row:hover {
    border-color: var(--color-purple-border, #d9ccff);
    box-shadow: 0 8px 24px rgba(36, 25, 72, 0.055);
  }

  .row-date {
    display: flex;
    flex-direction: column;
    gap: 4px;
    color: var(--color-purple-muted, #625d6b);
    font-size: .8rem;
  }

  .row-category {
    color: var(--color-primary, #7654d6);
    font-weight: 700;
    font-size: .74rem;
  }

  .row-copy h4 {
    margin: 0;
    font-size: 1.2rem;
    font-weight: 650;
  }

  .row-copy p {
    margin: 6px 0 0;
    color: var(--color-purple-muted, #625d6b);
    font-size: .9rem;
  }

  .row-action {
    display: grid;
    width: 40px;
    height: 40px;
    place-items: center;
    border: 1px solid var(--color-border, #e9e7ef);
    border-radius: 50%;
    color: var(--color-primary, #7654d6);
  }

  .row-action svg {
    width: 17px;
    height: 17px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
  }

  .empty-state {
    padding: 36px;
    border: 1px solid var(--color-border, #e9e7ef);
    border-radius: 15px;
    color: var(--color-purple-muted, #625d6b);
  }

  .load-more-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    margin-top: 36px;
    padding-top: 24px;
    border-top: 1px solid var(--color-border, #e9e7ef);
  }

  .pagination-link {
    padding: 8px 16px;
    border: 1px solid var(--color-border, #e9e7ef);
    border-radius: 8px;
    background: #fff;
    color: var(--color-primary, #7654d6);
    font-weight: 600;
    text-decoration: none;
    font-size: .9rem;
    cursor: pointer;
    transition: all 180ms ease;
  }

  .pagination-link:hover {
    background: var(--color-primary, #7654d6);
    color: #fff;
    border-color: var(--color-primary, #7654d6);
  }

  .pagination-info {
    color: var(--color-purple-muted, #625d6b);
    font-size: .9rem;
    font-weight: 500;
  }

  @media (max-width: 760px) {
    .author-header {
      flex-direction: column;
      gap: 20px;
    }
    .article-row {
      grid-template-columns: minmax(0, 1fr) 36px;
    }
    .row-date {
      grid-column: 1 / -1;
      flex-direction: row;
      gap: 12px;
    }
  }
</style>
