---
import Layout from "../layouts/Layout.astro";
import authorsData from "../data/authors.json";
import { getArticlesIndex } from "../utils/getArticlesIndex";

const SITE_URL = "https://articles.acomptic.com";

export async function getStaticPaths() {
  const allArticlesIndex = await getArticlesIndex();

  return Object.entries(authorsData).map(([username, profile]) => {
    const cleanUsername = username.trim().replace(/^@/, "").toLowerCase();

    const authorArticles = allArticlesIndex.filter((art) => {
      const handle = String(art.authorHandle || "").trim().replace(/^@/, "").toLowerCase();
      return handle === cleanUsername;
    });

    return {
      params: { username: cleanUsername, page: undefined },
      props: {
        profile,
        username: cleanUsername,
        articles: authorArticles,
        totalArticles: authorArticles.length,
      },
    };
  });
}

const PAGE_SIZE = 10;
const { profile, username, articles, totalArticles } = Astro.props;

const authorName = profile.name || username;
const authorDescription =
  profile.description ||
  `Explore articles and practical insights written by ${authorName} on Acomptic.`;

const canonical = new URL(Astro.url.pathname, SITE_URL);
canonical.search = "";
canonical.hash = "";
const canonicalURL = canonical.href;
const profileImage = profile.avatar
  ? new URL(profile.avatar, SITE_URL).href
  : null;

const categoryMap = new Map<string, number>();
for (const art of articles) {
  const key = String(art.category || "").trim().toLowerCase();
  if (key) categoryMap.set(key, (categoryMap.get(key) || 0) + 1);
}
const categories = Array.from(categoryMap.entries()).sort((a, b) => b[1] - a[1]);

const sortOptions = [
  { value: "newest", label: "Newest first" },
  { value: "oldest", label: "Oldest first" },
  { value: "shortest", label: "Shortest read" },
  { value: "longest", label: "Longest read" },
];

const formatDate = (date: string) =>
  new Date(`${date}T00:00:00`).toLocaleDateString("en-IN", {
    day: "numeric",
    month: "short",
    year: "numeric",
  });

const articleItems = articles.map((art, index) => ({
  "@type": "ListItem",
  position: index + 1,
  url: new URL(art.url, SITE_URL).href,
  name: art.title,
}));

const sameAs = [profile.instagram, profile.linkedin, profile.x].filter(Boolean);

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "ProfilePage",
    "@id": `${canonicalURL}#profilepage`,
    url: canonicalURL,
    name: `${authorName} – Author at Acomptic`,
    description: authorDescription,
    inLanguage: "en-IN",
    mainEntity: {
      "@type": "Person",
      "@id": `${canonicalURL}#person`,
      name: authorName,
      description: authorDescription,
      ...(profileImage ? { image: profileImage } : {}),
      url: canonicalURL,
      ...(sameAs.length ? { sameAs } : {}),
    },
    ...(articles.length
      ? {
          mainEntityOfPage: canonicalURL,
          hasPart: {
            "@type": "ItemList",
            name: `Articles by ${authorName}`,
            numberOfItems: articles.length,
            itemListOrder: "https://schema.org/ItemListOrderDescending",
            itemListElement: articleItems,
          },
        }
      : {}),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: "https://acomptic.com/" },
      { "@type": "ListItem", position: 2, name: "Articles", item: `${SITE_URL}/` },
      { "@type": "ListItem", position: 3, name: authorName, item: canonicalURL },
    ],
  },
];
---

<Layout
  title={`${authorName} – Author at Acomptic | Articles`}
  description={authorDescription}
  canonicalURL={canonicalURL}
  schema={schema}
  author={authorName}
  ogType="profile"
  ogImage={profile.avatar || "/og-image.png"}
  ogImageAlt={`${authorName} – Acomptic author profile`}
>
  <main class="author-page">
    <div class="author-container">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href="/">Articles</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{authorName}</span>
      </nav>

      <header class="profile-hero">
        <div class="profile-avatar-shell">
          {profile.avatar ? (
            <img
              class="profile-avatar"
              src={profile.avatar}
              alt={`${authorName}, Acomptic author`}
              width="144"
              height="144"
              fetchpriority="high"
            />
          ) : (
            <div class="profile-avatar profile-avatar-fallback" aria-hidden="true">
              {authorName.charAt(0).toUpperCase()}
            </div>
          )}
        </div>

        <div class="profile-content">
          <span class="eyebrow">AUTHOR PROFILE</span>
          <h1>{authorName}</h1>
          <p class="profile-handle">@{username}</p>
          <p class="profile-description">{authorDescription}</p>

          <div class="profile-socials" aria-label={`${authorName}'s social profiles`}>
            {profile.instagram && (
              <a href={profile.instagram} target="_blank" rel="noopener noreferrer" aria-label={`${authorName} on Instagram`}>
                <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" class="social-fill"/></svg>
                <span>Instagram</span>
              </a>
            )}
            {profile.linkedin && (
              <a href={profile.linkedin} target="_blank" rel="noopener noreferrer" aria-label={`${authorName} on LinkedIn`}>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 9v10M5 5v.1M10 19v-6a4 4 0 0 1 8 0v6M10 10v9"/></svg>
                <span>LinkedIn</span>
              </a>
            )}
            {profile.x && (
              <a href={profile.x} target="_blank" rel="noopener noreferrer" aria-label={`${authorName} on X`}>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4l16 16M20 4 4 20M4 4h5l11 16h-5z"/></svg>
                <span> X</span>
              </a>
            )}
          </div>
        </div>

        <div class="profile-stat" aria-label={`${totalArticles} published articles`}>
          <strong>{totalArticles}</strong>
          <span>{totalArticles === 1 ? "Article published" : "Articles published"}</span>
        </div>
      </header>

      <section class="author-articles" aria-labelledby="articles-heading">
        <div class="section-heading">
          <div>
            <span class="eyebrow">WRITING & INSIGHTS</span>
            <h2 id="articles-heading">Articles by {authorName}</h2>
            <p>Explore the latest guides, explainers and insights from {authorName}.</p>
          </div>
          <span class="article-count">{totalArticles} {totalArticles === 1 ? "article" : "articles"}</span>
        </div>

        {totalArticles > 0 && (
          <div class="article-tools">
            <div class="search-field" role="search">
              <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></svg>
              <input
                id="author-search-input"
                type="search"
                placeholder={`Search ${authorName}'s articles`}
                autocomplete="off"
                aria-label={`Search articles by ${authorName}`}
              />
              <kbd id="search-kbd" aria-hidden="true">/</kbd>
              <button type="button" id="search-clear" aria-label="Clear search" hidden>×</button>
            </div>

            <div class="tool-row">
              {categories.length > 1 && (
                <div class="category-chips" id="category-chips" role="group" aria-label="Filter articles by category">
                  <button type="button" class="chip is-active" data-cat="all" aria-pressed="true">All <span>{totalArticles}</span></button>
                  {categories.map(([cat, count]) => (
                    <button type="button" class="chip" data-cat={cat} aria-pressed="false">
                      {cat.toUpperCase()} <span>{count}</span>
                    </button>
                  ))}
                </div>
              )}

              <label class="sort-control">
                <span>Sort by</span>
                <select id="sort-select" aria-label="Sort articles">
                  {sortOptions.map((option) => (
                    <option value={option.value}>{option.label}</option>
                  ))}
                </select>
              </label>
            </div>
            <p class="search-hint">Search by title, summary or category. Press <kbd>/</kbd> to focus search.</p>
          </div>
        )}

        <p id="results-status" class="results-status" aria-live="polite"></p>

        {articles.length > 0 ? (
          <div class="article-list" id="articles-list" data-page-size={PAGE_SIZE}>
            {articles.map((art, index) => (
              <a
                class="article-card"
                href={art.url}
                hidden={index >= PAGE_SIZE}
                data-category={String(art.category || "").toLowerCase()}
                data-date={art.date}
                data-read={art.readTime}
              >
                <div class="card-meta">
                  <time datetime={art.date}>{formatDate(art.date)}</time>
                  <span class="meta-dot" aria-hidden="true">·</span>
                  <span>{art.readTime} min read</span>
                  <span class="card-category">{art.category}</span>
                </div>
                <div class="card-copy">
                  <h3>{art.title}</h3>
                  <p>{art.excerpt}</p>
                </div>
                <span class="card-arrow" aria-hidden="true">
                  <svg viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </span>
              </a>
            ))}
          </div>
        ) : (
          <div class="empty-state">
            <span class="empty-icon" aria-hidden="true">✦</span>
            <h3>More articles are on the way</h3>
            <p>{authorName} has not published any articles yet. Please check back soon.</p>
          </div>
        )}

        <div class="empty-state no-results" id="no-results" hidden>
          <h3>No matching articles</h3>
          <p>Try another search term or clear your filters.</p>
          <button type="button" id="no-results-clear" class="primary-button">Clear search & filters</button>
        </div>

        {totalArticles > PAGE_SIZE && (
          <div class="load-more-wrap" id="load-more-wrap">
            <button type="button" id="load-more" class="secondary-button">Load more articles</button>
          </div>
        )}
      </section>
    </div>
  </main>
</Layout>

<script>
  const list = document.getElementById("articles-list");

  if (list) {
    const PAGE = Number(list.dataset.pageSize) || 10;
    const input = document.getElementById("author-search-input") as HTMLInputElement | null;
    const clearBtn = document.getElementById("search-clear") as HTMLButtonElement | null;
    const kbd = document.getElementById("search-kbd");
    const chips = document.getElementById("category-chips");
    const sortSelect = document.getElementById("sort-select") as HTMLSelectElement | null;
    const status = document.getElementById("results-status");
    const noResults = document.getElementById("no-results");
    const resetButton = document.getElementById("no-results-clear");
    const loadMoreWrap = document.getElementById("load-more-wrap");
    const loadMoreButton = document.getElementById("load-more") as HTMLButtonElement | null;

    const rows = Array.from(list.querySelectorAll<HTMLElement>(".article-card")).map((el, index) => ({
      el,
      index,
      title: el.querySelector("h3")?.textContent?.toLowerCase() || "",
      excerpt: el.querySelector(".card-copy p")?.textContent?.toLowerCase() || "",
      category: el.dataset.category || "",
      date: el.dataset.date || "",
      read: Number(el.dataset.read) || 0,
    }));

    let query = "";
    let category = "all";
    let sort = "newest";
    let shown = PAGE;
    let timer: number | undefined;

    const params = new URLSearchParams(location.search);
    query = params.get("q") || "";
    category = params.get("cat") || "all";
    sort = params.get("sort") || "newest";
    if (!["newest", "oldest", "shortest", "longest"].includes(sort)) sort = "newest";
    if (!rows.some((row) => row.category === category)) category = "all";
    if (input) input.value = query;
    if (sortSelect) sortSelect.value = sort;

    function syncUrl() {
      const next = new URLSearchParams();
      if (query.trim()) next.set("q", query.trim());
      if (category !== "all") next.set("cat", category);
      if (sort !== "newest") next.set("sort", sort);
      history.replaceState(null, "", location.pathname + (next.toString() ? `?${next}` : ""));
    }

    function render() {
      const term = query.trim().toLowerCase();
      const matched = rows.filter((row) => {
        const matchesCategory = category === "all" || row.category === category;
        const haystack = `${row.title} ${row.excerpt} ${row.category}`;
        return matchesCategory && (!term || haystack.includes(term));
      });

      matched.sort((a, b) => {
        if (sort === "oldest") return a.date.localeCompare(b.date) || a.index - b.index;
        if (sort === "shortest") return a.read - b.read || b.date.localeCompare(a.date);
        if (sort === "longest") return b.read - a.read || b.date.localeCompare(a.date);
        return b.date.localeCompare(a.date) || a.index - b.index;
      });

      const visible = Math.min(shown, matched.length);
      const matchedSet = new Set(matched);
      const fragment = document.createDocumentFragment();

      matched.forEach((row, index) => {
        row.el.hidden = index >= shown;
        fragment.appendChild(row.el);
      });
      rows.forEach((row) => {
        if (!matchedSet.has(row)) {
          row.el.hidden = true;
          fragment.appendChild(row.el);
        }
      });
      list.appendChild(fragment);

      list.hidden = matched.length === 0;
      if (noResults) noResults.hidden = matched.length !== 0;
      if (status) {
        status.textContent = matched.length
          ? `Showing ${visible} of ${matched.length} ${matched.length === 1 ? "article" : "articles"}`
          : "";
      }
      if (loadMoreWrap && loadMoreButton) {
        loadMoreWrap.hidden = matched.length <= visible;
        loadMoreButton.textContent = `Load more (${matched.length - visible} remaining)`;
      }
      if (clearBtn) clearBtn.hidden = !query;
      if (kbd) kbd.hidden = Boolean(query);

      chips?.querySelectorAll<HTMLButtonElement>(".chip").forEach((chip) => {
        const active = chip.dataset.cat === category;
        chip.classList.toggle("is-active", active);
        chip.setAttribute("aria-pressed", String(active));
      });
    }

    function reset() {
      query = "";
      category = "all";
      sort = "newest";
      shown = PAGE;
      if (input) input.value = "";
      if (sortSelect) sortSelect.value = sort;
      syncUrl();
      render();
    }

    input?.addEventListener("input", () => {
      window.clearTimeout(timer);
      timer = window.setTimeout(() => {
        query = input.value;
        shown = PAGE;
        syncUrl();
        render();
      }, 100);
    });

    input?.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && input.value) {
        input.value = "";
        query = "";
        shown = PAGE;
        syncUrl();
        render();
      }
    });

    clearBtn?.addEventListener("click", () => {
      if (input) input.value = "";
      query = "";
      shown = PAGE;
      syncUrl();
      render();
      input?.focus();
    });

    chips?.addEventListener("click", (event) => {
      const chip = (event.target as HTMLElement).closest<HTMLButtonElement>(".chip");
      if (!chip) return;
      category = chip.dataset.cat || "all";
      shown = PAGE;
      syncUrl();
      render();
    });

    sortSelect?.addEventListener("change", () => {
      sort = sortSelect.value;
      shown = PAGE;
      syncUrl();
      render();
    });

    resetButton?.addEventListener("click", reset);
    loadMoreButton?.addEventListener("click", () => {
      shown += PAGE;
      render();
    });

    document.addEventListener("keydown", (event) => {
      if (event.key !== "/" || event.ctrlKey || event.metaKey || event.altKey) return;
      const target = event.target as HTMLElement;
      if (target && (target.tagName === "INPUT" || target.tagName === "TEXTAREA" || target.tagName === "SELECT" || target.isContentEditable)) return;
      event.preventDefault();
      input?.focus();
    });

    render();
  }
</script>

<style>
  .author-page {
    --a-primary: var(--color-primary, #7654d6);
    --a-primary-hover: #5f3fc0;
    --a-ink: var(--color-ink, #121212);
    --a-muted: var(--color-purple-muted, #625d6b);
    --a-border: var(--color-border, #e9e7ef);
    --a-soft: var(--color-surface-soft, #faf9fc);
    --a-white: var(--color-white, #fff);
    background: var(--a-white);
    color: var(--a-ink);
    font-family: var(--font-primary);
    line-height: 1.618;
    padding: clamp(34px, 5vw, 64px) 0 88px;
    overflow-wrap: anywhere;
  }

  .author-page *,
  .author-page *::before,
  .author-page *::after { box-sizing: border-box; }

  .author-container {
    width: min(1120px, calc(100% - 48px));
    margin-inline: auto;
  }

  .breadcrumbs {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 10px;
    margin-bottom: 26px;
    color: var(--a-muted);
    font-size: .84rem;
  }

  .breadcrumbs a {
    color: var(--a-primary);
    text-decoration: none;
  }

  .breadcrumbs a:hover { text-decoration: underline; }

  .profile-hero {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: clamp(30px, 5vw, 56px) clamp(20px, 5vw, 64px);
    border: 1px solid var(--a-border);
    border-radius: 22px;
    background:
      radial-gradient(ellipse at 50% 0%, rgba(118, 84, 214, .09), transparent 62%),
      var(--a-white);
    text-align: center;
    box-shadow: 0 12px 40px rgba(36, 25, 72, .045);
  }

  .profile-avatar-shell {
    width: 152px;
    height: 152px;
    padding: 5px;
    border: 1px solid #ded5fb;
    border-radius: 50%;
    background: linear-gradient(145deg, #f2edff, #fff);
    box-shadow: 0 8px 28px rgba(80, 56, 150, .12);
  }

  .profile-avatar {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
  }

  .profile-avatar-fallback {
    display: grid;
    place-items: center;
    background: var(--a-primary);
    color: #fff;
    font-size: 3.4rem;
    font-weight: 700;
  }

  .profile-content { width: min(100%, 760px); }

  .eyebrow {
    display: inline-block;
    margin-top: 22px;
    color: var(--a-primary);
    font-size: .72rem;
    font-weight: 750;
    letter-spacing: .15em;
  }

  .profile-content h1 {
    margin: 7px 0 0;
    color: var(--a-ink);
    font-size: clamp(2.1rem, 5vw, 3.25rem);
    font-weight: 650;
    letter-spacing: -.055em;
    line-height: 1.12;
    text-wrap: balance;
  }

  .profile-handle {
    margin: 9px 0 0;
    color: var(--a-primary);
    font-size: .96rem;
    font-weight: 600;
  }

  .profile-description {
    max-width: 680px;
    margin: 18px auto 0;
    color: var(--a-muted);
    font-size: clamp(1rem, 1.5vw, 1.1rem);
    line-height: 1.8;
    text-wrap: pretty;
  }

  .profile-socials {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    margin-top: 24px;
  }

  .profile-socials a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 40px;
    padding: 8px 13px;
    border: 1px solid var(--a-border);
    border-radius: 999px;
    background: var(--a-white);
    color: var(--a-ink);
    font-size: .83rem;
    font-weight: 600;
    text-decoration: none;
    transition: border-color 180ms ease, color 180ms ease, transform 180ms ease;
  }

  .profile-socials a:hover,
  .profile-socials a:focus-visible {
    border-color: var(--a-primary);
    color: var(--a-primary);
    transform: translateY(-2px);
    outline: none;
  }

  .profile-socials svg {
    width: 17px;
    height: 17px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .profile-socials .social-fill { fill: currentColor; stroke: none; }

  .profile-stat {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-top: 30px;
    padding: 10px 18px;
    border: 1px solid #e4dcfb;
    border-radius: 999px;
    background: #faf8ff;
  }

  .profile-stat strong {
    color: var(--a-primary);
    font-size: 1.15rem;
    line-height: 1;
  }

  .profile-stat span {
    color: var(--a-muted);
    font-size: .8rem;
    font-weight: 600;
  }

  .author-articles { margin-top: clamp(48px, 6vw, 72px); }

  .section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 25px;
    padding-bottom: 22px;
    border-bottom: 1px solid var(--a-border);
  }

  .section-heading .eyebrow { margin: 0 0 8px; }

  .section-heading h2 {
    margin: 0;
    color: var(--a-ink);
    font-size: clamp(1.65rem, 3vw, 2.2rem);
    font-weight: 650;
    letter-spacing: -.045em;
    line-height: 1.2;
  }

  .section-heading p {
    margin: 9px 0 0;
    color: var(--a-muted);
    font-size: .94rem;
  }

  .article-count {
    flex-shrink: 0;
    padding: 7px 12px;
    border: 1px solid var(--a-border);
    border-radius: 999px;
    color: var(--a-muted);
    font-size: .8rem;
    font-weight: 650;
  }

  .article-tools { margin-bottom: 20px; }

  .search-field {
    position: relative;
    display: flex;
    align-items: center;
  }

  .search-field > svg {
    position: absolute;
    left: 17px;
    width: 19px;
    height: 19px;
    fill: none;
    stroke: var(--a-muted);
    stroke-width: 1.8;
    stroke-linecap: round;
    pointer-events: none;
  }

  #author-search-input {
    width: 100%;
    min-height: 54px;
    padding: 13px 60px 13px 48px;
    border: 1px solid var(--a-border);
    border-radius: 13px;
    background: var(--a-white);
    color: var(--a-ink);
    font: inherit;
    font-size: .95rem;
    outline: none;
    appearance: none;
    transition: border-color 180ms ease, box-shadow 180ms ease;
  }

  #author-search-input::placeholder { color: var(--a-muted); opacity: .75; }

  #author-search-input:focus {
    border-color: var(--a-primary);
    box-shadow: 0 0 0 4px rgba(118, 84, 214, .11);
  }

  #author-search-input::-webkit-search-cancel-button { appearance: none; }

  #search-kbd {
    position: absolute;
    right: 15px;
    padding: 2px 8px;
    border: 1px solid var(--a-border);
    border-radius: 6px;
    background: var(--a-soft);
    color: var(--a-muted);
    font: inherit;
    font-size: .78rem;
  }

  #search-clear {
    position: absolute;
    right: 12px;
    width: 30px;
    height: 30px;
    border: 0;
    border-radius: 50%;
    background: var(--a-soft);
    color: var(--a-muted);
    font-size: 1.3rem;
    cursor: pointer;
  }

  #search-clear[hidden], #search-kbd[hidden] { display: none; }

  .tool-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
