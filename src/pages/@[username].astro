---
import Layout from "../layouts/Layout.astro";
import authorsData from "../data/authors.json";
import { getArticlesIndex } from "../utils/getArticlesIndex";

export async function getStaticPaths() {
  const allArticlesIndex = await getArticlesIndex();
  const paths = [];

  for (const [username, profile] of Object.entries(authorsData)) {
    const cleanUsername = username.trim().toLowerCase();

    const authorArticles = allArticlesIndex.filter((art) => {
      const handle = String(art.authorHandle || "").trim().toLowerCase();
      return handle === cleanUsername || handle === `@${cleanUsername}`;
    });

    paths.push({
      params: { username: cleanUsername },
      props: {
        profile,
        username: cleanUsername,
        articles: authorArticles,
        totalArticles: authorArticles.length,
      },
    });
  }

  return paths;
}

const PAGE_SIZE = 10;

const { profile: rawProfile, username, articles, totalArticles } = Astro.props;

// The authors file may carry optional extras (jobTitle, role...), so read it loosely.
const profile = rawProfile as Record<string, any>;
const authorName = String(profile.name || username).trim();
const authorDesc = String(profile.description || "").trim();
const jobTitle = (profile.jobTitle || profile.role || "") as string;

const mainSiteURL = "https://acomptic.com";
const siteOrigin = (Astro.site ?? new URL("https://articles.acomptic.com")).origin;

// Canonical URL: always the clean profile address, never ?q=, ?cat= or ?sort=
const pageUrl = new URL(Astro.url.pathname, siteOrigin);
pageUrl.search = "";
pageUrl.hash = "";

// ---------- categories ----------
const categoryNames: Record<string, string> = {
  insights: "Insights",
  gst: "GST",
  "income-tax": "Income Tax",
};

// "income-tax" -> "Income Tax", "tds" -> "TDS"
const getCategoryName = (slug: string) => {
  if (categoryNames[slug]) return categoryNames[slug];
  if (slug.replace(/-/g, "").length <= 3) return slug.replace(/-/g, " ").toUpperCase();
  return slug
    .split("-")
    .filter(Boolean)
    .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
    .join(" ");
};

// Unique categories with counts, for the filter chips and the topic links
const categoryMap = new Map<string, number>();
for (const art of articles) {
  const key = String(art.category || "").trim().toLowerCase();
  if (key) categoryMap.set(key, (categoryMap.get(key) || 0) + 1);
}
const categories = Array.from(categoryMap.entries())
  .sort((a, b) => b[1] - a[1])
  .map(([slug, count]) => ({ slug, count, name: getCategoryName(slug) }));

const sortOptions = [
  { value: "relevance", label: "Best match" },
  { value: "newest", label: "Newest first" },
  { value: "oldest", label: "Oldest first" },
  { value: "shortest", label: "Shortest read" },
  { value: "longest", label: "Longest read" },
];

const formatDate = (date: string) =>
  new Date(`${date}T00:00:00`).toLocaleDateString("en-IN", {
    day: "numeric",
    month: "short",
    year: "numeric",
  });

const articleWord = totalArticles === 1 ? "article" : "articles";

// ---------- SEO text ----------
const clip = (text: string, max: number) => {
  if (text.length <= max) return text;
  return text.slice(0, max - 1).replace(/\s+\S*$/, "").replace(/[,;:\-–]$/, "") + "…";
};

const pageTitle = `${authorName} (@${username}) | Author at Acomptic Articles`;

const topicList = categories.slice(0, 3).map((c) => c.name);
const descTail =
  totalArticles > 0
    ? ` Read ${totalArticles} ${articleWord} by ${authorName}${
        topicList.length ? ` on ${topicList.join(", ")}` : ""
      }.`
    : "";
const descHead = authorDesc
  ? clip(authorDesc, Math.max(60, 158 - descTail.length))
  : `${authorName} is an author at Acomptic.`;
const pageDescription = `${/[.!?…]$/.test(descHead) ? descHead : `${descHead}.`}${descTail}`.trim();

const newestFirst = [...articles].sort(
  (a, b) => new Date(b.date).getTime() - new Date(a.date).getTime(),
);
const latestDate = newestFirst[0]?.date;

// ---------- images ----------
const avatarUrl = profile.avatar ? new URL(profile.avatar, siteOrigin).href : undefined;

// ---------- social profiles ----------
const socials = [
  { key: "instagram", label: "Instagram", url: profile.instagram as string | undefined },
  { key: "linkedin", label: "LinkedIn", url: profile.linkedin as string | undefined },
  { key: "x", label: "X (Twitter)", url: profile.x as string | undefined },
].filter((s) => Boolean(s.url));

// ---------- structured data ----------
// Keep the structured data light: the latest 50 articles are enough.
const itemListSchema = newestFirst.slice(0, 50).map((art, index) => ({
  "@type": "ListItem",
  position: index + 1,
  url: new URL(art.url, siteOrigin).href,
  name: art.title,
}));

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "ProfilePage",
    "@id": `${pageUrl.href}#profilepage`,
    url: pageUrl.href,
    name: pageTitle,
    description: pageDescription,
    inLanguage: "en-IN",
    isPartOf: { "@id": `${siteOrigin}/#website` },
    breadcrumb: { "@id": `${pageUrl.href}#breadcrumb` },
    publisher: { "@id": `${mainSiteURL}/#organization` },
    mainEntity: { "@id": `${pageUrl.href}#person` },
    ...(totalArticles > 0 ? { hasPart: { "@id": `${pageUrl.href}#articles` } } : {}),
    ...(latestDate ? { dateModified: latestDate } : {}),
  },
  {
    "@context": "https://schema.org",
    "@type": "Person",
    "@id": `${pageUrl.href}#person`,
    name: authorName,
    alternateName: `@${username}`,
    url: pageUrl.href,
    mainEntityOfPage: { "@id": `${pageUrl.href}#profilepage` },
    ...(authorDesc ? { description: authorDesc } : {}),
    ...(jobTitle ? { jobTitle } : {}),
    ...(avatarUrl
      ? { image: { "@type": "ImageObject", url: avatarUrl, caption: authorName } }
      : {}),
    ...(socials.length ? { sameAs: socials.map((s) => s.url) } : {}),
    ...(categories.length ? { knowsAbout: categories.map((c) => c.name) } : {}),
    worksFor: { "@id": `${mainSiteURL}/#organization` },
  },
  ...(totalArticles > 0
    ? [
        {
          "@context": "https://schema.org",
          "@type": "ItemList",
          "@id": `${pageUrl.href}#articles`,
          name: `Articles by ${authorName}`,
          numberOfItems: totalArticles,
          itemListOrder: "https://schema.org/ItemListOrderDescending",
          itemListElement: itemListSchema,
        },
      ]
    : []),
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "@id": `${pageUrl.href}#breadcrumb`,
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${mainSiteURL}/` },
      { "@type": "ListItem", position: 2, name: "Articles", item: `${siteOrigin}/` },
      { "@type": "ListItem", position: 3, name: authorName, item: pageUrl.href },
    ],
  },
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonicalURL={pageUrl.href}
  ogType="profile"
  ogImage={profile.avatar || "/og-image.png"}
  ogImageAlt={`${authorName}, author at Acomptic`}
  author={authorName}
  schema={schema}
>
  <main class="author-profile-page">
    <div class="articles-container">

      <!-- BREADCRUMB -->
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <ol>
          <li><a href="/">Articles</a></li>
          <li aria-current="page"><span>{authorName}</span></li>
        </ol>
      </nav>

      <!-- AUTHOR HEADER -->
      <header class="author-header">
        <div class="author-avatar-wrap">
          {profile.avatar ? (
            <img
              class="author-avatar"
              src={profile.avatar}
              alt={`${authorName}, author at Acomptic`}
              width="112"
              height="112"
              decoding="async"
              fetchpriority="high"
            />
          ) : (
            <div class="author-avatar-placeholder" aria-hidden="true">{authorName.charAt(0)}</div>
          )}
        </div>

        <h1>
          <span class="author-name">{authorName}</span>
          <span class="verified-badge" title="Verified author" aria-label="Verified author" role="img">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path class="vb-shape" d="M22.25 12c0-1.43-.88-2.67-2.19-3.34.46-1.39.2-2.9-.81-3.91s-2.52-1.27-3.91-.81c-.66-1.31-1.91-2.19-3.34-2.19s-2.67.88-3.33 2.19c-1.4-.46-2.91-.2-3.92.81s-1.26 2.52-.8 3.91c-1.31.67-2.2 1.91-2.2 3.34s.89 2.67 2.2 3.34c-.46 1.39-.21 2.9.8 3.91s2.52 1.26 3.91.81c.67 1.31 1.91 2.19 3.34 2.19s2.68-.88 3.34-2.19c1.39.45 2.9.2 3.91-.81s1.27-2.52.81-3.91c1.31-.67 2.19-1.91 2.19-3.34z" />
              <path class="vb-check" d="M9.5 16.2l-3.7-3.7 1.4-1.4 2.3 2.3 6.3-6.3 1.4 1.4z" />
            </svg>
          </span>
        </h1>

        <p class="author-handle">@{username}</p>

        {authorDesc && <p class="author-desc">{authorDesc}</p>}

        <p class="author-stats">
          <span>{totalArticles} {articleWord}</span>
          {categories.length > 0 && (
            <>
              <span aria-hidden="true">·</span>
              <span>{categories.length} {categories.length === 1 ? "topic" : "topics"}</span>
            </>
          )}
        </p>

        {socials.length > 0 && (
          <div class="author-socials">
            {socials.map((s) => (
              <a
                href={s.url}
                class="author-social"
                target="_blank"
                rel="me noopener noreferrer"
                aria-label={`${authorName} on ${s.label}`}
                title={s.label}
              >
                {s.key === "instagram" && (
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <rect x="2" y="2" width="20" height="20" rx="5" />
                    <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" />
                    <path d="M17.5 6.5h.01" />
                  </svg>
                )}
                {s.key === "linkedin" && (
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z" />
                    <rect x="2" y="9" width="4" height="12" />
                    <circle cx="4" cy="4" r="2" />
                  </svg>
                )}
                {s.key === "x" && (
                  <svg class="icon-fill" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M14.234 10.162 22.977 0h-2.072l-7.591 8.824L7.251 0H.258l9.168 13.343L.258 24H2.33l8.016-9.318L16.749 24h6.993zm-2.837 3.299-.929-1.329L3.076 1.56h3.182l5.965 8.532.929 1.329 7.754 11.09h-3.182z" />
                  </svg>
                )}
              </a>
            ))}
          </div>
        )}
      </header>

      <!-- ARTICLES BY THIS AUTHOR -->
      <section class="author-articles-section" aria-labelledby="author-articles-title">
        <div class="section-title">
          <h2 id="author-articles-title">
            Articles by {authorName} <span>({totalArticles})</span>
          </h2>
        </div>

        {totalArticles > 0 && (
          <div class="author-search" role="search">
            <div class="search-field">
              <svg class="search-icon" viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="11" cy="11" r="7" />
                <path d="M20 20l-3.5-3.5" />
              </svg>
              <input
                id="author-search-input"
                type="search"
                placeholder={`Search ${authorName}'s articles…`}
                autocomplete="off"
                spellcheck="false"
                aria-label={`Search articles by ${authorName}`}
              />
              <kbd class="search-kbd" id="search-kbd" aria-hidden="true">/</kbd>
              <button type="button" id="search-clear" class="search-clear" aria-label="Clear search" hidden>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
              </button>
            </div>

            <div class="search-controls">
              {categories.length > 1 && (
                <div class="chips" id="category-chips" role="group" aria-label="Filter by topic">
                  <button type="button" class="chip is-active" data-cat="all" aria-pressed="true">
                    <span>All</span> <span class="chip-count">({totalArticles})</span>
                  </button>
                  {categories.map((cat) => (
                    <button type="button" class="chip" data-cat={cat.slug} aria-pressed="false">
                      <span>{cat.name}</span> <span class="chip-count">({cat.count})</span>
                    </button>
                  ))}
                </div>
              )}

              <div class="sort-wrap">
                <span class="sort-label" id="sort-label">Sort</span>
                <div class="dropdown" id="sort-dropdown">
                  <button
                    type="button"
                    class="dropdown-trigger"
                    id="sort-trigger"
                    aria-haspopup="listbox"
                    aria-expanded="false"
                    aria-labelledby="sort-label sort-current"
                  >
                    <span id="sort-current">Newest first</span>
                    <svg class="chev" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6" /></svg>
                  </button>

                  <ul class="dropdown-menu" id="sort-menu" role="listbox" aria-labelledby="sort-label" hidden>
                    {sortOptions.map((opt) => (
                      <li
                        class="dropdown-option"
                        role="option"
                        tabindex="-1"
                        data-value={opt.value}
                        aria-selected={opt.value === "newest" ? "true" : "false"}
                      >
                        <span>{opt.label}</span>
                        <svg class="check" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            </div>

            <p class="search-hint">
              Tip: use "quotes" for an exact phrase and -word to exclude a word. Small typos are forgiven.
            </p>
          </div>
        )}

        <p id="results-status" class="results-status" aria-live="polite"></p>

        {articles.length > 0 ? (
          <div class="topic-articles-list" id="articles-list" data-page-size={PAGE_SIZE}>
            {articles.map((art, i) => (
              <a
                class="article-row"
                href={art.url}
                target="_self"
                hidden={i >= PAGE_SIZE}
                data-category={String(art.category || "").trim().toLowerCase()}
                data-date={art.date}
                data-read={art.readTime}
              >
                <div class="row-date">
                  <time datetime={art.date}>{formatDate(art.date)}</time>
                  <span>{art.readTime} min read</span>
                  <span class="row-category">{getCategoryName(String(art.category || "").trim().toLowerCase())}</span>
                </div>
                <div class="row-copy">
                  <h3>{art.title}</h3>
                  <p>{art.excerpt}</p>
                </div>
                <span class="row-action" aria-hidden="true">
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M5 12h14M12 5l7 7-7 7" />
                  </svg>
                </span>
              </a>
            ))}
          </div>
        ) : (
          <div class="empty-state">
            <p>No articles published yet by {authorName}.</p>
          </div>
        )}

        <div class="empty-state no-results" id="no-results" hidden>
          <p>No articles match your search.</p>
          <button type="button" id="no-results-clear" class="pill-button">Clear search and filters</button>
        </div>

        {totalArticles > PAGE_SIZE && (
          <div class="load-more-wrap" id="load-more-wrap">
            <button type="button" id="load-more" class="pill-button">Load more</button>
          </div>
        )}
      </section>

      <!-- TOPICS THIS AUTHOR COVERS (internal links) -->
      {categories.length > 0 && (
        <section class="more-topics" aria-labelledby="more-topics-title">
          <h2 class="more-topics-title" id="more-topics-title">Topics covered</h2>
          <div class="topic-chips">
            {categories.map((cat) => (
              <a class="pill-button" href={`/${cat.slug}/`}>
                <span>{cat.name}</span>
                <span class="chip-count">({cat.count})</span>
              </a>
            ))}
          </div>
        </section>
      )}

      <!-- ACOMPTIC CTA CARD -->
      <section class="author-cta" aria-labelledby="author-cta-title">
        <div class="cta-card">
          <div class="cta-copy">
            <p class="cta-title" id="author-cta-title">
              Accounting made <span>simple.</span>
            </p>
            <p class="cta-text">
              Try Acomptic, the offline GST accounting software built for
              small businesses in India.
            </p>
          </div>
          <a class="pill-button" href="https://acomptic.com/">
            <span>Try Acomptic</span>
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M5 12h14M12 5l7 7-7 7" />
            </svg>
          </a>
        </div>
      </section>

    </div>
  </main>
</Layout>

<script>
  const list = document.getElementById("articles-list");

  if (list) {
    const PAGE = Number(list.dataset.pageSize) || 10;

    const input = document.getElementById("author-search-input") as HTMLInputElement | null;
    const clearBtn = document.getElementById("search-clear") as HTMLButtonElement | null;
    const kbd = document.getElementById("search-kbd");
    const chipsWrap = document.getElementById("category-chips");
    const statusEl = document.getElementById("results-status");
    const noResults = document.getElementById("no-results");
    const noResultsClear = document.getElementById("no-results-clear");
    const loadMoreWrap = document.getElementById("load-more-wrap");
    const loadMoreBtn = document.getElementById("load-more") as HTMLButtonElement | null;

    // custom sort dropdown
    const dropdown = document.getElementById("sort-dropdown");
    const sortTrigger = document.getElementById("sort-trigger") as HTMLButtonElement | null;
    const sortMenu = document.getElementById("sort-menu") as HTMLElement | null;
    const sortCurrent = document.getElementById("sort-current");
    const sortOptionEls = sortMenu
      ? Array.from(sortMenu.querySelectorAll<HTMLElement>(".dropdown-option"))
      : [];

    // ---------- text helpers ----------
    const norm = (s: string) =>
      s
        .toLowerCase()
        .normalize("NFD")
        .replace(/[\u0300-\u036f]/g, "")
        .replace(/[^\p{L}\p{N}\s]/gu, " ")
        .replace(/\s+/g, " ")
        .trim();

    const escapeRe = (s: string) => s.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");

    // Edit distance check (small max, early exit)
    function within(a: string, b: string, max: number) {
      if (Math.abs(a.length - b.length) > max) return false;
      let prev = Array.from({ length: b.length + 1 }, (_, i) => i);
      for (let i = 1; i <= a.length; i++) {
        const curr = [i];
        let rowMin = i;
        for (let j = 1; j <= b.length; j++) {
          const cost = a[i - 1] === b[j - 1] ? 0 : 1;
          const v = Math.min(prev[j] + 1, curr[j - 1] + 1, prev[j - 1] + cost);
          curr[j] = v;
          if (v < rowMin) rowMin = v;
        }
        if (rowMin > max) return false;
        prev = curr;
      }
      return prev[b.length] <= max;
    }

    // ---------- index built from the rendered rows ----------
    const records = Array.from(list.querySelectorAll<HTMLElement>(".article-row")).map((el, i) => {
      const titleEl = el.querySelector("h3") as HTMLElement;
      const excerptEl = el.querySelector(".row-copy p") as HTMLElement;
      const title = titleEl?.textContent ?? "";
      const excerpt = excerptEl?.textContent ?? "";
      const category = el.dataset.category ?? "";
      const nTitle = norm(title);
      const nExcerpt = norm(excerpt);
      return {
        el,
        i,
        titleEl,
        excerptEl,
        title,
        excerpt,
        category,
        date: el.dataset.date ?? "",
        read: Number(el.dataset.read) || 0,
        nTitle,
        nExcerpt,
        nCat: norm(category),
        wTitle: nTitle.split(" ").filter(Boolean),
        wExcerpt: nExcerpt.split(" ").filter(Boolean),
      };
    });

    type Rec = (typeof records)[number];

    // ---------- query parsing ----------
    function parseQuery(raw: string) {
      const phrases: string[] = [];
      const excluded: string[] = [];
      const terms: string[] = [];

      const rest = raw.replace(/(-?)"([^"]+)"/g, (_m, neg: string, p: string) => {
        const n = norm(p);
        if (n) (neg ? excluded : phrases).push(n);
        return " ";
      });

      rest.split(/\s+/).forEach((tok) => {
        if (!tok) return;
        if (tok.startsWith("-") && tok.length > 1) {
          const n = norm(tok.slice(1));
          if (n) excluded.push(n);
        } else {
          norm(tok)
            .split(" ")
            .forEach((w) => w && terms.push(w));
        }
      });

      return { phrases, excluded, terms };
    }

    function scoreTerm(r: Rec, t: string) {
      let s = 0;
      if (r.wTitle.includes(t)) s += 12;
      else if (r.wTitle.some((w) => w.startsWith(t))) s += 9;
      else if (r.nTitle.includes(t)) s += 6;

      if (r.nCat.includes(t)) s += 5;

      if (r.wExcerpt.includes(t)) s += 4;
      else if (r.wExcerpt.some((w) => w.startsWith(t))) s += 3;
      else if (r.nExcerpt.includes(t)) s += 1.5;

      // typo tolerance
      if (s === 0 && t.length >= 4) {
        const max = t.length >= 8 ? 2 : 1;
        if (r.wTitle.some((w) => within(w, t, max))) s += 4;
        else if (r.wExcerpt.some((w) => within(w, t, max))) s += 2;
      }
      return s;
    }

    function scoreRecord(r: Rec, q: ReturnType<typeof parseQuery>): number | null {
      for (const ex of q.excluded) {
        if (r.nTitle.includes(ex) || r.nExcerpt.includes(ex) || r.nCat.includes(ex)) return null;
      }

      let total = 0;

      for (const p of q.phrases) {
        if (r.nTitle.includes(p)) total += 15;
        else if (r.nExcerpt.includes(p)) total += 8;
        else if (r.nCat.includes(p)) total += 6;
        else return null;
      }

      for (const t of q.terms) {
        const s = scoreTerm(r, t);
        if (s === 0) return null; // every word must match somewhere
        total += s;
      }

      return total;
    }

    // ---------- highlighting ----------
    function highlight(el: HTMLElement, text: string, re: RegExp | null) {
      el.textContent = "";
      if (!re) {
        el.textContent = text;
        return;
      }
      let last = 0;
      for (const m of text.matchAll(re)) {
        const idx = m.index ?? 0;
        if (idx > last) el.append(text.slice(last, idx));
        const mark = document.createElement("mark");
        mark.textContent = m[0];
        el.append(mark);
        last = idx + m[0].length;
      }
      if (last < text.length) el.append(text.slice(last));
    }

    // ---------- state ----------
    let query = "";
    let activeCat = "all";
    let sortValue = "newest";
    let userSorted = false;
    let shown = PAGE;
    let debounceTimer: number | undefined;

    const SORT_MODES = ["relevance", "newest", "oldest", "shortest", "longest"];

    const params = new URLSearchParams(location.search);
    query = params.get("q") ?? "";
    activeCat = (params.get("cat") ?? "all").toLowerCase();
    if (!records.some((r) => r.category === activeCat)) activeCat = "all";
    const urlSort = params.get("sort");
    if (urlSort && SORT_MODES.includes(urlSort)) {
      sortValue = urlSort;
      userSorted = true;
    }
    if (input) input.value = query;

    function syncUrl() {
      const p = new URLSearchParams();
      if (query.trim()) p.set("q", query.trim());
      if (activeCat !== "all") p.set("cat", activeCat);
      if (userSorted) p.set("sort", sortValue);
      const qs = p.toString();
      history.replaceState(null, "", location.pathname + (qs ? `?${qs}` : ""));
    }

    function sortResults(items: { r: Rec; score: number }[], mode: string) {
      const byDateDesc = (a: Rec, b: Rec) => (a.date < b.date ? 1 : a.date > b.date ? -1 : a.i - b.i);
      items.sort((x, y) => {
        switch (mode) {
          case "relevance":
            return y.score - x.score || byDateDesc(x.r, y.r);
          case "oldest":
            return -byDateDesc(x.r, y.r);
          case "shortest":
            return x.r.read - y.r.read || byDateDesc(x.r, y.r);
          case "longest":
            return y.r.read - x.r.read || byDateDesc(x.r, y.r);
          default:
            return byDateDesc(x.r, y.r);
        }
      });
    }

    // ---------- custom dropdown ----------
    function updateSortUI(mode: string, hasQuery: boolean) {
      sortOptionEls.forEach((opt) => {
        const val = opt.dataset.value;
        const selected = val === mode;
        opt.setAttribute("aria-selected", String(selected));
        opt.classList.toggle("is-selected", selected);

        if (val === "relevance") {
          opt.setAttribute("aria-disabled", String(!hasQuery));
          opt.classList.toggle("is-disabled", !hasQuery);
        }
        if (selected && sortCurrent) {
          sortCurrent.textContent = opt.querySelector("span")?.textContent ?? "";
        }
      });
    }

    const enabledOptions = () => sortOptionEls.filter((o) => o.getAttribute("aria-disabled") !== "true");

    function openMenu() {
      if (!sortMenu || !sortTrigger) return;
      sortMenu.hidden = false;
      sortTrigger.setAttribute("aria-expanded", "true");
      dropdown?.classList.add("is-open");
      const target = sortOptionEls.find((o) => o.getAttribute("aria-selected") === "true") ?? enabledOptions()[0];
      target?.focus();
    }

    function closeMenu(returnFocus = false) {
      if (!sortMenu || !sortTrigger) return;
      sortMenu.hidden = true;
      sortTrigger.setAttribute("aria-expanded", "false");
      dropdown?.classList.remove("is-open");
      if (returnFocus) sortTrigger.focus();
    }

    function chooseOption(opt: HTMLElement) {
      if (opt.getAttribute("aria-disabled") === "true") return;
      sortValue = opt.dataset.value ?? "newest";
      userSorted = true;
      shown = PAGE;
      syncUrl();
      render();
      closeMenu(true);
    }

    sortTrigger?.addEventListener("click", () => {
      if (sortMenu?.hidden) openMenu();
      else closeMenu();
    });

    sortTrigger?.addEventListener("keydown", (e) => {
      if (e.key === "ArrowDown" || e.key === "ArrowUp") {
        e.preventDefault();
        openMenu();
      }
    });

    sortMenu?.addEventListener("click", (e) => {
      const opt = (e.target as HTMLElement).closest<HTMLElement>(".dropdown-option");
      if (opt) chooseOption(opt);
    });

    sortMenu?.addEventListener("keydown", (e) => {
      const opts = enabledOptions();
      const idx = opts.indexOf(document.activeElement as HTMLElement);

      if (e.key === "ArrowDown") {
        e.preventDefault();
        opts[(idx + 1) % opts.length]?.focus();
      } else if (e.key === "ArrowUp") {
        e.preventDefault();
        opts[(idx - 1 + opts.length) % opts.length]?.focus();
      } else if (e.key === "Home") {
        e.preventDefault();
        opts[0]?.focus();
      } else if (e.key === "End") {
        e.preventDefault();
        opts[opts.length - 1]?.focus();
      } else if (e.key === "Enter" || e.key === " ") {
        e.preventDefault();
        const opt = document.activeElement as HTMLElement;
        if (opt?.classList.contains("dropdown-option")) chooseOption(opt);
      } else if (e.key === "Escape") {
        e.preventDefault();
        closeMenu(true);
      } else if (e.key === "Tab") {
        closeMenu();
      }
    });

    document.addEventListener("click", (e) => {
      if (dropdown && !dropdown.contains(e.target as Node)) closeMenu();
    });

    // ---------- render ----------
    function render() {
      const q = parseQuery(query);
      const hasQuery = q.phrases.length + q.terms.length + q.excluded.length > 0;
      const filtered = hasQuery || activeCat !== "all";

      let mode = userSorted ? sortValue : hasQuery ? "relevance" : "newest";
      if (mode === "relevance" && !hasQuery) mode = "newest";
      updateSortUI(mode, hasQuery);

      // match
      const matched: { r: Rec; score: number }[] = [];
      for (const r of records) {
        if (activeCat !== "all" && r.category !== activeCat) continue;
        if (!hasQuery) {
          matched.push({ r, score: 0 });
          continue;
        }
        const s = scoreRecord(r, q);
        if (s !== null) matched.push({ r, score: s });
      }

      sortResults(matched, mode);

      // highlight regex
      const hlTerms = [...q.phrases, ...q.terms].filter(Boolean).sort((a, b) => b.length - a.length);
      const re = hlTerms.length ? new RegExp(`(${hlTerms.map(escapeRe).join("|")})`, "gi") : null;

      const matchedSet = new Set(matched.map((m) => m.r));
      const frag = document.createDocumentFragment();

      matched.forEach(({ r }, idx) => {
        highlight(r.titleEl, r.title, re);
        highlight(r.excerptEl, r.excerpt, re);
        r.el.hidden = idx >= shown;
        frag.appendChild(r.el);
      });

      records.forEach((r) => {
        if (!matchedSet.has(r)) {
          r.el.hidden = true;
          frag.appendChild(r.el);
        }
      });

      list.appendChild(frag);

      // status + controls
      const total = matched.length;
      const visible = Math.min(shown, total);

      if (statusEl) {
        if (total === 0) {
          statusEl.textContent = "";
        } else if (filtered) {
          statusEl.textContent =
            `${total} ${total === 1 ? "article" : "articles"} found` +
            (total > visible ? ` · showing ${visible}` : "");
        } else {
          statusEl.textContent = `Showing ${visible} of ${total} articles`;
        }
      }

      list.hidden = total === 0;
      if (noResults) noResults.hidden = total !== 0;

      if (loadMoreWrap && loadMoreBtn) {
        const remaining = total - visible;
        loadMoreWrap.hidden = remaining <= 0;
        loadMoreBtn.textContent = `Load more (${remaining} remaining)`;
      }

      if (clearBtn) clearBtn.hidden = !query;
      if (kbd) kbd.hidden = !!query;

      chipsWrap?.querySelectorAll<HTMLButtonElement>(".chip").forEach((chip) => {
        const on = chip.dataset.cat === activeCat;
        chip.classList.toggle("is-active", on);
        chip.setAttribute("aria-pressed", String(on));
      });
    }

    function resetAll() {
      query = "";
      activeCat = "all";
      userSorted = false;
      sortValue = "newest";
      shown = PAGE;
      if (input) input.value = "";
      syncUrl();
      render();
    }

    // ---------- events ----------
    input?.addEventListener("input", () => {
      window.clearTimeout(debounceTimer);
      debounceTimer = window.setTimeout(() => {
        query = input.value;
        shown = PAGE;
        syncUrl();
        render();
      }, 100);
    });

    input?.addEventListener("keydown", (e) => {
      if (e.key === "Escape") {
        if (input.value) {
          input.value = "";
          query = "";
          shown = PAGE;
          syncUrl();
          render();
        } else {
          input.blur();
        }
      }
    });

    clearBtn?.addEventListener("click", () => {
      if (input) input.value = "";
      query = "";
      shown = PAGE;
      syncUrl();
      render();
      input?.focus();
    });

    chipsWrap?.addEventListener("click", (e) => {
      const chip = (e.target as HTMLElement).closest<HTMLButtonElement>(".chip");
      if (!chip) return;
      activeCat = chip.dataset.cat ?? "all";
      shown = PAGE;
      syncUrl();
      render();
    });

    noResultsClear?.addEventListener("click", resetAll);

    loadMoreBtn?.addEventListener("click", () => {
      shown += PAGE;
      render();
    });

    // Press "/" to jump to the search box
    document.addEventListener("keydown", (e) => {
      if (e.key !== "/" || e.ctrlKey || e.metaKey || e.altKey) return;
      const t = e.target as HTMLElement | null;
      if (t && (t.tagName === "INPUT" || t.tagName === "TEXTAREA" || t.tagName === "SELECT" || t.isContentEditable)) return;
      e.preventDefault();
      input?.focus();
    });

    render();
  }
</script>

