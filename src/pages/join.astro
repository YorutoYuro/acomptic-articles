---
import Layout from "../layouts/Layout.astro";

const siteURL = "https://acomptic.com";

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${siteURL}/write-for-us/#webpage`,
    url: `${siteURL}/write-for-us/`,
    name: "Join Us - Write for Acomptic",
    inLanguage: "en-IN",
    isPartOf: { "@id": `${siteURL}/#website` },
    about: { "@id": `${siteURL}/#organization` },
  },
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "@id": `${siteURL}/#organization`,
    name: "Acomptic",
    url: `${siteURL}/`,
    address: {
      "@type": "PostalAddress",
      addressLocality: "Narnaul",
      addressRegion: "Haryana",
      addressCountry: "IN",
    },
  },
];
---

<Layout
  title="Join Us & Write for Acomptic - Share Your Expertise"
  description="Contribute articles on GST, Income Tax, Business Management, and Finance to Acomptic Articles. Join our community of expert writers."
  schema={schema}
>
  <div class="contact-page">
    <section class="contact-shell" aria-labelledby="contact-title">
      <div class="contact-container contact-layout">
        <div class="contact-intro">
          <h1 id="contact-title">Join <span>Us.</span></h1>
          <p class="contact-hero-description">
            Share your expertise with micro and small business owners across India. Pitch your article ideas across tax, compliance, and business growth.
          </p>
        </div>

        <div class="contact-panel">
          <div class="flip">
            <div class="flip-inner">
              <section
                class="flip-face flip-face--front contact-form-card"
                id="face-form"
                role="region"
                aria-label="Contributor pitch form"
              >
                <form id="contact-form">
                  <input
                    type="hidden"
                    name="access_key"
                    value="7303ae65-8654-4786-bcaf-0db3600681f7"
                  />

                  <input
                    type="hidden"
                    name="subject"
                    value="New Contributor Pitch - Acomptic Articles"
                  />

                  <input
                    type="hidden"
                    name="from_name"
                    value="Acomptic Join Us Form"
                  />

                  <input
                    type="checkbox"
                    name="botcheck"
                    class="contact-honeypot"
                    tabindex="-1"
                    autocomplete="off"
                    aria-hidden="true"
                  />

                  <div class="form-grid">
                    <div class="form-field">
                      <label for="contact-name">Your name</label>
                      <input
                        id="contact-name"
                        name="name"
                        type="text"
                        placeholder="Enter your name"
                        autocomplete="name"
                        maxlength="50"
                        required
                      />
                    </div>

                    <div class="form-field">
                      <label for="contact-email">Email address</label>
                      <input
                        id="contact-email"
                        name="email"
                        type="email"
                        placeholder="you@example.com"
                        autocomplete="email"
                        maxlength="254"
                        required
                      />
                    </div>

                    <div class="form-field">
                      <label for="contact-phone">
                        Phone number <span class="optional">(optional)</span>
                      </label>
                      <input
                        id="contact-phone"
                        name="phone"
                        type="tel"
                        placeholder="Enter your phone number"
                        autocomplete="tel"
                        inputmode="numeric"
                        maxlength="10"
                        pattern="[0-9]{10}"
                      />
                    </div>

                    <div class="form-field">
                      <label id="enquiry-label" for="enquiry-trigger">
                        Article category <span aria-hidden="true">*</span>
                      </label>

                      <input
                        type="hidden"
                        id="contact-subject"
                        name="Article category"
                        value=""
                      />

                      <div class="custom-select" id="enquiry-select">
                        <button
                          type="button"
                          class="custom-select-trigger"
                          id="enquiry-trigger"
                          aria-labelledby="enquiry-label enquiry-value"
                          aria-haspopup="listbox"
                          aria-expanded="false"
                          aria-controls="enquiry-options"
                        >
                          <span id="enquiry-value" class="custom-select-value">
                            Select a category
                          </span>

                          <svg
                            class="custom-select-chevron"
                            viewBox="0 0 24 24"
                            aria-hidden="true"
                          >
                            <path d="m7 10 5 5 5-5" />
                          </svg>
                        </button>

                        <div
                          class="custom-select-menu"
                          id="enquiry-options"
                          role="listbox"
                          aria-labelledby="enquiry-label"
                        >
                          <button
                            type="button"
                            class="custom-select-option"
                            role="option"
                            aria-selected="false"
                            data-value="GST"
                          >
                            <span>GST</span>
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                              <path d="m5 12 4 4L19 6" />
                            </svg>
                          </button>

                          <button
                            type="button"
                            class="custom-select-option"
                            role="option"
                            aria-selected="false"
                            data-value="Income Tax"
                          >
                            <span>Income Tax</span>
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                              <path d="m5 12 4 4L19 6" />
                            </svg>
                          </button>

                          <button
                            type="button"
                            class="custom-select-option"
                            role="option"
                            aria-selected="false"
                            data-value="Business Management"
                          >
                            <span>Business Management</span>
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                              <path d="m5 12 4 4L19 6" />
                            </svg>
                          </button>

                          <button
                            type="button"
                            class="custom-select-option"
                            role="option"
                            aria-selected="false"
                            data-value="Finance"
                          >
                            <span>Finance</span>
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                              <path d="m5 12 4 4L19 6" />
                            </svg>
                          </button>

                          <button
                            type="button"
                            class="custom-select-option"
                            role="option"
                            aria-selected="false"
                            data-value="Other"
                          >
                            <span>Other</span>
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                              <path d="m5 12 4 4L19 6" />
                            </svg>
                          </button>
                        </div>
                      </div>
                    </div>

                    <div class="form-field form-field-full message-field">
                      <label for="contact-message">Your message / pitch</label>
                      <textarea
                        id="contact-message"
                        name="message"
                        placeholder="Tell us about your proposed topic, writing background, or pitch summary..."
                        minlength="10"
                        maxlength="5000"
                        required
                      ></textarea>
                      <span class="field-counter" id="message-counter" aria-hidden="true">
                        0 / 5000
                      </span>
                    </div>
                  </div>

                  <label class="form-consent" for="contact-consent">
                    <input
                      id="contact-consent"
                      name="privacy_consent"
                      type="checkbox"
                      required
                    />
                    <span>
                      I have read and agree to the
                      <a href="https://acomptic.com/privacy" target="_blank" rel="noopener"> Privacy Policy</a> & <a href="https://acomptic.com/terms" target="_blank" rel="noopener">Terms & Conditions</a>.
                      I confirm that the content I pitch or submit will be original.
                    </span>
                  </label>

                  <div class="form-submit-row">
                    <button
                      id="contact-submit"
                      class="contact-send-button btn-custom btn-login-style btn-icon-arrow"
                      type="submit"
                    >
                      <span id="submit-label">Send Pitch</span>

                      <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M5 12h14M12 5l7 7-7 7" />
                      </svg>
                    </button>
                  </div>

                  <p
                    id="form-status"
                    class="form-status"
                    role="status"
                    aria-live="polite"
                    hidden
                  ></p>
                </form>
              </section>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
</Layout>

<script>
  const form = document.querySelector<HTMLFormElement>("#contact-form");
  const submitButton =
    document.querySelector<HTMLButtonElement>("#contact-submit");
  const submitLabel =
    document.querySelector<HTMLSpanElement>("#submit-label");
  const statusMessage =
    document.querySelector<HTMLParagraphElement>("#form-status");

  const nameInput =
    document.querySelector<HTMLInputElement>("#contact-name");
  const emailInput =
    document.querySelector<HTMLInputElement>("#contact-email");
  const phoneInput =
    document.querySelector<HTMLInputElement>("#contact-phone");
  const messageInput =
    document.querySelector<HTMLTextAreaElement>("#contact-message");

  const enquiryRoot =
    document.querySelector<HTMLDivElement>("#enquiry-select");
  const enquiryTrigger =
    document.querySelector<HTMLButtonElement>("#enquiry-trigger");
  const enquiryMenu =
    document.querySelector<HTMLDivElement>("#enquiry-options");
  const enquiryValue =
    document.querySelector<HTMLSpanElement>("#enquiry-value");
  const enquiryInput =
    document.querySelector<HTMLInputElement>("#contact-subject");

  function getOptions(): HTMLButtonElement[] {
    return Array.from(
      enquiryMenu?.querySelectorAll<HTMLButtonElement>(
        ".custom-select-option",
      ) ?? [],
    );
  }

  function setMenuOpen(open: boolean): void {
    if (!enquiryRoot || !enquiryTrigger) return;

    enquiryRoot.classList.toggle("is-open", open);
    enquiryTrigger.setAttribute("aria-expanded", String(open));
  }

  function focusOption(index: number): void {
    const options = getOptions();
    if (!options.length) return;

    const safeIndex = Math.max(0, Math.min(index, options.length - 1));
    options[safeIndex]?.focus();
  }

  function selectOption(option: HTMLButtonElement): void {
    if (!enquiryValue || !enquiryInput || !enquiryTrigger) return;

    const value = option.dataset.value;
    if (!value) return;

    enquiryInput.value = value;
    enquiryValue.textContent =
      option.querySelector("span")?.textContent?.trim() ?? value;

    enquiryValue.classList.add("has-value");

    for (const item of getOptions()) {
      const selected = item === option;
      item.setAttribute("aria-selected", String(selected));
      item.classList.toggle("is-selected", selected);
    }

    setMenuOpen(false);
    enquiryTrigger.focus();
  }

  if (enquiryRoot && enquiryTrigger && enquiryMenu && enquiryInput) {
    setMenuOpen(false);

    enquiryTrigger.addEventListener("click", () => {
      const isOpen =
        enquiryTrigger.getAttribute("aria-expanded") === "true";

      setMenuOpen(!isOpen);
    });

    enquiryTrigger.addEventListener(
      "keydown",
      (event: KeyboardEvent) => {
        const isOpen =
          enquiryTrigger.getAttribute("aria-expanded") === "true";
        const options = getOptions();

        if (!options.length) return;

        if (
          ["ArrowDown", "ArrowUp", "Enter", " "].includes(event.key)
        ) {
          event.preventDefault();

          if (!isOpen) setMenuOpen(true);

          const selectedIndex = options.findIndex(
            (option) => option.dataset.value === enquiryInput.value,
          );

          if (event.key === "ArrowUp") {
            focusOption(
              selectedIndex >= 0 ? selectedIndex : options.length - 1,
            );
          } else {
            focusOption(selectedIndex >= 0 ? selectedIndex : 0);
          }
        }

        if (event.key === "Escape" && isOpen) {
          event.preventDefault();
          setMenuOpen(false);
        }
      },
    );

    for (const option of getOptions()) {
      option.addEventListener("click", () => selectOption(option));

      option.addEventListener(
        "keydown",
        (event: KeyboardEvent) => {
          const options = getOptions();
          const index = options.indexOf(option);

          switch (event.key) {
            case "ArrowDown":
              event.preventDefault();
              focusOption((index + 1) % options.length);
              break;

            case "ArrowUp":
              event.preventDefault();
              focusOption((index - 1 + options.length) % options.length);
              break;

            case "Home":
              event.preventDefault();
              focusOption(0);
              break;

            case "End":
              event.preventDefault();
              focusOption(options.length - 1);
              break;

            case "Escape":
              event.preventDefault();
              setMenuOpen(false);
              enquiryTrigger?.focus();
              break;

            case "Tab":
              setMenuOpen(false);
              break;
          }
        },
      );
    }

    document.addEventListener("click", (event: MouseEvent) => {
      const target = event.target;

      if (target instanceof Node && !enquiryRoot.contains(target)) {
        setMenuOpen(false);
      }
    });
  }

  nameInput?.addEventListener("input", () => {
    if (nameInput.value.length > 50) {
      nameInput.value = nameInput.value.slice(0, 50);
    }
  });

  phoneInput?.addEventListener("input", () => {
    phoneInput.value = phoneInput.value.replace(/\D/g, "").slice(0, 10);
  });

  const messageCounter =
    document.querySelector<HTMLSpanElement>("#message-counter");

  const updateCounter = () => {
    if (messageInput && messageCounter) {
      messageCounter.textContent = `${messageInput.value.length} / 5000`;
    }
  };

  messageInput?.addEventListener("input", updateCounter);

  emailInput?.addEventListener("input", () => {
    emailInput.setCustomValidity("");
  });

  form?.addEventListener("submit", async (event: SubmitEvent) => {
    event.preventDefault();

    if (!form || !submitButton || !submitLabel || !statusMessage) return;

    statusMessage.hidden = true;
    statusMessage.textContent = "";
    statusMessage.className = "form-status";

    const accessKeyInput =
      form.querySelector<HTMLInputElement>('input[name="access_key"]');

    const accessKey = accessKeyInput?.value.trim() ?? "";

    if (!accessKey || accessKey === "YOUR_WEB3FORMS_ACCESS_KEY") {
      statusMessage.textContent =
        "The form is not configured yet. Please email support@acomptic.com directly.";
      statusMessage.classList.add("form-status-error");
      statusMessage.hidden = false;
      return;
    }

    if (!enquiryInput?.value.trim()) {
      statusMessage.textContent = "Please select an article category.";
      statusMessage.classList.add("form-status-error");
      statusMessage.hidden = false;
      setMenuOpen(true);
      enquiryTrigger?.focus();
      return;
    }

    const consentInput =
      document.querySelector<HTMLInputElement>("#contact-consent");

    if (consentInput && !consentInput.checked) {
      statusMessage.textContent =
        "Please confirm your agreement to the Privacy Policy.";
      statusMessage.classList.add("form-status-error");
      statusMessage.hidden = false;
      consentInput.focus();
      return;
    }

    if (!form.reportValidity()) return;

    if (nameInput && nameInput.value.length > 50) {
      nameInput.value = nameInput.value.slice(0, 50);
    }

    if (phoneInput?.value && !/^[0-9]{10}$/.test(phoneInput.value)) {
      statusMessage.textContent =
        "Please check the phone number and try again.";
      statusMessage.classList.add("form-status-error");
      statusMessage.hidden = false;
      phoneInput.focus();
      return;
    }

    if (
      emailInput &&
      !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(emailInput.value)
    ) {
      statusMessage.textContent =
        "Please enter a valid email address.";
      statusMessage.classList.add("form-status-error");
      statusMessage.hidden = false;
      emailInput.focus();
      return;
    }

    if (messageInput && messageInput.value.trim().length < 10) {
      statusMessage.textContent =
        "Please provide a little more detail in your pitch.";
      statusMessage.classList.add("form-status-error");
      statusMessage.hidden = false;
      messageInput.focus();
      return;
    }

    submitButton.disabled = true;
    submitLabel.textContent = "Sending...";

    try {
      const formData = new FormData(form);

      formData.set("access_key", accessKey);
      formData.set(
        "subject",
        `New Contributor Pitch [${enquiryInput.value}] - Acomptic`,
      );

      const response = await fetch(
        "https://api.web3forms.com/submit",
        {
          method: "POST",
          body: formData,
          headers: {
            Accept: "application/json",
          },
        },
      );

      const result: {
        success?: boolean;
        message?: string;
      } = await response.json();

      if (!response.ok || !result.success) {
        throw new Error(result.message || "Submission failed.");
      }

      statusMessage.textContent =
        "Thank you for your pitch! We have received your application and will get back to you soon.";
      statusMessage.classList.add("form-status-success");
      statusMessage.hidden = false;
      statusMessage.setAttribute("tabindex", "-1");
      statusMessage.focus({ preventScroll: true });
      statusMessage.scrollIntoView({ behavior: "smooth", block: "nearest" });

      form.reset();
      updateCounter();

      if (enquiryValue && enquiryInput) {
        enquiryValue.textContent = "Select a category";
        enquiryValue.classList.remove("has-value");
        enquiryInput.value = "";

        for (const option of getOptions()) {
          option.setAttribute("aria-selected", "false");
          option.classList.remove("is-selected");
        }
      }

      setMenuOpen(false);
    } catch (error) {
      console.error("Form submission failed:", error);

      statusMessage.textContent =
        "We couldn't send your message. Please try again or email support@acomptic.com directly.";
      statusMessage.classList.add("form-status-error");
      statusMessage.hidden = false;
    } finally {
      submitButton.disabled = false;
      submitLabel.textContent = "Send Pitch";
    }
  });
</script>

<style>
  .contact-page {
    --contact-type-base: 16px;
    --contact-type-2xs: max(11px, calc(var(--contact-type-base) / 1.618));
    --contact-type-xs: max(12px, calc(var(--contact-type-base) / 1.272));
    --contact-type-sm: var(--contact-type-base);
    --contact-type-md: calc(var(--contact-type-base) * 1.272);
    --contact-type-lg: calc(var(--contact-type-base) * 1.618);
    --contact-type-xl: calc(var(--contact-type-base) * 2.058);
    --contact-type-2xl: calc(var(--contact-type-base) * 2.618);
    --contact-type-3xl: calc(var(--contact-type-base) * 3.33);

    --contact-control: clamp(38px, 5.4vh, 44px);
    --contact-gap: clamp(8px, 1.6vh, 14px);

    --contact-primary: var(--color-primary, #a799ff);
    --contact-primary-hover: var(--color-primary-hover, #8875ee);
    --contact-purple-light: var(--color-lavender-light, #edeaff);
    --contact-purple-border: var(--color-lavender-soft, #dbd6ff);
    --contact-muted: var(--color-purple-muted, #625a7a);
    --contact-ink: var(--color-text, #121212);
    --contact-border: var(--color-border, #e9e7ef);
    --contact-surface: var(--color-white, #ffffff);

    background: var(--contact-surface);
    color: var(--contact-ink);
    font-family: var(--font-primary, inherit);
    line-height: 1.6;
    overflow-wrap: anywhere;
  }

  .contact-page *,
  .contact-page *::before,
  .contact-page *::after {
    box-sizing: border-box;
  }

  .contact-page svg {
    display: block;
    width: 100%;
    height: 100%;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .contact-container {
    width: min(1160px, calc(100% - 48px));
    margin-inline: auto;
  }

  .contact-shell {
    position: relative;
    isolation: isolate;
    padding: clamp(24px, 5vh, 56px) 0 clamp(40px, 7vh, 80px);
  }

  .contact-shell::before {
    position: absolute;
    z-index: -1;
    top: -100px;
    right: 0;
    left: 0;
    height: calc(100% + 100px);
    background:
      radial-gradient(circle at 85% 20%, rgb(118 84 214 / 12%), transparent 32%),
      linear-gradient(135deg, #faf9ff 0%, #ffffff 55%, #f4f0ff 100%);
    content: "";
    pointer-events: none;
  }

  .contact-layout {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    grid-template-rows: minmax(0, 1fr);
    align-items: center;
    gap: clamp(24px, 5vw, 72px);
    height: 100%;
  }

  .contact-intro h1 {
    margin: 0;
    font-size: var(--contact-type-3xl);
    font-weight: 700;
    letter-spacing: -0.05em;
    line-height: 1.1;
    white-space: nowrap;
  }

  .contact-intro h1 span {
    color: var(--contact-primary);
  }

  .contact-hero-description {
    max-width: 420px;
    margin: clamp(12px, 2vh, 20px) 0 0;
    color: var(--contact-muted);
    font-size: var(--contact-type-md);
    line-height: 1.7;
  }

  .contact-panel {
    display: flex;
    min-width: 0;
    min-height: 0;
    flex-direction: column;
    gap: clamp(8px, 1.6vh, 14px);
  }

  .flip {
    min-height: 0;
    flex: 1 1 auto;
  }

  .flip-inner {
    display: grid;
    height: 100%;
    grid-template-rows: minmax(0, 1fr);
  }

  .flip-face {
    grid-area: 1 / 1;
    min-width: 0;
    min-height: 0;
    padding: clamp(16px, 2.6vh, 28px) clamp(18px, 2.4vw, 28px);
    border: 1px solid var(--contact-border);
    border-radius: 15px;
    background: var(--contact-surface);
    box-shadow: 0 10px 32px rgb(18 18 18 / 4%);
  }

  .flip-face--front {
    position: relative;
    display: flex;
    flex-direction: column;
  }

  #contact-form {
    display: flex;
    min-height: 0;
    flex: 1 1 auto;
    flex-direction: column;
  }

  .form-grid {
    display: grid;
    min-height: 0;
    flex: 1 1 auto;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-template-rows: auto auto minmax(0, 1fr);
    gap: var(--contact-gap) 14px;
  }

  .form-field {
    display: flex;
    min-width: 0;
    min-height: 0;
    flex-direction: column;
    gap: 5px;
  }

  .form-field-full {
    grid-column: 1 / -1;
  }

  .form-field label {
    color: var(--contact-ink);
    font-size: var(--contact-type-xs);
    font-weight: 500;
    line-height: 1.5;
  }

  .optional {
    color: var(--contact-muted);
    font-size: var(--contact-type-2xs);
    font-weight: 400;
  }

  .form-field input:not([type="hidden"]),
  .form-field textarea {
    display: block;
    width: 100%;
    min-width: 0;
    margin: 0;
    padding: 8px 12px;
    border: 1px solid var(--contact-border);
    border-radius: 9px;
    outline: none;
    background: var(--contact-surface);
    color: var(--contact-ink);
    font: inherit;
    font-size: 16px;
    line-height: 1.5;
    transition:
      border-color 180ms ease,
      box-shadow 180ms ease;
  }

  .form-field input:not([type="hidden"]) {
    min-height: var(--contact-control);
  }

  .form-field textarea {
    min-height: 120px;
    flex: 1 1 140px;
    resize: vertical;
  }

  .form-field input::placeholder,
  .form-field textarea::placeholder {
    color: #7f7896;
    opacity: 1;
  }

  .form-field input:focus,
  .form-field textarea:focus {
    border-color: var(--contact-primary);
    box-shadow: 0 0 0 3px rgb(118 84 214 / 12%);
  }

  .field-counter {
    align-self: flex-end;
    color: var(--contact-muted);
    font-size: var(--contact-type-2xs);
    font-variant-numeric: tabular-nums;
    line-height: 1.3;
  }

  .contact-honeypot {
    position: absolute !important;
    width: 1px !important;
    height: 1px !important;
    overflow: hidden !important;
    clip: rect(0, 0, 0, 0) !important;
    white-space: nowrap !important;
  }

  .custom-select {
    position: relative;
    z-index: 2;
    width: 100%;
    min-width: 0;
  }

  .custom-select.is-open {
    z-index: 1000;
  }

  .custom-select-trigger {
    display: flex;
    width: 100%;
    min-height: var(--contact-control);
    align-items: center;
