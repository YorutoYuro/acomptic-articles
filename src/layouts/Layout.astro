
---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
  canonicalURL?: string;
  noindex?: boolean;

  ogImage?: string;
  ogImageAlt?: string;
  ogType?: "website" | "article";

  author?: string;
  publishedTime?: string;
  modifiedTime?: string;

  schema?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title = "Acomptic Articles | GST, Income Tax and Accounting Guides",

  description = "Explore practical GST guides, income tax updates, accounting insights and business compliance resources from Acomptic.",

  canonicalURL,
  noindex = false,

  ogImage = "/og-image.png",
  ogImageAlt = "Acomptic Articles - GST, taxation and accounting insights",
  ogType = "website",

  author = "Acomptic",
  publishedTime,
  modifiedTime,

  schema,
} = Astro.props;

const siteName = "Acomptic Articles";

const siteURL =
  Astro.site ?? new URL("https://articles.acomptic.com");

// Generate a clean canonical URL.
const canonical = new URL(
  canonicalURL ?? Astro.url.pathname,
  siteURL
);

canonical.search = "";
canonical.hash = "";

// Resolve social image URL.
const socialImage = new URL(ogImage, siteURL);

// Robots instructions.
const robots = noindex
  ? "noindex, nofollow"
  : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1";

// Allow one or multiple JSON-LD objects.
const schemaItems = schema
  ? Array.isArray(schema)
    ? schema
    : [schema]
  : [];
---

<!doctype html>
<html lang="en-IN">
  <head>
    <!-- Google Tag Manager -->
    <script async src="https://www.googletagmanager.com/gtm.js?id=GTM-PW4HJ4HT"></script>

    <script>
      window.dataLayer = window.dataLayer || [];

      function gtag() {
        window.dataLayer.push(arguments);
      }

      gtag('js', new Date());
    </script>

    <!-- Basic document metadata -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>

    <meta name="description" content={description} />

    <meta name="robots" content={robots} />
    <meta name="googlebot" content={robots} />

    <meta name="author" content={author} />

    <meta name="application-name" content={siteName} />
    <meta name="apple-mobile-web-app-title" content={siteName} />

    <meta name="format-detection" content="telephone=no" />
    <meta name="theme-color" content="#ffffff" />

    <!-- Canonical URL -->
    <link rel="canonical" href={canonical.href} />

    <!-- Icons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Sitemap -->
    <link
      rel="sitemap"
      type="application/xml"
      href="/sitemap-index.xml"
    />

    <!-- Preload fonts -->
    <link
      rel="preload"
      href="/fonts/Outfit-Medium.woff"
      as="font"
      type="font/woff"
      crossorigin
    />

    <link
      rel="preload"
      href="/fonts/Outfit-SemiBold.woff"
      as="font"
      type="font/woff"
      crossorigin
    />

    <!-- Open Graph metadata -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="en_IN" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />

    <meta property="og:image" content={socialImage.href} />
    <meta property="og:image:alt" content={ogImageAlt} />

    {ogType === "article" && publishedTime && (
      <meta
        property="article:published_time"
        content={publishedTime}
      />
    )}

    {ogType === "article" && modifiedTime && (
      <meta
        property="article:modified_time"
        content={modifiedTime}
      />
    )}

    {ogType === "article" && author && (
      <meta property="article:author" content={author} />
    )}

    <!-- Twitter / X metadata -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@acomptic" />

    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <meta name="twitter:image" content={socialImage.href} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <!-- Structured data -->
    {
      schemaItems.map((item) => (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(item).replace(/</g, "\\u003c")}
        />
      ))
    }

    <slot name="head" />
  </head>

  <body>
    <a class="skip-link" href="#main-content">
      Skip to main content
    </a>

    <Header />

    <main id="main-content">
      <slot />
    </main>

    <Footer />
  </body>
</html>

<style is:global>
  /* Accessible keyboard skip link */
  .skip-link {
    position: absolute;
    top: 8px;
    left: 8px;
    z-index: 1000;
    padding: 10px 18px;
    border-radius: 999px;
    background: var(--color-text);
    color: var(--color-white);
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    transform: translateY(-200%);
    transition: transform 180ms ease;
  }

  .skip-link:focus-visible {
    transform: translateY(0);
  }
</style>
